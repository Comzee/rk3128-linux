diff --git a/src/gallium/drivers/lima/lima_x.h b/src/gallium/drivers/lima/lima_x.h
new file mode 100644
index 0000000..56b764b
--- /dev/null
+++ b/src/gallium/drivers/lima/lima_x.h
@@ -0,0 +1,23 @@
+/* #472 experiment switches (RK3128 reference, never for the image): LIMA_X=<bits> */
+#ifndef H_LIMA_X
+#define H_LIMA_X
+#define LIMA_X_NORENAME      (1 << 0)  /* 0006's busy-buffer rename off: partial writes flush and wait as stock */
+#define LIMA_X_SYNC          (1 << 1)  /* wait for each job's PP before returning from lima_do_job */
+#define LIMA_X_RELOAD_PLBU   (1 << 2)  /* reload draw: own PRIMITIVE_SETUP (0x2200), full scissor, depth range 0..1 */
+#define LIMA_X_NO_ZS_RELOAD  (1 << 3)  /* no depth/stencil reload draw */
+#define LIMA_X_ZS_FIRST      (1 << 4)  /* depth/stencil reload draw before the colour one */
+#define LIMA_X_EARLYZ_OFF    (1 << 5)  /* PP frame early_z off for a job with a reload */
+#define LIMA_X_RELOAD_WAIT   (1 << 6)  /* before submitting a job with a reload, wait for every earlier GP and PP job */
+#define LIMA_X_RELOAD_CLIP   (1 << 7)  /* reload RSW: near/far depth clip off (as the blob's draws) */
+#define LIMA_X_LOG           (1 << 8)  /* stderr: submits and reloads per cause, every 2 s */
+#define LIMA_X_NO_RELOAD     (1 << 9)  /* no reload draw at all (what a lost reload looks like) */
+#define LIMA_X_NO_ZS_WB      (1 << 10) /* a job reloads/writes back no depth/stencil when the next job will reload it */
+#define LIMA_X_RELOAD_NEAREST_CENTRE (1 << 11) /* reload varyings at texel centres offset by -0.5 (precision check) */
+#define LIMA_X_SPLIT_RENAME  (1 << 12) /* the rename, but the job reading the buffer is flushed first (split, fresh buffer) */
+extern int lima_x;
+enum { LIMA_XC_OTHER, LIMA_XC_EOF, LIMA_XC_FLUSH, LIMA_XC_MAP, LIMA_XC_CLEAR, LIMA_XC_DRAWS, LIMA_XC_BLIT, LIMA_XC_WB, LIMA_XC_N };
+extern int lima_x_cause;
+extern int lima_x_reloading;
+void lima_x_count_reload(int cause, int zs);
+void lima_x_count_submit(void);
+#endif
