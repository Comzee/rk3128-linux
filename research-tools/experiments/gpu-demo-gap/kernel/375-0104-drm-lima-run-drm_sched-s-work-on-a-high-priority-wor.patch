From cd274a42d9dca1ab9eaf75963899317d5057e9f7 Mon Sep 17 00:00:00 2001
From: mali-re-kernel spike <spike@local>
Date: Fri, 6 Nov 2026 20:30:12 -0600
Subject: [PATCH 4/5] drm/lima: run drm_sched's work on a high-priority
 workqueue

drm_sched allocates an ordered WQ_MEM_RECLAIM workqueue on the normal
pool for run_job and free_job: every job start that the IRQ handler does
not do itself (the first job of a burst, a PP job whose GP job just ended)
waits for a nice-0 kworker, behind the app's own threads at 600 MHz.

The vendor driver queues those starts on a WQ_HIGHPRI|WQ_UNBOUND
workqueue (_mali_osk_wq_init creates mali_wq_high with flags 0x12;
mali_executor_schedule_from_mask -> _mali_osk_wq_schedule_work_high_pri).
Give each lima pipe its own ordered high-priority workqueue.

Spike: RK3128 reference #375 (mali-re kernel area), not for upstream as is.
---
 drivers/gpu/drm/lima/lima_sched.c | 24 ++++++++++++++++++++++--
 drivers/gpu/drm/lima/lima_sched.h |  3 +++
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/lima/lima_sched.c b/drivers/gpu/drm/lima/lima_sched.c
index 160eecb..058dc30 100644
--- a/drivers/gpu/drm/lima/lima_sched.c
+++ b/drivers/gpu/drm/lima/lima_sched.c
@@ -626,7 +626,7 @@ int lima_sched_pipe_init(struct lima_sched_pipe *pipe, const char *name)
 {
 	unsigned int timeout = lima_sched_timeout_ms > 0 ?
 			       lima_sched_timeout_ms : 10000;
-	const struct drm_sched_init_args args = {
+	struct drm_sched_init_args args = {
 		.ops = &lima_sched_ops,
 		.num_rqs = DRM_SCHED_PRIORITY_COUNT,
 		/* one running, one waiting for the running one's IRQ */
@@ -637,6 +637,22 @@ int lima_sched_pipe_init(struct lima_sched_pipe *pipe, const char *name)
 		.dev = pipe->ldev->dev,
 	};
 
+	int err;
+
+	/*
+	 * drm_sched's own wq is an ordered WQ_MEM_RECLAIM one on the normal
+	 * pool: every job start waits for a nice-0 kworker. Use the
+	 * high-priority pool, as the vendor driver does for the job starts
+	 * its IRQ handler does not do (mali_executor_schedule_from_mask ->
+	 * _mali_osk_wq_schedule_work_high_pri, a WQ_HIGHPRI|WQ_UNBOUND wq).
+	 */
+	pipe->submit_wq = alloc_ordered_workqueue("lima-%s",
+						  WQ_HIGHPRI | WQ_MEM_RECLAIM,
+						  name);
+	if (!pipe->submit_wq)
+		return -ENOMEM;
+	args.submit_wq = pipe->submit_wq;
+
 	pipe->fence_context = dma_fence_context_alloc(1);
 	spin_lock_init(&pipe->fence_lock);
 
@@ -644,13 +660,17 @@ int lima_sched_pipe_init(struct lima_sched_pipe *pipe, const char *name)
 	INIT_WORK(&pipe->start_work, lima_sched_start_work);
 	spin_lock_init(&pipe->hw_lock);
 
-	return drm_sched_init(&pipe->base, &args);
+	err = drm_sched_init(&pipe->base, &args);
+	if (err)
+		destroy_workqueue(pipe->submit_wq);
+	return err;
 }
 
 void lima_sched_pipe_fini(struct lima_sched_pipe *pipe)
 {
 	drm_sched_fini(&pipe->base);
 	cancel_work_sync(&pipe->start_work);
+	destroy_workqueue(pipe->submit_wq);
 }
 
 void lima_sched_pipe_task_done(struct lima_sched_pipe *pipe)
diff --git a/drivers/gpu/drm/lima/lima_sched.h b/drivers/gpu/drm/lima/lima_sched.h
index ddbc199..3ee8cc1 100644
--- a/drivers/gpu/drm/lima/lima_sched.h
+++ b/drivers/gpu/drm/lima/lima_sched.h
@@ -70,6 +70,9 @@ struct lima_sched_pipe {
 	struct lima_vm *put_vm;		/* swapped out in IRQ context */
 	struct work_struct start_work;	/* start next_task in process context */
 
+	/* drm_sched's run_job/free_job work, on the high-priority pool */
+	struct workqueue_struct *submit_wq;
+
 	struct lima_ip *mmu[LIMA_SCHED_PIPE_MAX_MMU];
 	int num_mmu;
 
-- 
