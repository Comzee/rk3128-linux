diff --git a/src/gallium/drivers/lima/ir/pp/nir.c b/src/gallium/drivers/lima/ir/pp/nir.c
index f87187a..98348ec 100644
--- a/src/gallium/drivers/lima/ir/pp/nir.c
+++ b/src/gallium/drivers/lima/ir/pp/nir.c
@@ -295,6 +295,62 @@ static bool ppir_emit_sum2(ppir_block *block, nir_alu_instr *instr,
    return true;
 }
 
+/* dot(a.xy, b.xy) with nothing to add to it: the vec4 accumulator's sum2add
+ * with arg1 = 0.0, which is arg0.x + arg0.y + 0.0 in one instruction.
+ *
+ * What lima did instead: lower_fdot turned the fsum2 into fadd(p.x, p.y) and
+ * nir then refused nothing, so nir_opt_algebraic fused the .x half back into an
+ * fmad. That costs two instructions - the vec4 multiply of the pair, plus a
+ * scalar multiply recomputing p.x into ^fmul so the float accumulator can add
+ * it to p.y - and leaves the vec4 multiply's .x result dead. The Mali blob's
+ * reference UI rounded rect does it the sum2add way: @8's "mul.v0 $0.xy $0.zwww
+ * $0.zwww" feeds "add.s1 $0.w $0.x $0.y" in the same instruction, and the
+ * accumulator opcode mapper at 0x000e56e0 in libGLES_mali.so emits op 0x12 for
+ * exactly this horizontal sum.
+ *
+ * Bit-exact: both forms multiply the same two pairs of operands in the same
+ * precision, round each product into a pipeline register and add the two
+ * products once. arg1 = +0.0 cannot change the sum - the infinitely precise
+ * value of (a + b + 0) is the value of (a + b), so one rounding or two of it
+ * give the same result, and a + b here is a sum of two squares, never -0.
+ */
+static bool ppir_emit_sum2_zero(ppir_block *block, nir_alu_instr *instr)
+{
+   nir_def *def = &instr->def;
+   ppir_alu_node *node = ppir_node_create_dest(block, ppir_op_sum2add, def, 0x1);
+   if (!node)
+      return false;
+
+   ppir_const_node *zero = ppir_node_create(block, ppir_op_const, -1, 0);
+   if (!zero)
+      return false;
+
+   zero->constant.value[0].f = 0.0f;
+   zero->constant.num = 1;
+   zero->dest.type = ppir_target_pipeline;
+   zero->dest.pipeline = ppir_pipeline_reg_const0;
+   zero->dest.ssa.num_components = 1;
+   zero->dest.write_mask = 0x01;
+   list_addtail(&zero->node.list, &block->node_list);
+
+   nir_alu_src *sum_src = instr->src;
+   ppir_src *ps = node->src;
+   node->num_src = 2;
+
+   /* arg0 reads two components, the rest repeating the last, as the blob
+    * encodes it */
+   for (int i = 0; i < 4; i++)
+      ps[0].swizzle[i] = sum_src->swizzle[MIN2(i, 1)];
+   ppir_node_add_src(block->comp, &node->node, ps, &sum_src->src, 0b0011);
+
+   memset(ps[1].swizzle, 0, sizeof(ps[1].swizzle));
+   ppir_node_target_assign(ps + 1, &zero->node);
+   ppir_node_add_dep(&node->node, &zero->node, ppir_dep_src);
+
+   list_addtail(&node->node.list, &block->node_list);
+   return true;
+}
+
 static bool ppir_emit_alu(ppir_block *block, nir_instr *ni)
 {
    nir_alu_instr *instr = nir_instr_as_alu(ni);
@@ -316,6 +372,10 @@ static bool ppir_emit_alu(ppir_block *block, nir_instr *ni)
       int i = fadd ? ppir_fadd_fused_src(fadd) : -1;
       if (i >= 0 && fadd->src[i].src.ssa == &instr->def)
          return true;
+      /* no fadd to fuse, but sum2add with a zero addend is still one
+       * instruction when the product can be read from ^vmul */
+      if (lima_nir_fsum2_is_sum2add(instr))
+         return ppir_emit_sum2_zero(block, instr);
       return ppir_emit_sum2(block, instr, instr, NULL);
    }
 
