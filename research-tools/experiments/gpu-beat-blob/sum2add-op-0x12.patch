+      int i = fadd ? ppir_fadd_fused_src(fadd) : -1;
+      if (i >= 0 && fadd->src[i].src.ssa == &instr->def)
+         return true;
+      return ppir_emit_sum2(block, instr, instr, NULL);
+   }
+
+   if (instr->op == nir_op_fadd) {
+      int i = ppir_fadd_fused_src(instr);
+      if (i >= 0) {
+         nir_alu_instr *fsum2 = nir_instr_as_alu(nir_def_instr(instr->src[i].src.ssa));
+         return ppir_emit_sum2(block, instr, fsum2, instr->src + 1 - i);
+      }
+   }
+
