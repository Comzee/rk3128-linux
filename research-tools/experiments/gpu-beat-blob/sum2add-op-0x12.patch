+/* The vec4 accumulator's op 0x12 (sum2add) computes arg0.x + arg0.y + arg1.x,
+ * so fadd(fsum2(a), b) is one instruction, with a = fmul(...) read straight
+ * from ^vmul (the shape of dot(u.xy, v) + u.z). An fsum2 is fused into its
+ * fadd only when a is a two-component fmul used by nothing else and that fadd,
+ * in the same block, is the fsum2's only use; otherwise it is a scalar add of
+ * its two components.
+ */
+static nir_alu_instr *ppir_fsum2_fused_fadd(nir_alu_instr *fsum2)
+{
+   if (fsum2->op != nir_op_fsum2 || !list_is_singular(&fsum2->def.uses))
+      return NULL;
+
+   /* only the shape the blob uses: fsum2 of a two-component fmul (read
+    * from ^vmul), used by nothing else; every other fsum2 stays a scalar add */
+   nir_instr *src = nir_def_instr(fsum2->src[0].src.ssa);
+   if (src->type != nir_instr_type_alu)
+      return NULL;
+   nir_alu_instr *fmul = nir_instr_as_alu(src);
+   if (fmul->op != nir_op_fmul || fmul->def.num_components != 2 ||
+       !list_is_singular(&fmul->def.uses) ||
+       fsum2->src[0].swizzle[0] != 0 || fsum2->src[0].swizzle[1] != 1 ||
+       fmul->instr.block != fsum2->instr.block)
+      return NULL;
+
+   nir_src *use = list_first_entry(&fsum2->def.uses, nir_src, use_link);
+   if (nir_src_is_if(use))
+      return NULL;
+
+   nir_instr *user = nir_src_use_instr(use);
+   if (user->type != nir_instr_type_alu || user->block != fsum2->instr.block)
+      return NULL;
+
+   nir_alu_instr *fadd = nir_instr_as_alu(user);
+   if (fadd->op != nir_op_fadd || fadd->def.num_components != 1)
+      return NULL;
+
+   return fadd;
+}
+
+/* the source of a scalar fadd that is fused into it, or -1 */
+static int ppir_fadd_fused_src(nir_alu_instr *fadd)
+{
+   if (fadd->op != nir_op_fadd || fadd->def.num_components != 1)
+      return -1;
+
+   for (int i = 0; i < 2; i++) {
+      nir_instr *parent = nir_def_instr(fadd->src[i].src.ssa);
+      if (parent->type == nir_instr_type_alu &&
+          ppir_fsum2_fused_fadd(nir_instr_as_alu(parent)) == fadd)
+         return i;
+   }
+   return -1;
+}
+
+static bool ppir_emit_sum2(ppir_block *block, nir_alu_instr *instr,
+                           nir_alu_instr *fsum2, nir_alu_src *addend)
+{
+   nir_def *def = &instr->def;
+   int op = addend ? ppir_op_sum2add : ppir_op_add;
+   ppir_alu_node *node = ppir_node_create_dest(block, op, def, 0x1);
+   if (!node)
+      return false;
+
+   nir_alu_src *sum_src = fsum2->src;
+   ppir_src *ps = node->src;
+
+   if (addend) {
+      /* arg0 reads two components (the rest repeat the last, as the blob
+       * encodes it), arg1 one (repeated) */
+      node->num_src = 2;
+      for (int i = 0; i < 4; i++)
+         ps[0].swizzle[i] = sum_src->swizzle[MIN2(i, 1)];
+      ppir_node_add_src(block->comp, &node->node, ps, &sum_src->src, 0b0011);
+      for (int i = 0; i < 4; i++)
+         ps[1].swizzle[i] = addend->swizzle[0];
+      ppir_node_add_src(block->comp, &node->node, ps + 1, &addend->src, 0x1);
+   } else {
+      node->num_src = 2;
+      for (int i = 0; i < 2; i++) {
+         memset(ps[i].swizzle, sum_src->swizzle[i], sizeof(ps[i].swizzle));
+         ppir_node_add_src(block->comp, &node->node, ps + i, &sum_src->src, 0x1);
+      }
+   }
+
+   list_addtail(&node->node.list, &block->node_list);
+   return true;
+}
