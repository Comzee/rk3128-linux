# Kernel config fragment: first boot on the board (development record #287, docs/RK3128-LINUX.md
# "First boot"). Every hang comes back on its own, and the log starts with the first instruction.
# Merged after rk3128.config by scripts/linux-build.sh (#298).

# --- the SoC watchdog from the first instruction (patch 287-0002): the decompressor starts dw_wdt
# (2^31 clocks, ~29 s at 74.25 MHz) and leaves "RK3128-ZIMG-RUN!" at 0x7f120010; the watchdog core
# keeps it alive until the initramfs opens /dev/watchdog0, and resets the board if nothing opens it
# within 30 s of the driver's probe. NOWAYOUT: once opened, only the initramfs's own writes feed it. ---
CONFIG_RK312X_DECOMP_WDT=y
CONFIG_RK312X_DECOMP_MARK=0x7f120010
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=30
CONFIG_WATCHDOG_NOWAYOUT=y

# --- every other way to get stuck ends in a panic, and a panic reboots after 5 s (panic=5 on the
# cmdline, CONFIG_PANIC_TIMEOUT=5 in rk3128.config). Both BOOTPARAM_*_PANIC are ints since 7.x (6.18:
# bool): 1 = panic on the first soft lockup (one 20 s threshold, as the bool did) and on the first
# hung task. ---
CONFIG_DEBUG_KERNEL=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1

# --- the log from the first message: an early console into RAM (patch 287-0003, `earlycon=ramlog,
# 0x7f120080 keep_bootcon` on the header cmdline) until ramoops's pstore console takes over; time
# stamps on every line (the gap between them is the evidence when something stalls) ---
CONFIG_SERIAL_EARLYCON_RAMLOG=y
CONFIG_PRINTK_TIME=y

# --- /dev/mem for the initramfs's register reads (the VOP's scan-out format and address, the LVDS
# and clock registers u-boot left; no driver claims them) ---
CONFIG_DEVMEM=y

# --- low-level debug output into RAM from head.S on (patch 287-0004): early_print (an unusable
# DTB ends there), printascii and the marks setup_arch leaves around each early step, at 0x7f128000
# (32 KiB, the second half of the third record zone; the early console has 0x7f120080-0x7f127fff) ---
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_RK312X_RAMLOG=y
CONFIG_DEBUG_RK312X_RAMLOG_PHYS=0x7f128000
CONFIG_DEBUG_RK312X_RAMLOG_SIZE=0x8000

# --- /dev/i2c-0 for the initramfs's read-only scan of i2c0 (the touch controller at 0x40, #287) ---
CONFIG_I2C_CHARDEV=y
