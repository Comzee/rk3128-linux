# Kernel config fragment: the clock (development record #328, docs/LINUX-DESIGN.md 10). The kernel sets the system clock
# from the hym8563 (rtc0, in the DT; its driver and the i2c bus are =y in rk3128.config, HCTOSYS runs at late_initcall) at
# boot, and writes it back every 11 minutes while systemd-timesyncd has the clock synchronised (SYSTOHC), so "Waiting
# for the time" shows only on a first boot or with a flat RTC cell. allnoconfig leaves both off: their default y needs
# the RTC_LIB prompts answered, so they are set here. Merged after rk3128.config by scripts/linux-build.sh (#298).
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"
# /dev/rtc0 and /sys/class/rtc/rtc0 (hwclock, the hardware checks)
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_DEV=y
