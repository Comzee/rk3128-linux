# Cheap corruption checks for the Cortex-A7 product kernel (#613). ARM selects per-task canaries when the compiler
# supports them. Keep the existing stack zero initialization and strict RWX. Allocation/free page clearing remains
# default-off: its additional shared-DDR traffic has no measured acceptable cost for this appliance.
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
