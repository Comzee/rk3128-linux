# Power and screen (development record #337, LINUX-DESIGN.md 14): schedutil is the default governor (the cmdline has no bytes to
# spare, so no cpufreq.default_governor= word; board.config no longer picks ondemand as the default, ondemand stays built in).
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
