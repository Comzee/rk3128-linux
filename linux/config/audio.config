# Kernel config for the internal audio codec (development record #303, docs/RK3128-LINUX.md "Audio"):
# ALSA with ASoC, the Rockchip I2S controller, simple-audio-card, the speaker amplifier driver and
# the codec driver from linux/patches/303-0002. The I2S controller moves its samples with the
# SoC's PL330 DMA controller (`pdma`, an AMBA device).
CONFIG_ARM_AMBA=y
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y
CONFIG_SND_SOC_INNO_RK3128=y
