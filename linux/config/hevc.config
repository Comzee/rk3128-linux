# Kernel config fragment: the RK3128 HEVC decoder (0x10104000, hw id 0x6867) through mainline rkvdec,
# and the arbiter for the bus it shares with the Hantro VPU1 (development record #301,
# docs/RK3128-LINUX.md "Video decode: HEVC"). Merged after rk3128.config (and after vpu.config, which
# brings the V4L2 core, the media controller with the request API, mem2mem, the Rockchip IOMMU and CMA).
# Needs the 301-* patches (linux/patches/) and a base with the rkvdec HEVC backend (6.19 or later:
# LINUX_BASE=mainline-7.3, the default).

# --- the driver (built in: the test image has no module loader in its initramfs) ---
CONFIG_VIDEO_ROCKCHIP_VDEC=y

# --- the RK3128 HEVC/VPU shared-bus arbiter (patch 301-0002; the Rockchip IOMMU and both decoders select it) ---
CONFIG_ROCKCHIP_VCODEC_COMBO=y
