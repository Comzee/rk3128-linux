# #721: verified supported interface enabled by default, runtime-PM idle.
# RK3128_IEP=disabled opts out; unverified modes remain rejected by the driver.
CONFIG_VIDEO_ROCKCHIP_IEP=y
# Generated-fixture scatter-gather import proof uses the standard system heap.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
# Read-only DMA span diagnostics use the standard dynamic-debug interface.
CONFIG_DYNAMIC_DEBUG=y
