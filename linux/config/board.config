# Kernel config fragment: board basics (development record #302, linux/dts/rk3128-board.dtsi).
# Merged after rk3128.config (it overrides rk3128.config's "# CONFIG_CPU_FREQ is not set").

# --- CPU DVFS: cpufreq-dt on the OPP table; the patch 302-0001 lets it bind on rk3128 ---
# Governor choice: ondemand by default. Force a step with cpufreq.default_governor=performance|powersave
# on the cmdline (RK3128_CMDLINE_EXTRA) for the hardware test plan.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPUFREQ_DT=y

# --- GPU: Mali-400 MP2 through Lima (render node only; the display is simplefb for now) ---
CONFIG_DRM=y
CONFIG_DRM_LIMA=y

# --- input: touch, keys, IR ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_ADC=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SILEAD=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y
CONFIG_IR_NEC_DECODER=y
CONFIG_RC_MAP=y
CONFIG_IR_GPIO_CIR=y
CONFIG_LIRC=y

# --- IIO: SARADC (keys) and the accelerometers ---
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_STK8BA50=y
CONFIG_MC3230=y
