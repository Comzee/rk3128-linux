# Kernel config fragment: power control (development record #311, linux/dts/rk3128-pmic.dtsi,
# docs/RK3128-LINUX.md "PMIC (RT5036)"). The board has no PMIC (the stock RT5036 node is a
# disabled SDK template), so no MFD or regulator driver is built: power-off is the GPIO latch.
# The driver is built in; its DT node is status = RK3128_PMIC_CONTROL (default disabled), so the
# default image never requests the pin.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_GPIO=y
# The power-off of last resort (#390, linux/patches/390-0001): halt with the watchdog stopped, restart on the power
# key. Its node is status = RK3128_HALT_POWEROFF (default okay).
CONFIG_POWER_RESET_HALT=y
