# Kernel config fragment: what the rescue image's user space needs on top of the test kernel
# (development record #351, docs/RK3128-LINUX.md "Rescue path"). The rescue boot image reuses the main build's kernel
# (one vermagic for ssv6x5x), so these are in both images.
#
# --- the eMMC's userdata, read-only, to find the saved Wi-Fi networks: ext4 through a loop device at the partition's
# sector (the kernel reads no partition table on this board) ---
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
# --- dropbear: ssh sessions with a shell need a pty ---
CONFIG_UNIX98_PTYS=y
# --- qemu -M virt stands in for the board in the rescue's test: virtio disk (the fake eMMC) and virtio-net (Wi-Fi) ---
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO_NET=y
