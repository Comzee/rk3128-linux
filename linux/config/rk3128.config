# Kernel config fragment for the RK3128 reference Linux test image (development record #286).
# Merged by scripts/linux-build.sh over `make ARCH=arm allnoconfig` (small and fast: no multi_v7
# drivers), then `olddefconfig`. One zImage serves two machines: the board (ARCH_ROCKCHIP) and
# qemu's `-M virt` (ARCH_VIRT), which proves the initramfs logic without the board.

# --- the CPU and the platforms ---
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARCH_VIRT=y
CONFIG_SMP=y
CONFIG_HIGHMEM=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_NEON=y
# the first test boots with the CPU at u-boot's clock and voltage: no cpufreq, no devfreq
# CONFIG_CPU_FREQ is not set
CONFIG_ARM_PSCI=y
CONFIG_KERNEL_GZIP=y
CONFIG_HZ_100=y

# --- boot and the initramfs ---
# allnoconfig drops these, and a static busybox then fails sleep() (nanosleep) and more
CONFIG_EXPERT=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_MULTIUSER=y
CONFIG_FILE_LOCKING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_BUG=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PRINTK=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_MAGIC_SYSRQ=y
CONFIG_SHMEM=y
CONFIG_DEBUG_FS=y
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y

# --- interrupts, timers, clocks, resets, pins, gpio ---
CONFIG_ARM_GIC=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ROCKCHIP_TIMER=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RK312X=y
CONFIG_RESET_CONTROLLER=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_MFD_SYSCON=y
CONFIG_ROCKCHIP_PM_DOMAINS=y

# --- console on UART2 (no cable is attached; harmless) and qemu's PL011 ---
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- the log that survives the reset: pstore/ramoops ---
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_COMPRESS=y

# --- watchdog: the SoC's dw_wdt, started by the initramfs ---
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_DW_WATCHDOG=y

# --- storage: probed, never mounted ---
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_ROCKCHIP=y

# --- i2c: the RTC ---
CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_HYM8563=y

# --- display: u-boot's framebuffer through simplefb, the kernel log on it (fbcon), the backlight ---
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_PWM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_CORE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
# CONFIG_LOGO is not set
# qemu check only: a /dev/fb0 for the test pattern (`video=vfb:` on the cmdline switches it on)
CONFIG_FB_VIRTUAL=y
