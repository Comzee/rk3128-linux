# Wi-Fi: the board's iComm SSV6006C0 SDIO chip (development record #293, docs/RK3128-LINUX.md "Wi-Fi").
# No mainline driver exists: ssv6x5x.ko is an out-of-tree module (linux/modules/ssv6x5x) built by
# scripts/linux-build.sh against this kernel. cfg80211 and mac80211 are built in (y), so the only module
# to install is ssv6x5x.ko; nothing is signed (modules load from the rootfs of the same build).

# --- modules (allnoconfig has none) ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- the network stack the driver and wpa_supplicant/dhcp need ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
# /dev/rfkill: wpa_supplicant opens it at start and logs "rfkill: Cannot open RFKILL control device" without (#450); cfg80211 and mac80211
# register the wiphy's rfkill switch with it (soft and hard block states, unblocked here: nothing powers the chip, #293). No RFKILL_INPUT:
# there is no key that blocks radios.
CONFIG_RFKILL=y
# regulatory.db: these two lines have no effect. Without CFG80211_CERTIFICATION_ONUS the kernel hides their prompts and forces both
# to y (the built .config says so, #464): cfg80211 accepts only a regulatory.db signed with the built-in upstream keys, reads it once
# at boot (from the initramfs) and stays in the world domain when that fails, until `iw reg reload`. Debian's wireless-regdb
# defaults to its own Debian-signed copy, which this kernel rejects (docs/RK3128-LINUX.md "Wi-Fi on 5 GHz and the band roam"): the
# image selects the upstream-signed copy (customize.sh) and rk3128-regdom.service reloads it before the supplicant (#491).
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS is not set
# CONFIG_CFG80211_DEFAULT_PS is not set

# --- the driver loads ssv6x5x-sw.bin with request_firmware (rootfs /lib/firmware) ---
CONFIG_FW_LOADER=y
# CONFIG_FW_LOADER_USER_HELPER is not set

# --- SDIO: the chip sits on dw_mmc 10218000 (&sdio), powered through mmc-pwrseq ---
CONFIG_MMC=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_GPIOLIB=y

# --- 32-bit time_t system calls: allnoconfig drops them, and a glibc built for 32-bit time_t (wpa_supplicant's select(),
# the root filesystem's armhf userland) then gets ENOSYS ("eloop: select: Function not implemented", found in the
# qemu smoke test with mac80211_hwsim) ---
CONFIG_COMPAT_32BIT_TIME=y
