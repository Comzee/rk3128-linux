# Kernel config fragment: Hantro VPU1 (VDPU1/VEPU1 at 0x10106000) H.264/VP8/MPEG-2 stateless decode
# on the RK3128, behind the Rockchip IOMMU (development record #299, docs/RK3128-LINUX.md
# "Video decode: H.264 (VPU1)"). Merged after rk3128.config by scripts/linux-build.sh.

# --- the V4L2 core: media controller (the request API needed by stateless codecs is part of it
# since 6.x: no MEDIA_CONTROLLER_REQUEST_API symbol any more), mem2mem. The filter keeps
# allnoconfig small: without it every media category (TV tuners, cameras, SDR...) comes in ---
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y

# --- the driver: mainline verisilicon "hantro", Rockchip variants (rk3066 = the RK3128 VPU1) ---
CONFIG_VIDEO_HANTRO=y
CONFIG_VIDEO_HANTRO_ROCKCHIP=y

# --- the VPU's MMU (vpu_mmu at 0x10106800): buffers are scattered pages mapped through it ---
CONFIG_IOMMU_SUPPORT=y
CONFIG_ROCKCHIP_IOMMU=y

# --- CMA: the shared-dma-pool in linux/dts/rk3128-vpu.dtsi (64 MiB, the default pool) for the
# contiguous allocations that stay (Hantro's private tables, the other video users, #300/#305) ---
CONFIG_CMA=y
CONFIG_DMA_CMA=y

# --- the SoC GRF defaults (the VPU main clock bit and the VPU/HEVC bus mux, patch 299-0001) ---
CONFIG_ROCKCHIP_GRF=y
