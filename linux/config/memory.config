# Kernel config fragment: memory policy of the Linux userspace (development record #348, split from #330;
# docs/LINUX-DESIGN.md 7): PSI for the launcher's keep-alive budget, memory cgroups for the per-app
# cgroups, and a zram swap device with the lz4 backend (systemd-zram-generator sets it up). The base is
# allnoconfig, so BLK_DEV (zram's menu) and SWAP are off unless set here. Merged after rk3128.config by
# scripts/linux-build.sh.
CONFIG_PSI=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_DEV=y
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_CRYPTO_LZ4=y
