# Kernel config fragment: reboot modes through the PMU's SYS_REG0 (development record #351,
# linux/dts/rk3128-reboot.dtsi): `reboot recovery` writes u-boot's recovery magic the way the vendor kernel did.
# Merged after rk3128.config by scripts/linux-build.sh (#298).
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
