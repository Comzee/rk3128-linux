# #734: crypto interfaces and references are opt-in diagnostics only.
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
# Software references stay built in. The diagnostic engine core module is
# copied explicitly beside the driver, outside the auto-load directory.
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_LIB_DES=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_CRYPTO_AES_ARM_BS=y
# 7.3 renamed MANAGER_EXTRA_TESTS to SELFTESTS_FULL.
CONFIG_CRYPTO_SELFTESTS=y
CONFIG_CRYPTO_SELFTESTS_FULL=y
# Load explicitly after Home is ready; keep the userspace watchdog running during tests.
CONFIG_CRYPTO_DEV_RK3128=m
CONFIG_CRYPTO_BENCHMARK=m
# Independent, exclusive RNG-only module; load instead of the DMA prototype.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_RK3128=m
# CONFIG_HW_RANDOM_ROCKCHIP is not set
# CONFIG_HW_RANDOM_ARM_SMCCC_TRNG is not set
