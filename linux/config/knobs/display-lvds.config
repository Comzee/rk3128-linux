# Added to rk3128.config when RK3128_DISPLAY=lvds (scripts/linux-build.sh; development record #292): the
# mainline Rockchip DRM driver with the RK3128 LVDS output from linux/patches/, the RK3128 reference board panel assembly, the
# Innosilicon combo PHY in LVDS mode, and fbcon on the DRM framebuffer instead of simplefb. The default
# image (RK3128_DISPLAY=simplefb) does not have any of this.

# --- the VOP's IOMMU is a build dependency of DRM_ROCKCHIP (the rk3128 VOP node does not use it) ---
CONFIG_IOMMU_SUPPORT=y
CONFIG_ROCKCHIP_IOMMU=y

# --- DRM: VOP -> LVDS -> panel-rk3128-reference, console on the DRM fbdev ---
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_LVDS=y
CONFIG_DRM_PANEL_RK3128_REFERENCE=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y

# --- scan-out buffers are physically contiguous (no IOMMU on the VOP): a CMA pool for the 8 MB frame ---
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=32
