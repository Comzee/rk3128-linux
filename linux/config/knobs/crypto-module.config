# Explicit module acceptance with production cutoffs/references.
# #758: accepted native AES/DES/EDE/hash DMA and the #750 health-tested
# oscillator, serialized by one owner with lifetime clocks and CPU fallbacks.
CONFIG_CRYPTO_DEV_RK3128=m
CONFIG_CRYPTO_ENGINE=m
CONFIG_CRYPTO_SELFTESTS=y
# CONFIG_CRYPTO_SELFTESTS_FULL is not set
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_LIB_DES=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_CRYPTO_AES_ARM_BS=y
CONFIG_HW_RANDOM=y
# The exclusive standalone hwrng remains available with RK3128_CRYPTO=rng.
# CONFIG_HW_RANDOM_RK3128 is not set
# CONFIG_HW_RANDOM_ROCKCHIP is not set
# CONFIG_HW_RANDOM_ARM_SMCCC_TRNG is not set
