# qemu-only stand-ins (development record #296): merged by scripts/linux-build.sh only when RK3128_QEMU=1, which only
# scripts/linux-rootfs.sh --qemu sets (its kernel in build/linux-qemu). Never in a reference image.

# softdog as /dev/watchdog0 (qemu -M virt has no dw_wdt): init-root pets it with busybox watchdog -F, kills and
# reaps that before switch_root, and the self-test checks that systemd (PID 1) alone holds it afterwards
CONFIG_SOFT_WATCHDOG=y

# #522: SCSI FUA on the disposable durability-test disk. Virtio-blk has only FLUSH,
# so it cannot exercise the FUA branch of ext4's journal-commit sequence.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_VIRTIO=y
