# RK3128_USB_DEBUG=1 (#431): the gadget core, f_ncm, u_ether and dwc2 print their debugging messages (dev_dbg: the cmdline has
# ignore_loglevel, so they reach the ramoops console). For finding out why a host's driver rejects the gadget; never in an image.
CONFIG_USB_GADGET_DEBUG=y
CONFIG_USB_DWC2_DEBUG=y
