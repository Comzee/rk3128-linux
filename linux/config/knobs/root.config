# Kconfig for a Linux root filesystem on the board (development record #296, docs/RK3128-LINUX.md
# "Root filesystem"). A knob fragment (linux/config/knobs/, #298): merged by scripts/linux-build.sh only when
# RK3128_ROOT=loop, block or image, after every linux/config/*.config, so the default test image keeps its exact bytes.

# userdata (Android's ext4) and the rootfs image file on it
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
# read-only fallback: the rootfs image read-only + a tmpfs upper layer
CONFIG_OVERLAY_FS=y
# RK3128_ROOT=image (development record #352): the root is an erofs image (mkfs.erofs -zlz4hc, scripts/rk3128-image.sh) in
# the A/B image store, loop-mounted read-only by init-root. EROFS_FS_ZIP is the compressed layout (LZ4); the default
# 4 KiB block size matches the page size
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y

# what Debian's glibc, systemd 257 and its units need on an allnoconfig base. COMPAT_32BIT_TIME: armhf glibc
# 2.41 still calls the old futex syscall (240) for FUTEX_WAKE; without it every program that wakes a
# futex aborts with "The futex facility returned an unexpected error code" (systemd as PID 1 panics).
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_INOTIFY_USER=y
CONFIG_DNOTIFY=y
CONFIG_FHANDLE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_UNIX98_PTYS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KCMP=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PROC_CHILDREN=y

# qemu -M virt (scripts/linux-rootfs.sh --qemu): the stand-in eMMC is a virtio disk
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y

# blkdevparts= on the built-in cmdline: the eMMC has no partition table a mainline kernel reads
# (Rockchip's are the parameter block's mtdparts), so the build names the partitions it needs
CONFIG_PARTITION_ADVANCED=y
CONFIG_CMDLINE_PARTITION=y
