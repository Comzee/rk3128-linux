 #include "common.h"
 #include "utils/uuid.h"
@@ -4342,6 +4344,33 @@
 #endif /* CONFIG_NO_CONFIG_BLOBS */
 
 
+/* RK3128 reference #665: keep the owner policy outside the network configuration.
+ * An older image ignores this file instead of rejecting an unknown config keyword.
+ * Only a complete, regular, bounded "1\n" means ON; all missing/invalid state is OFF. */
+static int rk3128_wifi5_default(void)
+{
+	const char *path = getenv("SFL_WIFI_BAND_STATE");
+	struct stat st;
+	char value[3];
+	int fd, enabled = 0;
+	ssize_t n;
+
+	if (!path || !*path)
+		path = "/data/state/wifi/band";
+	fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+	if (fd < 0)
+		return 0;
+	if (fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_size == 2) {
+		do {
+			n = read(fd, value, sizeof(value));
+		} while (n < 0 && errno == EINTR);
+		enabled = n == 2 && value[0] == '1' && value[1] == '\n';
+	}
+	close(fd);
+	return enabled;
+}
+
+
