+	/* Preserve upstream eligibility and ordering within each priority group.
+	 * OFF tries 2.4 GHz first; only if none is usable does the original
+	 * all-band pass run. Never restrict scans: 5 GHz remains the way back
+	 * online for 5-GHz-only, out-of-range or temporarily failing BSSes. */
+	for (pass = wpa_s->conf->rk3128_wifi5 ? 1 : 0; pass < 2; pass++) {
+		for (i = 0; i < wpa_s->last_scan_res_used; i++) {
+			struct wpa_bss *bss = wpa_s->last_scan_res[i];
+
+			if (!pass && (bss->freq < 2400 || bss->freq >= 2500))
+				continue;
+
+			wpa_s->owe_transition_select = 1;
+			*selected_ssid = wpa_scan_res_match(wpa_s, i, bss, group,
+							    only_first_ssid, 1);
+			wpa_s->owe_transition_select = 0;
+			if (!*selected_ssid)
+				continue;
+			wpa_dbg(wpa_s, MSG_DEBUG, "   selected %sBSS " MACSTR
+				" ssid='%s'",
+				bss == wpa_s->current_bss ? "current ": "",
+				MAC2STR(bss->bssid),
+				wpa_ssid_txt(bss->ssid, bss->ssid_len));
+			return bss;
+		}
 	}
 
 	return NULL;
@@ -1892,6 +1902,13 @@
 			"has preferred BSSID");
 		return 1;
 	}
