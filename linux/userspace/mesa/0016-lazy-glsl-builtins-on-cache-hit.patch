       ctx->Const.Program[MESA_SHADER_FRAGMENT].MaxCombinedUniformComponents = 16 * 4;
 
       _mesa_glsl_builtin_functions_init_or_ref();
+      ctx->shader_builtin_ref = true;
 
       whole_program = standalone_create_shader_program();
       whole_program->IsES = true;
--- a/src/mesa/main/shaderapi.c
+++ b/src/mesa/main/shaderapi.c
@@ -1221,15 +1221,6 @@
    memcpy(sh->source_blake3, original_blake3, BLAKE3_OUT_LEN);
 }
 
-static void
-ensure_builtin_types(struct gl_context *ctx)
-{
-   if (!ctx->shader_builtin_ref) {
-      _mesa_glsl_builtin_functions_init_or_ref();
-      ctx->shader_builtin_ref = true;
-   }
-}
-
 /**
  * Compile a shader.
  */
@@ -1264,8 +1255,6 @@
       }
 
       MESA_TRACE_FUNC();
-
-      ensure_builtin_types(ctx);
 
       /* this call will set the shader->CompileStatus field to indicate if
        * compilation was successful.
@@ -1405,8 +1394,6 @@
             programs_in_use |= 1 << stage;
          }
       }
-
-   ensure_builtin_types(ctx);
 
    FLUSH_VERTICES(ctx, 0, 0);
    st_link_shader(ctx, shProg);
