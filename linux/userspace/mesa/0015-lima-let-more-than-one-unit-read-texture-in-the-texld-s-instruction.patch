+/* More than one unit of an instruction can read the sampler pipeline register
+ * it writes, so a texture load with several readers does not need a copy as
+ * long as all of them end up in the instruction that issues the texld.
+ *
+ * All the readers have to be ALU nodes of this block: only the ALU units take
+ * a pipeline register as a source, and a pipeline register does not survive
+ * past its instruction.  node_to_instr checks that the readers really did land
+ * in one instruction and falls back to the copy when they did not.
+ */
+static bool ppir_texture_readers_can_pipeline(ppir_node *node)
+{
+   if (node->succ_different_block)
+      return false;
+
+   unsigned readers = 0;
+   ppir_node_foreach_succ(node, dep) {
+      /* Lowering runs before the ordering and write-after-read deps are
+       * added, so every dep should be a source here; be conservative. */
+      if (dep->type != ppir_dep_src)
+         return false;
+      ppir_node *succ = dep->succ;
+      if (succ->type != ppir_node_type_alu)
+         return false;
+      readers++;
+   }
+
+   return readers > 0;
+}
