+/* The PP reads uniforms one vec4 slot per instruction (load.u), and lima gets
+ * every uniform in a vec4 slot of its own (packed_uniforms is off: Mesa's packed
+ * layout is tight and lets a vec3 or vec4 straddle two slots, which a load.u
+ * cannot read). So pack here, the way the Mali blob lays them out: the used
+ * components of each slot keep their order and go, largest first, into the first
+ * slot with room (a float beside a vec3, two vec2 in one slot); a shader that
+ * reads two uniforms in one instruction then needs one load.u, not a load.u and
+ * a mov. lima_update_pp_uniform uploads the buffer in this layout.
+ */
+static bool
+lima_nir_pack_pp_uniforms(nir_shader *s, struct lima_fs_compiled_shader *fs)
+{
+   uint8_t width[LIMA_PP_PACK_MAX_SLOTS] = {0};
+   uint8_t dst[LIMA_PP_PACK_MAX_SLOTS];
+   uint8_t fill[LIMA_PP_PACK_MAX_SLOTS] = {0};
+   unsigned num_slots = 0;
+
+   fs->state.uniform_packed = false;
+
+   nir_foreach_function_impl(impl, s) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic != nir_intrinsic_load_uniform)
+               continue;
+            /* indirect access needs the API layout */
+            if (!nir_src_is_const(intr->src[0]))
+               return false;
+            unsigned slot = nir_intrinsic_base(intr) + nir_src_as_uint(intr->src[0]);
+            if (slot >= LIMA_PP_PACK_MAX_SLOTS || intr->def.bit_size != 32)
+               return false;
+            nir_component_mask_t read = nir_def_components_read(&intr->def);
+            width[slot] = MAX2(width[slot], util_last_bit(read));
+            num_slots = MAX2(num_slots, slot + 1);
+         }
+      }
+   }
+
+   /* first fit, widest first; slots of equal width keep their order */
+   unsigned dst_slots = 0;
+   bool moved = false;
+   for (unsigned w = 4; w > 0; w--) {
+      for (unsigned i = 0; i < num_slots; i++) {
+         if (width[i] != w)
+            continue;
+         unsigned d = 0;
+         while (d < dst_slots && fill[d] + w > 4)
+            d++;
+         if (d == dst_slots)
+            dst_slots++;
+         dst[i] = d * 4 + fill[d];
+         fill[d] += w;
+         if (dst[i] != i * 4)
+            moved = true;
+      }
+   }
+
+   if (!moved)
+      return false;
+
+   nir_foreach_function_impl(impl, s) {
+      nir_builder b = nir_builder_create(impl);
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr_safe(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic != nir_intrinsic_load_uniform)
+               continue;
+            unsigned slot = nir_intrinsic_base(intr) + nir_src_as_uint(intr->src[0]);
+            unsigned n = intr->def.num_components;
+            unsigned c = dst[slot] & 3;
+
+            b.cursor = nir_before_instr(instr);
+            nir_def *load = nir_load_uniform(&b, 4, 32, nir_imm_int(&b, 0),
+                                             .base = dst[slot] >> 2, .range = 1,
+                                             .dest_type = nir_intrinsic_dest_type(intr));
+            nir_def *comps[4];
+            for (unsigned i = 0; i < n; i++)
+               comps[i] = c + i < 4 ? nir_channel(&b, load, c + i) : nir_undef(&b, 1, 32);
+            nir_def_replace(&intr->def, nir_vec(&b, comps, n));
+         }
+      }
+      nir_progress(true, impl, nir_metadata_control_flow);
+   }
+
+   fs->state.uniform_packed = true;
+   fs->state.uniform_slots = dst_slots;
+   for (unsigned i = 0; i < LIMA_PP_PACK_MAX_SLOTS; i++) {
+      fs->state.uniform_width[i] = i < num_slots ? width[i] : 0;
+      fs->state.uniform_dst[i] = i < num_slots && width[i] ? dst[i] : 0;
+   }
+   return true;
+}
+
 static void
 lima_program_optimize_fs_nir(struct nir_shader *s,
                              struct lima_fs_key *key,
@@ -338,6 +436,7 @@ lima_fs_compile_shader(struct lima_context *ctx,
          tex_options.lower_srgb |= (1 << i);
    }
 
+   lima_nir_pack_pp_uniforms(nir, fs);
    lima_program_optimize_fs_nir(nir, key, &tex_options);
 
