From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RK3128 reference <reference@example.invalid>
Date: Fri, 6 Nov 2026 08:53:52 -0600
Subject: [PATCH 4/4] ARM: dts: rockchip: rk3128: Add the LVDS transmitter

Add the LVDS output of the VOP: a third VOP endpoint, and the
rockchip,rk3128-lvds node next to the other GRF children (as on the
PX30), driving the LVDS mode of the dphy node. Disabled by default;
a board that has an LVDS panel enables the display-subsystem, vop,
dphy and lvds nodes and connects a panel to lvds_out.

Signed-off-by: RK3128 reference <reference@example.invalid>

diff --git a/arch/arm/boot/dts/rockchip/rk3128.dtsi b/arch/arm/boot/dts/rockchip/rk3128.dtsi
index c490999..d0e5d27 100644
--- a/arch/arm/boot/dts/rockchip/rk3128.dtsi
+++ b/arch/arm/boot/dts/rockchip/rk3128.dtsi
@@ -312,6 +312,11 @@
 				reg = <1>;
 				remote-endpoint = <&dsi_in_vop>;
 			};
+
+			vop_out_lvds: endpoint@2 {
+				reg = <2>;
+				remote-endpoint = <&lvds_in_vop>;
+			};
 		};
 	};
 
@@ -557,6 +562,32 @@
 		#address-cells = <1>;
 		#size-cells = <1>;
 
+		lvds: lvds {
+			compatible = "rockchip,rk3128-lvds";
+			phys = <&dphy>;
+			phy-names = "dphy";
+			rockchip,grf = <&grf>;
+			rockchip,output = "lvds";
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				lvds_in: port@0 {
+					reg = <0>;
+
+					lvds_in_vop: endpoint {
+						remote-endpoint = <&vop_out_lvds>;
+					};
+				};
+
+				lvds_out: port@1 {
+					reg = <1>;
+				};
+			};
+		};
+
 		usb2phy: usb2phy@17c {
 			compatible = "rockchip,rk3128-usb2phy";
 			reg = <0x017c 0x0c>;
