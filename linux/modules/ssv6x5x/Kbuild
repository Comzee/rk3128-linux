# ssv6x5x: iComm-semi SSV6006C (SV6256P/SSV6x5x) SDIO Wi-Fi, station mode, for the board (development record #293).
# Out-of-tree module; scripts/linux-build.sh copies this directory to build/linux/work/modules/ssv6x5x and builds it
# with `make -C <kernel> O=<obj> M=<copy> modules`. Derived from cdhigh/armbian_sv6256p 43c2ede; what changed and why: docs/RK3128-LINUX.md "Wi-Fi (#293)".
ccflags-y += -I$(src)/include -I$(src)
# Every setting is a -D flag here and nowhere else. Upstream also kept a generated include/ssv_mod_conf.h that only four
# of the files saw (USE_LOCAL_CRYPTO, CONFIG_SSV6XXX_DEBUGFS, DEBUG...), while dev.h and ssv_hci.h put struct fields under
# the same macros: those files and dev.c disagreed about the layout of struct ssv_softc. That header is gone.
ccflags-y += -DSSV_SUPPORT_HAL -DSSV_SUPPORT_SSV6006 -DCONFIG_SSV_CABRIO_E
ccflags-y += -DCONFIG_SSV_SUPPORT_ANDROID -DCONFIG_FW_ALIGNMENT_CHECK -DCONFIG_MMC_DISALLOW_STACK
# The vendor module on the board (Android, 3.10) writes output timing 0 (sdio_writeb(func, 0, 0x55) in
# ssv6xxx_sdio_read_parameter); its RK3036 flag file (ssv6x5x.cfg, OUTPUT_TIMING=3) is not what it was built with
# (#464, docs/research/wifi-vendor-driver.md).
ccflags-y += -DCONFIG_PLATFORM_SDIO_OUTPUT_TIMING=0 -DCONFIG_PLATFORM_SDIO_BLOCK_SIZE=128
ccflags-y += -DCONFIG_SSV6200_CLI_ENABLE -DCONFIG_SSV_TX_LOWTHRESHOLD -DRATE_CONTROL_REALTIME_UPDATE
ccflags-y += -DCONFIG_SSV6200_HAS_RX_WORKQUEUE -DUSE_THREAD_RX -DUSE_THREAD_TX
ccflags-y += -DENABLE_AGGREGATE_IN_TIME -DENABLE_INCREMENTAL_AGGREGATION -DUSE_GENERIC_DECI_TBL
ccflags-y += -DSSV6200_ECO -DCONFIG_SSV_CCI_IMPROVEMENT
ccflags-y += -O2 -falign-functions=8 -fno-optimize-sibling-calls

ssv6x5x-y := ssvdevice/ssvdevice.o ssvdevice/ssv_cmd.o hci/ssv_hci.o \
	smac/init.o smac/ssv_skb.o smac/dev.o smac/scan.o smac/ssv_rc_minstrel.o smac/ssv_rc_minstrel_ht.o \
	smac/ap.o smac/ampdu.o smac/efuse.o smac/ssv_pm.o smac/hal/hal.o \
	smac/hal/ssv6006c/ssv6006_common.o smac/hal/ssv6006c/ssv6006C_mac.o \
	smac/hal/ssv6006c/ssv6006_phy.o smac/hal/ssv6006c/ssv6006_turismoC.o \
	hwif/sdio/sdio.o ssv6x5x-generic-wlan.o

# include/ssv_conf_parser.h: the list of -D settings the module prints for its `cli` command (upstream's Makefile did the same)
SSV_DEFINES := $(patsubst -D%,%,$(filter -D%,$(ccflags-y)))
define SSV_CONF_PARSER_CONTENT
#ifndef __SSV_CONF_PARSER_H__
#define __SSV_CONF_PARSER_H__
char const *conf_parser[] = {
$(foreach d,$(subst =,_,$(SSV_DEFINES)),"$(d)",
)""};
#endif // __SSV_CONF_PARSER_H__
endef
$(file >$(KBUILD_EXTMOD)/include/ssv_conf_parser.h,$(SSV_CONF_PARSER_CONTENT))

obj-m += ssv6x5x.o
