+/* Advisory admission check for optional jobs that must not preempt video. */
+bool rockchip_vcodec_combo_other_active(struct rockchip_vcodec_combo_client *cl)
+{
+	struct rockchip_vcodec_combo *c;
+	unsigned long flags;
+	bool active;
+
+	if (!cl)
+		return false;
+	c = cl->combo;
+	spin_lock_irqsave(&c->lock, flags);
+	active = c->active[cl->side == COMBO_VPU ? COMBO_HEVC : COMBO_VPU] != 0;
+	spin_unlock_irqrestore(&c->lock, flags);
+	return active;
+}
+EXPORT_SYMBOL_GPL(rockchip_vcodec_combo_other_active);
