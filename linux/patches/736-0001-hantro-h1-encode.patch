From: RK3128 reference <reference@example.invalid>
Subject: [PATCH] media: hantro: add optional RK3128 H1 H.264 and VP8 encoding

Share the existing scheduler, PM combo arbiter and timeout/reset path.
Use standard stateful V4L2 controls for constant-QP all-intra encoding.
Keep large VP8 partition assembly in the dequeue process context.
No product application uses this capability.

Signed-off-by: RK3128 reference <reference@example.invalid>

diff --git a/drivers/media/platform/verisilicon/Kconfig b/drivers/media/platform/verisilicon/Kconfig
--- a/drivers/media/platform/verisilicon/Kconfig
+++ b/drivers/media/platform/verisilicon/Kconfig
@@ -21,6 +21,26 @@
 	  To compile this driver as a module, choose M here: the module
 	  will be called hantro-vpu.
 
+config VIDEO_HANTRO_H1_H264_ENC
+	bool "Hantro H1 H.264 encoder on RK3128"
+	depends on VIDEO_HANTRO_ROCKCHIP
+	default n
+	help
+	  Stateful constrained-baseline, constant-QP, all-intra H.264 encoder.
+	  Shares the existing Hantro scheduler and Rockchip combo arbiter.
+	  No application uses this optional capability.
+	  Supports 96x96..1920x1088 macroblock-aligned input storage.
+
+config VIDEO_HANTRO_H1_VP8_ENC
+	bool "Hantro H1 VP8 encoder on RK3128"
+	depends on VIDEO_HANTRO_ROCKCHIP
+	default n
+	help
+	  Stateful all-keyframe VP8 profile 0 with constant quantizer.
+	  Supports 144x96..1920x1088 storage, visible width at least 132.
+	  Assembles partitions in the dequeue process context.
+	  Shares the existing Hantro scheduler and Rockchip combo arbiter.
+
 config VIDEO_HANTRO_HEVC_RFC
 	bool "Use reference frame compression for HEVC"
 	depends on VIDEO_HANTRO
