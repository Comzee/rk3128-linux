--- /dev/null
+++ b/drivers/media/platform/verisilicon/hantro_h1_h264_stream.h
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Bounded Annex-B SPS/PPS for the H1 fixed, 16-bit frame_num slice writer. */
+#ifndef HANTRO_H1_H264_STREAM_H
+#define HANTRO_H1_H264_STREAM_H
+
+#define H1_H264_HEADER_SIZE 128
+
+struct h1_h264_bits {
+	unsigned char data[64];
+	unsigned int bits;
+	int overflow;
+};
+
+static void h1_h264_put(struct h1_h264_bits *b, unsigned int v,
+			unsigned int n)
+{
+	while (n--) {
+		unsigned int pos = b->bits++;
+
+		if (pos >= sizeof(b->data) * 8) {
+			b->overflow = 1;
+			return;
+		}
+		b->data[pos / 8] |= ((v >> n) & 1) << (7 - pos % 8);
+	}
+}
+
+static void h1_h264_ue(struct h1_h264_bits *b, unsigned int v)
+{
+	unsigned int n = 0, code = v + 1, tmp = code;
+
+	while (tmp >>= 1)
+		n++;
+	h1_h264_put(b, 0, n);
+	h1_h264_put(b, code, n + 1);
+}
+
+static unsigned int h1_h264_nal(unsigned char *out, unsigned int offset,
+			       unsigned char type, struct h1_h264_bits *b)
+{
+	unsigned int i, zeros = 0;
+
+	h1_h264_put(b, 1, 1);
+	while (b->bits % 8)
+		h1_h264_put(b, 0, 1);
+	if (b->overflow || offset + 5 >= H1_H264_HEADER_SIZE)
+		return 0;
+	out[offset++] = 0;
+	out[offset++] = 0;
+	out[offset++] = 0;
+	out[offset++] = 1;
+	out[offset++] = type;
+	for (i = 0; i < b->bits / 8; i++) {
+		if (offset + 2 >= H1_H264_HEADER_SIZE)
+			return 0;
+		if (zeros == 2 && b->data[i] <= 3) {
+			out[offset++] = 3;
+			zeros = 0;
+		}
+		out[offset++] = b->data[i];
+		zeros = b->data[i] ? 0 : zeros + 1;
+	}
+	return offset;
+}
+
+/* The caller supplies a H1_H264_HEADER_SIZE-byte destination. */
+static int h1_h264_headers(unsigned char *out, unsigned int width,
+			   unsigned int height, unsigned int visible_width,
+			   unsigned int visible_height)
+{
+	struct h1_h264_bits sps = { { 0 }, 0, 0 };
+	struct h1_h264_bits pps = { { 0 }, 0, 0 };
+	unsigned int offset;
+	int crop;
+
+	if (width < 96 || width > 1920 || height < 96 || height > 1088 ||
+	    width % 16 || height % 16 || visible_width < 96 || visible_height < 96 ||
+	    visible_width > width || visible_height > height ||
+	    visible_width % 2 || visible_height % 2 ||
+	    width - visible_width > 14 || height - visible_height > 14)
+		return -1;
+	crop = width != visible_width || height != visible_height;
+	h1_h264_put(&sps, 66, 8); /* baseline profile */
+	h1_h264_put(&sps, 0xc0, 8); /* constraint_set0/1 */
+	h1_h264_put(&sps, 40, 8); /* level 4.0 */
+	h1_h264_ue(&sps, 0); /* sps_id */
+	h1_h264_ue(&sps, 12); /* 16-bit frame_num, fixed in H1 */
+	h1_h264_ue(&sps, 2); /* POC derived from frame_num */
+	h1_h264_ue(&sps, 1); /* max_num_ref_frames */
+	h1_h264_put(&sps, 0, 1); /* no gaps */
+	h1_h264_ue(&sps, width / 16 - 1);
+	h1_h264_ue(&sps, height / 16 - 1);
+	h1_h264_put(&sps, 1, 1); /* frame_mbs_only */
+	h1_h264_put(&sps, 1, 1); /* direct_8x8_inference */
+	h1_h264_put(&sps, crop, 1);
+	if (crop) {
+		h1_h264_ue(&sps, 0);
+		h1_h264_ue(&sps, (width - visible_width) / 2);
+		h1_h264_ue(&sps, 0);
+		h1_h264_ue(&sps, (height - visible_height) / 2);
+	}
+	h1_h264_put(&sps, 0, 1); /* VUI absent: no invented timing */
+	offset = h1_h264_nal(out, 0, 0x67, &sps);
+	if (!offset)
+		return -1;
+	h1_h264_ue(&pps, 0); /* pps_id */
+	h1_h264_ue(&pps, 0); /* sps_id */
+	h1_h264_put(&pps, 0, 1); /* CAVLC */
+	h1_h264_put(&pps, 0, 1); /* bottom_field_pic_order_in_frame_present */
+	h1_h264_ue(&pps, 0); /* no slice groups */
+	h1_h264_ue(&pps, 0); /* one L0 reference */
+	h1_h264_ue(&pps, 0); /* one L1 reference */
+	h1_h264_put(&pps, 0, 3); /* no weighted prediction */
+	h1_h264_ue(&pps, 0); /* pic_init_qp_minus26 = 0 (signed zero) */
+	h1_h264_ue(&pps, 0); /* pic_init_qs_minus26 */
+	h1_h264_ue(&pps, 0); /* chroma_qp_index_offset */
+	h1_h264_put(&pps, 1, 1); /* deblocking_filter_control_present */
+	h1_h264_put(&pps, 0, 1); /* unconstrained intra prediction */
+	h1_h264_put(&pps, 0, 1); /* redundant_pic_cnt_present */
+	offset = h1_h264_nal(out, offset, 0x68, &pps);
+	if (!offset || offset + 6 > H1_H264_HEADER_SIZE)
+		return -1;
+	/* A legal filler NAL aligns the hardware stream start to 64 bits. */
+	out[offset++] = 0;
+	out[offset++] = 0;
+	out[offset++] = 0;
+	out[offset++] = 1;
+	out[offset++] = 0x0c;
+	while (offset < H1_H264_HEADER_SIZE - 1)
+		out[offset++] = 0xff;
+	out[offset] = 0x80;
+	return 0;
+}
+#endif
diff --git a/drivers/media/platform/verisilicon/hantro_h1_vp8_enc.c b/drivers/media/platform/verisilicon/hantro_h1_vp8_enc.c
new file mode 100644
--- /dev/null
+++ b/drivers/media/platform/verisilicon/hantro_h1_vp8_enc.c
@@ -0,0 +1,317 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * RK3128 Hantro H1 VP8 profile-0 encoder, constant QP, keyframes only.
+ * Register meanings checked against the stock HAL and Rockchip MPP VEPU1.
+ * Published VP8 probability/quantizer tables carry their BSD-3-Clause notice
+ * in hantro_h1_vp8_tables.h. No userspace register programming interface.
+ */
+#include <linux/dma-mapping.h>
+#include <linux/unaligned.h>
+#include "hantro.h"
+#include "hantro_h1_regs.h"
+#include "hantro_h1_vp8_tables.h"
+
+#define VP8_AUX_SIZE 8192
+#define VP8_PROB_OFFSET 1024
+#define VP8_CABAC_OFFSET 2048
+#define VP8_SEG_OFFSET 4096
+#define VP8_PROB_TABLE_SIZE 1208
+
+struct vp8_bool_writer {
+	u8 data[512];
+	u32 low;
+	unsigned int range;
+	unsigned int left;
+	unsigned int bytes;
+	bool error;
+};
+
+/* VP8 arithmetic coding, retaining the unfinished state for the hardware. */
+static void vp8_bool(struct vp8_bool_writer *b, bool bit, unsigned int prob)
+{
+	unsigned int split = 1 + ((b->range - 1) * prob >> 8);
+
+	if (bit) {
+		b->low += split;
+		b->range -= split;
+	} else {
+		b->range = split;
+	}
+	while (b->range < 128) {
+		if (b->low & BIT(31)) {
+			int at = (int)b->bytes - 1;
+
+			while (at >= 0 && b->data[at] == 255)
+				b->data[at--] = 0;
+			if (at < 0) {
+				b->error = true;
+				return;
+			}
+			b->data[at]++;
+		}
+		b->range <<= 1;
+		b->low <<= 1;
+		if (!--b->left) {
+			if (b->bytes >= sizeof(b->data)) {
+				b->error = true;
+				return;
+			}
+			b->data[b->bytes++] = b->low >> 24;
+			b->low &= 0xffffff;
+			b->left = 8;
+		}
+	}
+}
+
+static void vp8_literal(struct vp8_bool_writer *b, unsigned int val,
+			unsigned int bits)
+{
+	while (bits--)
+		vp8_bool(b, (val >> bits) & 1, 128);
+}
+
+static void vp8_header(struct vp8_bool_writer *b, unsigned int qp)
+{
+	const u8 *update = &vp8_coef_update_probs[0][0][0][0];
+	unsigned int i;
+
+	b->range = 255;
+	b->left = 24;
+	/* Color/clamping, no segmentation; normal filter, level/sharpness 0. */
+	vp8_literal(b, 0, 14);
+	/* One DCT partition, quantizer, five absent quantizer deltas. */
+	vp8_literal(b, 0, 2);
+	vp8_literal(b, qp, 7);
+	vp8_literal(b, 0, 5);
+	vp8_literal(b, 0, 1); /* no entropy refresh across keyframes */
+	for (i = 0; i < sizeof(vp8_coef_update_probs); i++)
+		vp8_bool(b, false, update[i]);
+	vp8_literal(b, 1, 1); /* enable coefficient skipping */
+	vp8_literal(b, 128, 8); /* skip_false probability, also in ASIC table */
+}
+
+static void vp8_probabilities(void *memory)
+{
+	u8 *table = memory, *at;
+	unsigned int t, band, ctx, node, i;
+	const u8 modes[] = { 112, 86, 140, 37, 162, 101, 204 };
+
+	memset(table, 0, VP8_PROB_TABLE_SIZE);
+	table[0] = 128; /* skip_false, matches compressed header */
+	table[1] = 255; /* intra: keyframe ignores inter references */
+	table[2] = 255;
+	table[3] = 128;
+	table[4] = table[5] = table[6] = 255;
+	memcpy(table + 8, modes, sizeof(modes));
+	/* Coefficients 0,1,2 then padding; coefficients 4..10 then 3. */
+	at = table + 56;
+	for (t = 0; t < 4; t++)
+		for (band = 0; band < 8; band++)
+			for (ctx = 0; ctx < 3; ctx++) {
+				for (node = 0; node < 3; node++)
+					*at++ = default_coef_probs[t][band][ctx][node];
+				at++;
+			}
+	for (t = 0; t < 4; t++)
+		for (band = 0; band < 8; band++)
+			for (ctx = 0; ctx < 3; ctx++) {
+				for (node = 4; node < 11; node++)
+					*at++ = default_coef_probs[t][band][ctx][node];
+				*at++ = default_coef_probs[t][band][ctx][3];
+			}
+	/* H1 consumes the table in reversed 64-bit groups. */
+	for (i = 0; i < VP8_PROB_TABLE_SIZE; i += 8) {
+		unsigned int j;
+
+		for (j = 0; j < 4; j++)
+			swap(table[i + j], table[i + 7 - j]);
+	}
+}
+
+int hantro_h1_vp8_enc_init(struct hantro_ctx *ctx)
+{
+	struct hantro_h1_vp8_enc_ctx *h = &ctx->vp8_enc;
+	struct device *dev = ctx->dev->dev;
+
+	memset(h, 0, sizeof(*h));
+	h->recon_size = ctx->src_fmt.width * ctx->src_fmt.height * 3;
+	h->recon = dma_alloc_coherent(dev, h->recon_size, &h->recon_dma, GFP_KERNEL);
+	if (!h->recon)
+		return -ENOMEM;
+	h->aux = dma_alloc_coherent(dev, VP8_AUX_SIZE, &h->aux_dma, GFP_KERNEL);
+	if (!h->aux) {
+		dma_free_coherent(dev, h->recon_size, h->recon, h->recon_dma);
+		h->recon = NULL;
+		return -ENOMEM;
+	}
+	memset(h->aux, 0, VP8_AUX_SIZE);
+	vp8_probabilities(h->aux + VP8_CABAC_OFFSET);
+	return 0;
+}
+
+void hantro_h1_vp8_enc_exit(struct hantro_ctx *ctx)
+{
+	struct hantro_h1_vp8_enc_ctx *h = &ctx->vp8_enc;
+	struct device *dev = ctx->dev->dev;
+
+	if (h->aux)
+		dma_free_coherent(dev, VP8_AUX_SIZE, h->aux, h->aux_dma);
+	if (h->recon)
+		dma_free_coherent(dev, h->recon_size, h->recon, h->recon_dma);
+	memset(h, 0, sizeof(*h));
+}
+
+static void vp8_quantizers(struct hantro_dev *vpu, unsigned int qp)
+{
+	unsigned int dc = dc_qlookup[qp], ac = ac_qlookup[qp];
+	unsigned int dequant[] = { dc, ac, dc * 2, max(8U, ac * 155 / 100),
+				 min(dc, 132U), ac };
+	unsigned int i, zfactor = qp < 4 ? 64 : 80, rfactor = qp < 8 ? 56 : 48;
+
+	for (i = 0; i < ARRAY_SIZE(dequant); i++) {
+		unsigned int q = min(16383U, 65536 / dequant[i]);
+		unsigned int z = (zfactor * dequant[i] + 64) / 128;
+		unsigned int r = rfactor * dequant[i] / 128;
+
+		vepu_write_relaxed(vpu, q | (z << 14) | (r << 23),
+				   H1_REG_VP8_QP_VAL(i));
+	}
+	vepu_write_relaxed(vpu, dequant[0] | (dequant[1] << 8) | (dequant[2] << 17), 0x84);
+	vepu_write_relaxed(vpu, dequant[3] | (dequant[4] << 9) | (dequant[5] << 17), 0x88);
+}
+
+int hantro_h1_vp8_enc_run(struct hantro_ctx *ctx)
+{
+	struct hantro_dev *vpu = ctx->dev;
+	struct hantro_h1_vp8_enc_ctx *h = &ctx->vp8_enc;
+	struct vb2_v4l2_buffer *src = hantro_get_src_buf(ctx);
+	struct vb2_v4l2_buffer *dst = hantro_get_dst_buf(ctx);
+	struct vp8_bool_writer b = { };
+	unsigned int width = ctx->src_fmt.width, height = ctx->src_fmt.height;
+	unsigned int size = vb2_plane_size(&dst->vb2_buf, 0), i, qp;
+	unsigned int reserve = ALIGN(MB_WIDTH(width) * MB_HEIGHT(height) * 256 + 4096, 64);
+	u8 *out = vb2_plane_vaddr(&dst->vb2_buf, 0);
+	dma_addr_t dma = vb2_dma_contig_plane_dma_addr(&dst->vb2_buf, 0);
+	u32 first, ctrl;
+	static const u16 intra4_cost[] = {
+		280, 622, 832, 1177, 1240, 1341, 1085, 1259, 1357, 1495
+	};
+	static const u16 intra16_cost[] = { 305, 841, 914, 1082 };
+
+	vb2_set_plane_payload(&dst->vb2_buf, 0, 0);
+	if (!out || size < reserve + 64 || !h->aux || !h->recon ||
+	    width < 144 || height < 96 || ctx->dst_fmt.width < 132 ||
+	    ctx->dst_fmt.height < 96 || (ctx->dst_fmt.height & 1) ||
+	    atomic_read(&vpu->video_dec_streaming))
+		return -EINVAL;
+	hantro_start_prepare_run(ctx);
+	qp = ctx->vp8_qp;
+	vp8_header(&b, qp);
+	if (b.error || b.bytes + 18 > reserve) {
+		v4l2_ctrl_request_complete(src->vb2_buf.req_obj.req, &ctx->ctrl_handler);
+		return -EINVAL;
+	}
+	h->header_bytes = 10 + b.bytes;
+	h->dct_offset = reserve;
+	first = h->header_bytes & ~7U;
+	memset(out, 0, ALIGN(h->header_bytes, 8));
+	/* Frame tag is patched at dequeue, after the hardware partition sizes. */
+	out[3] = 0x9d; out[4] = 0x01; out[5] = 0x2a;
+	put_unaligned_le16(ctx->dst_fmt.width, out + 6);
+	put_unaligned_le16(ctx->dst_fmt.height, out + 8);
+	memcpy(out + 10, b.data, b.bytes);
+	memset(h->aux, 0, VP8_CABAC_OFFSET);
+
+	dev_info_once(vpu->dev, "H1 VP8 encode id=%#x synthesis=%#x\n",
+		vepu_read(vpu, 0), vepu_read(vpu, 0xfc));
+	vepu_write(vpu, H1_REG_ENC_CTRL_ENC_MODE_VP8, H1_REG_ENC_CTRL);
+	for (i = 4; i <= 0x28c; i += 4)
+		if (i != H1_REG_ENC_CTRL)
+			vepu_write_relaxed(vpu, 0, i);
+	vepu_write_relaxed(vpu, dma + first, H1_REG_ADDR_OUTPUT_STREAM);
+	vepu_write_relaxed(vpu, dma + reserve, H1_REG_ADDR_VP8_DCT_PART(0));
+	vepu_write_relaxed(vpu, ((size - reserve) / 8) & ~7U, H1_REG_STR_BUF_LIMIT);
+	vepu_write_relaxed(vpu, get_unaligned_be32(out + first), H1_REG_STR_HDR_REM_MSB);
+	vepu_write_relaxed(vpu, get_unaligned_be32(out + first + 4), H1_REG_STR_HDR_REM_LSB);
+	vepu_write_relaxed(vpu, (h->header_bytes & 7) * 8 << 23, H1_REG_RLC_CTRL);
+	vepu_write_relaxed(vpu, h->aux_dma, H1_REG_ADDR_OUTPUT_CTRL);
+	vepu_write_relaxed(vpu, h->aux_dma + VP8_PROB_OFFSET, H1_REG_ADDR_VP8_PROB_CNT);
+	vepu_write_relaxed(vpu, h->aux_dma + VP8_CABAC_OFFSET, H1_REG_ADDR_CABAC_TBL);
+	vepu_write_relaxed(vpu, h->aux_dma + VP8_SEG_OFFSET, H1_REG_ADDR_VP8_SEG_MAP);
+	vepu_write_relaxed(vpu, h->recon_dma, H1_REG_ADDR_REF_LUMA);
+	vepu_write_relaxed(vpu, h->recon_dma + width * height, H1_REG_ADDR_REF_CHROMA);
+	vepu_write_relaxed(vpu, h->recon_dma + width * height * 3 / 2, H1_REG_ADDR_REC_LUMA);
+	vepu_write_relaxed(vpu, h->recon_dma + width * height * 5 / 2, H1_REG_ADDR_REC_CHROMA);
+	for (i = 0; i < ctx->src_fmt.num_planes; i++)
+		vepu_write_relaxed(vpu, vb2_dma_contig_plane_dma_addr(&src->vb2_buf, i),
+				   H1_REG_ADDR_IN_PLANE_0 + i * 4);
+	vepu_write_relaxed(vpu, H1_REG_IN_IMG_CTRL_ROW_LEN(width) |
+			   H1_REG_IN_IMG_CTRL_FMT(ctx->vpu_src_fmt->enc_fmt) |
+			   H1_REG_IN_IMG_CTRL_OVRFLR_D4((width - ctx->dst_fmt.width) / 4) |
+			   H1_REG_IN_IMG_CTRL_OVRFLB(height - ctx->dst_fmt.height),
+			   H1_REG_IN_IMG_CTRL);
+	vepu_write_relaxed(vpu, BIT(18) | qp * 8, H1_REG_ENC_CTRL2);
+	vp8_quantizers(vpu, qp);
+	vepu_write_relaxed(vpu, b.low, H1_REG_VP8_BOOL_ENC);
+	vepu_write_relaxed(vpu, b.range | ((24 - b.left) << 8), H1_REG_VP8_CTRL0);
+	for (i = 0; i < 2; i++)
+		vepu_write_relaxed(vpu, (intra16_cost[i * 2] * (qp * 2 + 64) / 256) |
+			((intra16_cost[i * 2 + 1] * (qp * 2 + 64) / 256) << 16), 0x100 + i * 4);
+	for (i = 0; i < 5; i++)
+		vepu_write_relaxed(vpu, (intra4_cost[i * 2] * (qp * 2 + 8) / 256) |
+			((intra4_cost[i * 2 + 1] * (qp * 2 + 8) / 256) << 16), 0x108 + i * 4);
+	vepu_write_relaxed(vpu, 0xffffffff, H1_REG_INTRA_AREA_CTRL);
+	vepu_write_relaxed(vpu, 0xffffffff, H1_REG_FIRST_ROI_AREA);
+	vepu_write_relaxed(vpu, 0xffffffff, H1_REG_SECOND_ROI_AREA);
+	vepu_write(vpu, 0xd00f, H1_REG_AXI_CTRL);
+	dst->flags &= ~(V4L2_BUF_FLAG_PFRAME | V4L2_BUF_FLAG_BFRAME);
+	dst->flags |= V4L2_BUF_FLAG_KEYFRAME;
+	hantro_end_prepare_run(ctx);
+	ctrl = H1_REG_ENC_CTRL_TIMEOUT_EN | H1_REG_ENC_CTRL_NAL_MODE_BIT |
+	       H1_REG_ENC_CTRL_WIDTH(MB_WIDTH(width)) | H1_REG_ENC_CTRL_HEIGHT(MB_HEIGHT(height)) |
+	       H1_REG_ENC_PIC_INTRA | H1_REG_ENC_CTRL_ENC_MODE_VP8 | H1_REG_ENC_CTRL_EN_BIT;
+	vepu_write(vpu, ctrl, H1_REG_ENC_CTRL);
+	return 0;
+}
+
+bool hantro_h1_vp8_enc_valid(struct hantro_ctx *ctx)
+{
+	struct hantro_h1_vp8_enc_ctx *h = &ctx->vp8_enc;
+	struct vb2_v4l2_buffer *dst = hantro_get_dst_buf(ctx);
+	u32 *sizes = h->aux, head, dct;
+	u32 size = vb2_plane_size(&dst->vb2_buf, 0);
+
+	dma_rmb();
+	head = READ_ONCE(sizes[0]);
+	dct = READ_ONCE(sizes[1]);
+	return head >= (h->header_bytes & 7) &&
+	       head <= h->dct_offset - (h->header_bytes & ~7U) &&
+	       head + (h->header_bytes & ~7U) - 10 <= 0x7ffff &&
+	       dct && dct <= size - h->dct_offset;
+}
+
+void hantro_h1_vp8_enc_done(struct hantro_ctx *ctx)
+{
+	struct hantro_h1_vp8_enc_ctx *h = &ctx->vp8_enc;
+	struct vb2_v4l2_buffer *dst = hantro_get_dst_buf(ctx);
+	struct hantro_decoded_buffer *buf = vb2_to_hantro_decoded_buf(&dst->vb2_buf);
+	u32 *sizes = h->aux;
+
+	buf->vp8_enc.header_bytes = (h->header_bytes & ~7U) + sizes[0];
+	buf->vp8_enc.dct_offset = h->dct_offset;
+	buf->vp8_enc.dct_bytes = sizes[1];
+	vb2_set_plane_payload(&dst->vb2_buf, 0, buf->vp8_enc.header_bytes + sizes[1]);
+}
+
+/* Called by DQBUF in process context after vb2 has synchronized CPU access. */
+void hantro_h1_vp8_enc_finish(struct vb2_buffer *vb)
+{
+	struct hantro_decoded_buffer *buf = vb2_to_hantro_decoded_buf(vb);
+	u8 *out = vb2_plane_vaddr(vb, 0);
+	u32 head = buf->vp8_enc.header_bytes;
+	u32 dct = buf->vp8_enc.dct_bytes;
+
+	memmove(out + head, out + buf->vp8_enc.dct_offset, dct);
+	/* Profile 0, visible keyframe; first-partition count excludes the 10-byte tag. */
+	put_unaligned_le24(((head - 10) << 5) | 0x10, out);
+}
