+/* Exclusive staged probe; no algorithms or hwrng are registered here. */
+static int rk_power_probe(struct rk3128_dev *d)
+{
+	struct regmap *pmu;
+	u32 ctrl, status = 0;
+	int err, release;
+	u64 resumed;
+
+	pmu = syscon_regmap_lookup_by_compatible("rockchip,rk3128-pmu");
+	if (IS_ERR(pmu))
+		return PTR_ERR(pmu);
+	mutex_lock(&d->lock);
+	rk_write(d, RK_CRYPTO_INTENA, 0);
 	rk_irq_off(d);
-	err = reset_control_assert(d->reset);
+	synchronize_irq(d->irq);
+	err = readl_poll_timeout(d->reg + RK_CRYPTO_CTRL, ctrl,
+				 !(ctrl & (GENMASK(4, 0) | RK_RNG_START)), 10, 10000);
+	if (err)
+		goto out;
+	dev_info(d->dev, "power probe: START clear, IRQ drained; request crypto idle\n");
+	err = regmap_update_bits(pmu, 0xc, BIT(7), BIT(7));
+	if (!err)
+		err = regmap_read_poll_timeout(pmu, 0x10, status,
+					       (status & (BIT(7) | BIT(23))) == (BIT(7) | BIT(23)),
+					       1, 10000);
+	dev_info(d->dev, "power probe: idle result=%d status=%08x; release\n",
+		 err, status);
+	if (!err && power_probe >= 2) {
+		dev_info(d->dev, "power probe: idle acknowledged, assert reset\n");
+		err = reset_control_assert(d->reset);
+		if (err)
+			goto retain;
+		clk_bulk_disable_unprepare(ARRAY_SIZE(d->clks), d->clks);
+		dev_info(d->dev, "power probe: clocks gated; resume\n");
+		resumed = ktime_get_ns();
+		err = clk_bulk_prepare_enable(ARRAY_SIZE(d->clks), d->clks);
+		if (err)
+			goto retain;
+		err = reset_control_deassert(d->reset);
+		if (err)
+			goto retain;
+		dev_info(d->dev, "power probe: clocks on, reset released; activate port\n");
+	} else {
+		resumed = ktime_get_ns();
+	}
+	/* Always try to release a timed-out idle request with clocks still on. */
+	release = regmap_update_bits(pmu, 0xc, BIT(7), 0);
+	if (!release)
+		release = regmap_read_poll_timeout(pmu, 0x10, status,
+						   !(status & (BIT(7) | BIT(23))), 1, 10000);
+	if (!err)
+		err = release;
+	dev_info(d->dev, "power probe: release result=%d status=%08x resume_ns=%llu\n",
+		 release, status, ktime_get_ns() - resumed);
+	if (!err && power_probe >= 2) {
+		/* Port active again: restore the interrupt baseline after reset. */
+		rk_write(d, RK_CRYPTO_INTENA, 0);
+		rk_write(d, RK_CRYPTO_INTSTS, 0x3f);
+	}
+retain:
+out:
+	/* No later register access or unbind after an uncertain PMU transition. */
 	if (err) {
 		d->broken = true;
-		dev_err(dev, "reset assertion failed: %d\n", err);
-		return err;
-	}
-	clk_bulk_disable_unprepare(ARRAY_SIZE(d->clks), d->clks);
-	return 0;
+		__module_get(THIS_MODULE);
+		d->dma_started = true;
+	} else {
+		rk_irq_on(d);
+		dev_info(d->dev, "power probe: %s PASS\n",
+			 power_probe == 1 ? "clock-held handshake" : "reset/gate cycle");
+	}
+	mutex_unlock(&d->lock);
+	return err;
 }
 
