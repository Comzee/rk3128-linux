+/* Runtime PM usage references exclude every hardware requester. Callbacks
+ * must not acquire d->lock: resume-and-get callers already hold that mutex.
+ */
+static int rk_port_idle(struct rk3128_dev *d, bool idle)
+{
+	u32 status, target = idle ? BIT(7) | BIT(23) : 0;
+	int err;
+
+	err = regmap_update_bits(d->pmu, 0xc, BIT(7), idle ? BIT(7) : 0);
+	if (!err)
+		err = regmap_read_poll_timeout(d->pmu, 0x10, status,
+					       (status & (BIT(7) | BIT(23))) == target,
+					       1, 10000);
+	return err;
+}
+
 static int rk_resume(struct device *dev)
 {
 	struct rk3128_dev *d = dev_get_drvdata(dev);
+	u64 start = pm_trace ? ktime_get_ns() : 0, elapsed;
 	int err;
 
 	if (d->broken)
 		return -EIO;
 	err = clk_bulk_prepare_enable(ARRAY_SIZE(d->clks), d->clks);
 	if (err)
-		return err;
+		return runtime_pm ? rk_abort(d, err) : err;
 	err = reset_control_deassert(d->reset);
 	if (err) {
+		if (runtime_pm)
+			return rk_abort(d, err);
 		clk_bulk_disable_unprepare(ARRAY_SIZE(d->clks), d->clks);
 		return err;
 	}
-	/* A pending IRQ must never read the clock-gated APB register window. */
+	if (runtime_pm) {
+		err = rk_port_idle(d, false);
+		if (err)
+			return rk_abort(d, err);
+	}
+	/* No crypto MMIO until clocks, reset and the NoC port are active. Each
+	 * hash/PIO request reloads its registers. RNG reprograms OSC, withholds
+	 * startup bits and clears the block on each read, as in lifetime mode.
+	 */
 	rk_write(d, RK_CRYPTO_INTENA, 0);
 	rk_write(d, RK_CRYPTO_INTSTS, 0x3f);
 	rk_irq_on(d);
+	if (pm_trace) {
+		elapsed = ktime_get_ns() - start;
+		d->resume_min = d->resumes ? min(d->resume_min, elapsed) : elapsed;
+		d->resumes++;
+		d->resume_total += elapsed;
+		d->resume_max = max(d->resume_max, elapsed);
+		if (d->resumes <= 8 || is_power_of_2(d->resumes))
+			dev_info(dev, "PM resume count=%llu total_ns=%llu min_ns=%llu max_ns=%llu\n",
+				 d->resumes, d->resume_total, d->resume_min, d->resume_max);
+	}
 	return 0;
 }
 
 static int rk_suspend(struct device *dev)
 {
 	struct rk3128_dev *d = dev_get_drvdata(dev);
+	u32 value;
 	int err;
 
-	/* Once DMA/RNG starts, even a failed probe stays powered to reboot. */
-	if (READ_ONCE(d->dma_started) || READ_ONCE(d->rng_started))
+	if ((runtime_pm && d->broken) ||
+	    (!runtime_pm && (READ_ONCE(d->dma_started) || READ_ONCE(d->rng_started))))
 		return -EBUSY;
+	if (runtime_pm) {
+		rk_write(d, RK_CRYPTO_INTENA, 0);
+		rk_irq_off(d);
+		synchronize_irq(d->irq);
+		err = readl_poll_timeout(d->reg + RK_CRYPTO_CTRL, value,
+					 !(value & (GENMASK(4, 0) | RK_RNG_START)), 10, 10000);
+		if (err)
+			return rk_abort(d, err);
+		/* RNG callbacks must have acknowledged OSC stop and BLOCK_FLUSH
+		 * before dropping their PM reference. Do not hide a live source.
+		 */
+		if (readl(d->reg + RK_RNG_OSC) & RK_RNG_ENABLE)
+			return rk_abort(d, -EBUSY);
+		err = rk_port_idle(d, true);
+		if (err) {
+			/* Retain clocks even if the bounded release attempt succeeds. */
+			rk_port_idle(d, false);
+			return rk_abort(d, err);
+		}
+	} else {
+		rk_irq_off(d);
+	}
+	err = reset_control_assert(d->reset);
+	if (err)
+		return rk_abort(d, err);
+	clk_bulk_disable_unprepare(ARRAY_SIZE(d->clks), d->clks);
+	return 0;
+}
