From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RK3128 reference <reference@example.invalid>
Date: Sun, 8 Nov 2026 03:00:00 +0000
Subject: [PATCH] dt-bindings: media: describe RK3128 RGA1-plus

Describe RGA1-plus resources independently from incompatible RGA2/RGA3
hardware. The engine has no external Rockchip IOMMU.

Signed-off-by: RK3128 reference <reference@example.invalid>

diff --git a/Documentation/devicetree/bindings/media/rockchip,rk3128-rga.yaml b/Documentation/devicetree/bindings/media/rockchip,rk3128-rga.yaml
new file mode 100644
index 0000000..7e5d9fd
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/rockchip,rk3128-rga.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/rockchip,rk3128-rga.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip RK3128 RGA1-plus 2D graphics accelerator
+
+maintainers:
+  - Comzee <reference@example.invalid>
+
+description: |
+  RGA1-plus is a 2D blitter with its own command layout and internal MMU.
+  It is not register-compatible with RGA2 or RGA3. The driver uses physically
+  contiguous DMA buffers and bypasses the internal MMU; there is no external
+  Rockchip IOMMU for this engine. It shares the VIO power domain with display,
+  but not the VPU/HEVC GRF bus mux.
+
+properties:
+  compatible:
+    const: rockchip,rk3128-rga
+  reg:
+    maxItems: 1
+  interrupts:
+    maxItems: 1
+  clocks:
+    items:
+      - description: AXI bus clock
+      - description: AHB register clock
+  clock-names:
+    items:
+      - const: aclk
+      - const: hclk
+  resets:
+    items:
+      - description: AXI reset, private to RGA
+      - description: AHB reset, private to RGA
+  reset-names:
+    items:
+      - const: axi
+      - const: ahb
+  power-domains:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - power-domains
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/rk3128-cru.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/power/rk3128-power.h>
+    rga@1010c000 {
+        compatible = "rockchip,rk3128-rga";
+        reg = <0x1010c000 0x1000>;
+        interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&cru ACLK_RGA>, <&cru HCLK_RGA>;
+        clock-names = "aclk", "hclk";
+        resets = <&cru SRST_RGA_A>, <&cru SRST_RGA_H>;
+        reset-names = "axi", "ahb";
+        power-domains = <&power RK3128_PD_VIO>;
+    };
