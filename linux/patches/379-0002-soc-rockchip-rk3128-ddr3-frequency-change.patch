+/*
+ * The #379 park, kept only for the test kit's A/B (debugfs test "ipipark N"): parked from an
+ * asynchronous IPI, wherever each CPU was when it next had interrupts on. Test builds only.
+ */
+static void dmc_ipi_park_cpu(void *info)
+{
+	struct rk3128_dmc *dmc = info;
+	unsigned int cpu = smp_processor_id();
+	struct dmc_sram *s = dmc->sram + SRAM_PARAM;
+
+	call_with_stack(dmc->sram_park, &s->park[cpu], dmc->sram + SRAM_PARK_STACK(cpu));
+}
+
+static int dmc_ipi_park(struct rk3128_dmc *dmc, struct dmc_cycle *c)
+{
+	struct dmc_sram *s = dmc->sram + SRAM_PARAM;
+	u32 gap = 0, gap_irqs = 0;
+	int ret;
+
+	ret = dmc_park_prepare(dmc, c);
+	if (ret)
+		return ret;
+	c->t0 = dmc_now();
+	c->t_go = c->t0;
+	smp_call_function(dmc_ipi_park_cpu, dmc, 0);
+	if (dmc_poll(dmc, c, SCAN_PARKED, c->t0, ARRIVE_TIMEOUT_US, false, &gap, &gap_irqs)) {
+		c->phase = "park";
+		writel(1, &s->release);
+		dmc->ipi_stale = true;	/* its IPI may still come: never reset the flags again */
+		return -ETIMEDOUT;
+	}
+	c->arrive_us = (c->t_scan - c->t0) / c->tpu;
+	return 0;
+}
+
+static int dmc_ipi_release(struct rk3128_dmc *dmc, struct dmc_cycle *c)
+{
+	struct dmc_sram *s = dmc->sram + SRAM_PARAM;
+	u32 t0 = dmc_now(), gap = 0, gap_irqs = 0;
+
+	writel(1, &s->release);
+	if (dmc_poll(dmc, c, SCAN_UNPARKED, t0, UNPARK_TIMEOUT_US, false, &gap, &gap_irqs)) {
+		c->phase = "release";
+		dmc->ipi_stale = true;
+		return -ETIMEDOUT;
+	}
+	c->release_us = (c->t_scan - t0) / c->tpu;
+	return 0;
+}
