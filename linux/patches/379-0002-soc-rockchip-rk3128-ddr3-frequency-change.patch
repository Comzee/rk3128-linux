+/* debugfs rk3128-dmc/regs: the registers the switch writes, eight words a line */
+static int dmc_regs_show(struct seq_file *m, void *unused)
+{
+	struct rk3128_dmc *dmc = m->private;
+	static const struct { u8 blk; u16 start, end; } r[] = {
+		{ 0, 0x07c, 0x08c }, { 0, 0x0c0, 0x144 }, { 0, 0x240, 0x268 },
+		{ 1, 0x000, 0x05c }, { 1, 0x080, 0x0a0 }, { 1, 0x0c0, 0x0e0 }, { 1, 0x100, 0x120 },
+		{ 1, 0x140, 0x160 }, { 1, 0x290, 0x290 }, { 1, 0x3e8, 0x3fc },
+	};
+	int i, o;
+
+	mutex_lock(&dmc->lock);
+	seq_printf(m, "%u MHz, STAT %u, MCFG %#010x, MCFG1 %#010x, NoC DdrTiming %#010x, DPLL %#x %#x\n",
+		   dmc_cur_mhz(dmc), readl(dmc->pctl + PCTL_STAT) & 7, readl(dmc->pctl + PCTL_MCFG),
+		   readl(dmc->pctl + PCTL_MCFG1), readl(dmc->noc + NOC_DDRTIMING),
+		   readl(dmc->cru + CRU_DPLL_CON0), readl(dmc->cru + CRU_DPLL_CON1));
+	for (i = 0; i < ARRAY_SIZE(r); i++) {
+		void __iomem *b = r[i].blk ? dmc->phy : dmc->pctl;
+
+		for (o = r[i].start; o <= r[i].end; o += 32) {
+			seq_printf(m, "%s+%03x:", r[i].blk ? "phy" : "pctl", o);
+			for (int k = o; k <= r[i].end && k < o + 32; k += 4)
+				seq_printf(m, " %08x", readl(b + k));
+			seq_putc(m, '\n');
+		}
+	}
+	mutex_unlock(&dmc->lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(dmc_regs);
+
+/* ---- one cycle on CPU 0: park, (switch,) release ---------------------------------------- */
+
+struct dmc_job {
+	struct rk3128_dmc *dmc;
+	struct dmc_sram *k;	/* the switch's parameters; NULL: park and release only */
+	u32 *buf;		/* with k: the vendor's pattern check */
+	bool ipi;		/* the kit's #379 IPI park instead of the stopper works */
+	bool legacy;		/* the kit's "irqpark": "go" with CPU 0's interrupts on (15db184) */
+	bool quiet;		/* the kit's relock: no line per switch */
+	bool pattern_ok;
+	struct dmc_cycle c;
+};
+
+static const u32 dmc_pattern[8] = { 0xffffffff, 0, 0x55555555, 0xaaaaaaaa,
+				    0xeeeeeeee, 0x11111111, 0x22222222, 0xdddddddd };
+
+static int dmc_cycle(struct dmc_job *j)
+{
+	struct rk3128_dmc *dmc = j->dmc;
+	struct dmc_sram *s = dmc->sram + SRAM_PARAM;
+	unsigned long flags;
+	u32 t0;
+	int ret, i;
+
+	dmc_irq_snap(dmc);	/* test builds: CPU 0's interrupt counts, for the log after a miss */
+	preempt_disable();
+	ret = j->ipi ? dmc_ipi_park(dmc, &j->c) : dmc_park_arrive(dmc, &j->c);
+	if (!ret && !j->ipi && j->legacy)
+		ret = dmc_park_go(dmc, &j->c, true);	/* the kit's A/B: interrupts still on */
+	if (ret)
+		goto missed;
+	local_irq_save(flags);
+	if (!j->ipi && !j->legacy) {
+		/* interrupts off from "go" on, on CPU 0 as on the others (stop_machine()'s order) */
+		ret = dmc_park_go(dmc, &j->c, false);
+		if (ret) {
+			local_irq_restore(flags);
+			goto missed;
+		}
+	}
+	t0 = dmc_now();
+	flush_cache_all();
+	local_flush_tlb_all();
+	/* the TLB entries of every page the SRAM code touches, before the DRAM goes away */
+	readl(dmc->sram);
+	readl(dmc->sram + SRAM_STACK_TOP - 4);
+	readl(dmc->pctl + PCTL_STAT);
+	readl(dmc->phy + PHY_REG(0x1));
+	readl(dmc->cru + CRU_DPLL_CON0);
+	readl(dmc->grf + GRF_SOC_STATUS0);
+	readl(dmc->pmu + PMU_PWRDN_ST);
+	readl(dmc->noc + NOC_DDRTIMING);
+	dsb();
+	if (j->k)
+		call_with_stack(dmc->sram_run, s, dmc->sram + SRAM_STACK_TOP);
+	j->c.window_us = (dmc_now() - t0) / j->c.tpu;
+	if (j->k) {
+		/* the vendor's check: copy a pattern through the DRAM, flush, compare */
+		memcpy(j->buf, dmc_pattern, sizeof(dmc_pattern));
+		flush_cache_all();
+		for (i = 0; i < 8 && j->buf[i] == dmc_pattern[i]; i++)
+			;
+		j->pattern_ok = i == 8;
+	}
+	local_irq_restore(flags);
+	ret = j->ipi ? dmc_ipi_release(dmc, &j->c) : dmc_release_others(dmc, &j->c);
+	if (ret)
+		dmc_irq_mark(dmc);
+	preempt_enable();
+	if (ret)
+		dmc_miss_stamps(dmc, &j->c);
+	return ret;
+missed:
+	dmc_irq_mark(dmc);
+	preempt_enable();
+	if (j->c.phase && strcmp(j->c.phase, "busy"))
+		dmc_miss_stamps(dmc, &j->c);
+	return ret;
+}
+
+/* runs on CPU 0 (dmc_on_cpu0): the rail, then the cycle */
+static long dmc_job_fn(void *arg)
+{
+	struct dmc_job *j = arg;
+	struct rk3128_dmc *dmc = j->dmc;
+	struct dmc_sram *s = dmc->sram + SRAM_PARAM;
+	int uv, ret;
+
+	if (j->k) {
+		/* vendor OPP: 396 MHz, 1.25 V; the rail first, and no raise without it */
+		uv = regulator_get_voltage(dmc->logic);
+		ret = regulator_set_voltage(dmc->logic, 1250000, 1450000);
+		if (ret) {
+			j->c.phase = "vdd_logic";
+			return ret;
+		}
+		if (uv < 1250000) {
+			usleep_range(1000, 2000);
+			uv = regulator_get_voltage(dmc->logic);
+		}
+		if (uv < 1250000) {
+			j->c.phase = "vdd_logic";
+			return -EIO;
+		}
+		/* the last line before the CPUs stop: a hang after it is in the park or the switch */
+		if (!j->quiet)
+			dev_info(dmc->dev, "vdd_logic %d uV; switching on CPU %u with the other CPUs parked\n",
+				 uv, smp_processor_id());
+		/* the parameters only: step, release and the park flags belong to the park protocol */
+		memcpy_toio(s, j->k, offsetof(struct dmc_sram, step));
+	}
+	return dmc_cycle(j);
+}
+
+/*
+ * Every switch and kit cycle runs on CPU 0, in a kworker bound there, like the vendor's
+ * ddrfreqd (kthread_bind(ddr.task, 0)): its sleeps (the rail's ramp and settle) and wakeups
+ * never go through another CPU's run queue.
+ */
+static int dmc_on_cpu0(struct dmc_job *j)
+{
+	long ret;
+
+	cpus_read_lock();
+	ret = cpu_online(0) ? work_on_cpu(0, dmc_job_fn, j) : -ENODEV;
+	cpus_read_unlock();
+	return ret;
+}
+
+/* a failed park or release, in one line: what, who, and the deadline they missed */
+static void dmc_cycle_err(struct rk3128_dmc *dmc, struct dmc_cycle *c, int ret, const char *what)
+{
+	u32 us = !c->phase ? 0 : !strcmp(c->phase, "report in") ? ARRIVE_TIMEOUT_US :
+		 !strcmp(c->phase, "park") ? PARK_TIMEOUT_US :
+		 !strcmp(c->phase, "release") ? UNPARK_TIMEOUT_US : 0;
+
+	if (us) {
+		dev_err(dmc->dev, "%s: CPUs %*pbl (of %*pbl) missed the %s deadline of %u us (%d)\n",
+			what, cpumask_pr_args(&c->late), cpumask_pr_args(&c->others), c->phase, us,
+			ret);
+		dmc_miss_log(dmc, c, what);
+		dmc_irq_log(dmc, what);
+	} else if (c->phase && !strcmp(c->phase, "busy"))
+		dev_err(dmc->dev, "%s: CPUs %*pbl have not run the stopper work of an earlier attempt yet%s (%d)\n",
+			what, cpumask_pr_args(&c->late),
+			dmc->ipi_stale ? ", or a test IPI park timed out" : "", ret);
+	else
+		dev_err(dmc->dev, "%s: %s failed (%d)\n", what, c->phase ?: "the CPU 0 work", ret);
+}
+
+/* the park missed a deadline (or found an earlier attempt's work still queued): nothing changed */
+static bool dmc_park_missed(struct dmc_cycle *c)
+{
+	return c->phase && (!strcmp(c->phase, "busy") || !strcmp(c->phase, "report in") ||
+			    !strcmp(c->phase, "park"));
+}
+
+/*
+ * One switch to @want MHz; relock: the same rate again (the test kit's run of the whole
+ * sequence). Up only otherwise, into the DRAM's DLL-on range: going back down to the vendor's
+ * 300 MHz mode (DRAM DLL off, no ODT) decoded with errors on the board (attempt 379-7).
+ */
+static int dmc_switch(struct rk3128_dmc *dmc, u32 want, bool relock, struct dmc_job *j)
+{
+	struct dmc_sram *s = dmc->sram + SRAM_PARAM;
+	struct dmc_sram *k;
+	u32 fb, pd1, pd2, mhz, cur, step, deidle;
+	bool quiet = j->quiet;
+	int ret, attempt;
+	u32 *buf;
+
+	if (want <= DLL_DISABLE_FREQ || want > 400)
+		return -EINVAL;
+	mhz = dmc_pll(want, &fb, &pd1, &pd2);
+	cur = dmc_cur_mhz(dmc);
+	if (mhz < cur || (relock && mhz != cur))
+		return -EINVAL;
+	if (!cur || readl(dmc->pctl + PCTL_TOGCNT1U) != cur) {
+		dev_err(dmc->dev, "DPLL says %u MHz, TOGCNT1U %u: not touching it\n", cur,
+			readl(dmc->pctl + PCTL_TOGCNT1U));
+		return -EIO;
+	}
+	if (mhz == cur && !relock)
+		return 0;
+	k = kzalloc_obj(*k);
+	buf = kmalloc(sizeof(dmc_pattern), GFP_KERNEL);
+	if (!k || !buf) {
+		kfree(k);
+		kfree(buf);
+		return -ENOMEM;
+	}
+	k->pctl = dmc->pctl;
+	k->phy = dmc->phy;
+	k->cru = dmc->cru;
+	k->grf = dmc->grf;
+	k->pmu = dmc->pmu;
+	k->noc = dmc->noc;
+	k->freq = mhz;
+	k->slew_up = mhz > cur;
+	k->ticks_per_us = DIV_ROUND_UP(arch_timer_get_rate(), 1000000);
+	k->fbdiv = fb;
+	k->postdiv1 = pd1;
+	k->postdiv2 = pd2;
+	dmc_timing(dmc, mhz, k);
+	k->dll_status = dmc->dll_status;
+	k->sr_idle = 0;		/* the vendor's: no auto self-refresh */
+	k->pd_idle = pd_idle;
+	if (!quiet)
+		dev_info(dmc->dev, "%u -> %u MHz: DPLL fbdiv %u postdiv %u/%u, CL %u CWL %u tRFC %u tRAS %u tRC %u, pd_idle %#x, MR0 %#x MR1 %#x MR2 %#x, NoC %#x (was %#x), MCFG1 %#x MCFG %#x\n",
+			 cur, mhz, fb, pd1, pd2, k->timing[T_TCL], k->timing[T_TCWL],
+			 k->timing[T_TRFC], k->timing[T_TRAS], k->timing[T_TRC], k->pd_idle, k->mr[0],
+			 k->mr[1], k->mr[2], k->noc_timing, readl(dmc->noc + NOC_DDRTIMING),
+			 readl(dmc->pctl + PCTL_MCFG1), readl(dmc->pctl + PCTL_MCFG));
+
+	j->dmc = dmc;
+	j->k = k;
+	j->buf = buf;
+	/*
+	 * A park that missed its deadline changed nothing: try again (twice) after letting the
+	 * late CPUs run; the kit counts every miss instead.
+	 */
+	for (attempt = 1;; attempt++) {
+		memset(&j->c, 0, sizeof(j->c));
+		ret = dmc_on_cpu0(j);
+		if (!ret || !dmc_park_missed(&j->c) || quiet || attempt == 3)
+			break;
+		dmc_cycle_err(dmc, &j->c, ret, "no switch, trying again");
+		msleep(20);
+	}
+	if (ret && !(j->c.phase && !strcmp(j->c.phase, "release"))) {
+		/* nothing changed: the CPUs did not all park, or the rail did not come up */
+		dmc_cycle_err(dmc, &j->c, ret, "no switch");
+		dev_err(dmc->dev, "staying at %u MHz\n", cur);
+		goto out;
+	}
+	step = readl(&s->step);
+	if (step == STEP_IDLE_TIMEOUT) {
+		dev_err(dmc->dev, "the NoC ports did not idle in %u us (GRF_SOC_STATUS0 %#x): nothing changed, staying at %u MHz\n",
+			IDLE_TIMEOUT_US, readl(&s->idle_status), cur);
+		ret = ret ?: -ETIMEDOUT;
+		goto out;
+	}
+	dmc->dll_status = readl(&s->dll_status);
+	deidle = readl(&s->deidle_fail);
+	if (!quiet || ret || step != 8 || !j->pattern_ok || deidle)
+		dev_info(dmc->dev, "now %u MHz (TOGCNT1U %u, STAT %u, DPLL %#x %#x, PHY_REGff %#x, NoC %#x), step %u, %u us with the CPUs parked (in %u + %u us, out %u us), pattern %s\n",
+			 dmc_cur_mhz(dmc), readl(dmc->pctl + PCTL_TOGCNT1U),
+			 readl(dmc->pctl + PCTL_STAT) & 7,
+			 readl(dmc->cru + CRU_DPLL_CON0), readl(dmc->cru + CRU_DPLL_CON1),
+			 readl(dmc->phy + PHY_REG(0xff)), readl(dmc->noc + NOC_DDRTIMING), step,
+			 j->c.window_us, j->c.arrive_us, j->c.park_us, j->c.release_us,
+			 j->pattern_ok ? "ok" : "MISMATCH");
+	if (deidle)
+		dev_err(dmc->dev, "the NoC ports did not leave idle in %u us after the switch (GRF_SOC_STATUS0 %#x)\n",
+			IDLE_TIMEOUT_US, readl(&s->idle_status));
+	if (ret) {
+		/* switched, but a CPU did not come back out of SRAM in time */
+		dmc_cycle_err(dmc, &j->c, ret, "after the switch");
+		goto out;
+	}
+	ret = step == 8 && j->pattern_ok && !deidle ? 0 : -EIO;
+out:
+	j->k = NULL;
+	j->buf = NULL;
+	kfree(k);
+	kfree(buf);
+	return ret;
+}
+
+static int dmc_mhz_get(void *data, u64 *val)
+{
+	*val = dmc_cur_mhz(data);
+	return 0;
+}
+
+static int dmc_mhz_set(void *data, u64 val)
+{
+	struct rk3128_dmc *dmc = data;
+	struct dmc_job j = { };
+	int ret;
+
+	mutex_lock(&dmc->lock);
+	ret = dmc_switch(dmc, val, false, &j);
+	mutex_unlock(&dmc->lock);
+	return ret;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(dmc_mhz_fops, dmc_mhz_get, dmc_mhz_set, "%llu\n");
+
+/* ---- the test kit: debugfs rk3128-dmc/test (#456), CONFIG_ROCKCHIP_RK3128_DMC_TEST only ----- */
+#ifdef CONFIG_ROCKCHIP_RK3128_DMC_TEST
+
+/*
+ * Write "park N" (the park and release alone, no DDR change), "relock N" (the whole switch
+ * sequence at the current rate: self-refresh, DPLL relock, PHY reset, training; then a 1 MiB
+ * pattern read back from the DRAM), "ipipark N" (the #379 IPI park, for the A/B) or "irqpark N"
+ * (the 15db184 park: "go" with CPU 0's interrupts on and the clock read after the scan, for the
+ * #456 A/B), N up to 100000. A park or report-in miss changed nothing: it is counted, the first
+ * three of a run are logged with every CPU's stamps, and the run goes on (the write then fails
+ * with -ETIMEDOUT); any other failure stops it. Read: the counts and the slowest phase times
+ * per kind. Never above the current rate or the 1.25 V rail; the product never writes it.
+ */
+static const char * const kit_name[KIT_N] = { "park", "relock", "ipipark", "irqpark" };
+#define KIT_MEM_WORDS	(SZ_1M / 4)
+
+static u32 kit_fill(u32 *m, u32 seed)
+{
+	u32 i, x = seed | 1;
+
+	for (i = 0; i < KIT_MEM_WORDS; i++) {
+		x ^= x << 13;
+		x ^= x >> 17;
+		x ^= x << 5;
+		m[i] = x;
+	}
+	return seed | 1;
+}
+
+static u32 kit_check(const u32 *m, u32 x)
+{
+	u32 i, bad = 0;
+
+	for (i = 0; i < KIT_MEM_WORDS; i++) {
+		x ^= x << 13;
+		x ^= x >> 17;
+		x ^= x << 5;
+		bad += m[i] != x;
+	}
+	return bad;
+}
+
+static void kit_count(struct dmc_kit *t, struct dmc_job *j, int ret, const char *bad)
+{
+	struct dmc_cycle *c = &j->c;
+	u32 tpu = c->tpu ?: 1;
+
+	t->runs++;
+	if (!ret && !bad)
+		t->ok++;
+	else if (ret == -EBUSY)
+		t->busy++;
+	else if (ret && c->phase && !strcmp(c->phase, "report in"))
+		t->late_arrive++;
+	else if (ret && c->phase && !strcmp(c->phase, "park"))
+		t->late_park++;
+	else if (ret && c->phase && !strcmp(c->phase, "release"))
+		t->late_release++;
+	else
+		t->bad++;
+	if (ret && dmc_miss_false(c))
+		t->false_park++;
+	if (ret || bad)
+		snprintf(t->last, sizeof(t->last), "cycle %u: %s, CPUs %*pbl (%d)", t->runs,
+			 bad ?: c->phase ?: "error", cpumask_pr_args(&c->late), ret);
+	t->max_arrive_us = max(t->max_arrive_us, c->arrive_us);
+	t->max_true_in_us = max(t->max_true_in_us, c->true_in_us);
+	t->max_park_us = max(t->max_park_us, c->park_us);
+	t->max_window_us = max(t->max_window_us, c->window_us);
+	t->max_release_us = max(t->max_release_us, c->release_us);
+	t->max_gap0_us = max(t->max_gap0_us, c->gap_park / tpu);
+}
+
+/* a miss that changed nothing and left no work behind: the kit counts it and goes on */
+static bool kit_go_on(struct dmc_job *j, int ret)
+{
+	return ret == -ETIMEDOUT && !j->ipi && j->c.phase &&
+	       (!strcmp(j->c.phase, "park") || !strcmp(j->c.phase, "report in"));
+}
+
+static int dmc_kit_run(struct rk3128_dmc *dmc, int kind, u32 n)
+{
+	struct dmc_kit *t = &dmc->kit[kind];
+	u32 i, seed, cur = dmc_cur_mhz(dmc), runs0 = t->runs, ok0 = t->ok, miss = 0;
+	const char *bad = NULL;
+	struct dmc_job j;
+	u32 *mem = NULL;
+	int ret = 0;
+
+	if (kind == KIT_RELOCK) {
+		mem = vmalloc(SZ_1M);
+		if (!mem)
+			return -ENOMEM;
+	}
+	for (i = 0; i < n; i++) {
+		memset(&j, 0, sizeof(j));
+		j.dmc = dmc;
+		j.quiet = true;
+		if (kind == KIT_RELOCK) {
+			seed = kit_fill(mem, 0x9e3779b9 * (t->runs + 1));
+			ret = dmc_switch(dmc, cur, true, &j);
+			/* the whole MiB comes back from the DRAM: the cycle flushed every cache */
+			if (!ret && kit_check(mem, seed))
+				bad = "1 MiB pattern mismatch";
+			else if (!ret && dmc_cur_mhz(dmc) != cur)
+				bad = "rate changed";
+		} else {
+			j.ipi = kind == KIT_IPI;
+			j.legacy = kind == KIT_IRQPARK;
+			ret = dmc_on_cpu0(&j);
+		}
+		kit_count(t, &j, ret, bad);
+		if (!bad && kit_go_on(&j, ret)) {
+			/* relock: dmc_switch() logged it; the first three of a run with their stamps */
+			if (kind != KIT_RELOCK && miss < 3)
+				dmc_cycle_err(dmc, &j.c, ret, kit_name[kind]);
+			miss++;
+			ret = 0;
+			continue;
+		}
+		if (ret || bad)
+			break;
+		cond_resched();
+		if (fatal_signal_pending(current))
+			break;
+	}
+	vfree(mem);
+	dev_info(dmc->dev, "test %s: %u of %u cycles ok (asked %u), %u park misses (%u with every late CPU parked before the miss); max us: in %u (by the CPUs' stamps %u), park %u, window %u, out %u, CPU 0 away in the park %u%s%s\n",
+		 kit_name[kind], t->ok - ok0, t->runs - runs0, n, miss, t->false_park,
+		 t->max_arrive_us, t->max_true_in_us, t->max_park_us, t->max_window_us,
+		 t->max_release_us, t->max_gap0_us, ret || bad ? "; FAILED " : "",
+		 ret || bad ? t->last : "");
+	if (ret && kind != KIT_RELOCK)
+		dmc_cycle_err(dmc, &j.c, ret, kit_name[kind]);
+	if (ret || bad)
+		return ret ?: -EIO;
+	return miss ? -ETIMEDOUT : 0;
+}
+
+static int dmc_test_show(struct seq_file *m, void *unused)
+{
+	struct rk3128_dmc *dmc = m->private;
+	int i;
+
+	mutex_lock(&dmc->lock);
+	for (i = 0; i < KIT_N; i++) {
+		struct dmc_kit *t = &dmc->kit[i];
+
+		seq_printf(m, "%s: runs %u ok %u busy %u late in %u park %u (false %u) out %u bad %u; max us: in %u (stamps %u) park %u window %u out %u cpu0-away %u%s%s\n",
+			   kit_name[i], t->runs, t->ok, t->busy, t->late_arrive, t->late_park,
+			   t->false_park, t->late_release, t->bad, t->max_arrive_us,
+			   t->max_true_in_us, t->max_park_us, t->max_window_us, t->max_release_us,
+			   t->max_gap0_us, t->last[0] ? "; last failure: " : "", t->last);
+	}
+	mutex_unlock(&dmc->lock);
+	return 0;
+}
+
+static int dmc_test_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, dmc_test_show, inode->i_private);
+}
+
+static ssize_t dmc_test_write(struct file *file, const char __user *ubuf, size_t len,
+			      loff_t *ppos)
+{
+	struct rk3128_dmc *dmc = ((struct seq_file *)file->private_data)->private;
+	char buf[32], *p;
+	size_t l = 0;
+	int kind, ret;
+	u32 n;
+
+	if (!len || len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = 0;
+	p = strim(buf);
+	for (kind = 0; kind < KIT_N; kind++) {
+		l = strlen(kit_name[kind]);
+		if (!strncmp(p, kit_name[kind], l) && p[l] == ' ')
+			break;
+	}
+	if (kind == KIT_N || kstrtou32(skip_spaces(p + l), 10, &n) || !n || n > 100000)
+		return -EINVAL;
+	mutex_lock(&dmc->lock);
+	ret = dmc_kit_run(dmc, kind, n);
+	mutex_unlock(&dmc->lock);
+	return ret ?: len;
+}
+
+static const struct file_operations dmc_test_fops = {
+	.owner = THIS_MODULE,
+	.open = dmc_test_open,
+	.read = seq_read,
+	.write = dmc_test_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+#endif /* CONFIG_ROCKCHIP_RK3128_DMC_TEST */
+
+/*
+ * Copy one function to SRAM at or after *next, at the same address modulo 8 (Thumb-2
+ * literal loads are relative to the word-aligned PC); kallsyms gives its size up to the
+ * next symbol, so its literal pool comes along.
+ */
+static int dmc_copy(struct rk3128_dmc *dmc, void (*fn)(void *), unsigned long *next,
+		    void (**out)(void *))
+{
+	unsigned long addr = (unsigned long)fn & ~1UL, size = 0, offset = 0;
+	unsigned long off = ALIGN(*next, 8) + (addr & 7);
+
+	if (!kallsyms_lookup_size_offset(addr, &size, &offset) || offset ||
+	    off + size > SRAM_CODE_MAX) {
+		dev_err(dmc->dev, "SRAM code %ps: %lu bytes at +%#lx, offset %lu: does not fit\n",
+			fn, size, off, offset);
+		return -E2BIG;
+	}
+	memcpy_toio(dmc->sram + off, (void *)addr, size);
+	flush_icache_range((unsigned long)dmc->sram + off, (unsigned long)dmc->sram + off + size);
+	*out = (void *)((unsigned long)dmc->sram + off + ((unsigned long)fn & 1UL));
+	dev_info(dmc->dev, "%ps: %lu bytes to SRAM +%#lx\n", fn, size, off);
+	*next = off + size;
+	return 0;
+}
+
+static void __iomem *dmc_map_phandle(struct device *dev, const char *prop)
+{
+	struct device_node *np = of_parse_phandle(dev->of_node, prop, 0);
+	void __iomem *base;
+
+	if (!np)
+		return NULL;
+	base = of_iomap(np, 0);	/* shared with the owner's driver: no region request */
+	of_node_put(np);
+	return base;
+}
+
+static int rk3128_dmc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct rk3128_dmc *dmc;
+	struct resource *r;
+	u32 os, cs, col, bank, row, bw, diebw, cap;
+	unsigned long next = 0;
+	u32 mhz = 0;
+	int ret;
+
+	dmc = devm_kzalloc(dev, sizeof(*dmc), GFP_KERNEL);
+	if (!dmc)
+		return -ENOMEM;
+	dmc->dev = dev;
+	mutex_init(&dmc->lock);
+	dmc->pctl = devm_platform_ioremap_resource_byname(pdev, "pctl");
+	dmc->phy = devm_platform_ioremap_resource_byname(pdev, "phy");
+	dmc->noc = devm_platform_ioremap_resource_byname(pdev, "noc");
+	if (IS_ERR(dmc->pctl) || IS_ERR(dmc->phy) || IS_ERR(dmc->noc))
+		return dev_err_probe(dev, -ENODEV, "registers\n");
+	dmc->cru = dmc_map_phandle(dev, "rockchip,cru");
+	dmc->grf = dmc_map_phandle(dev, "rockchip,grf");
+	dmc->pmu = dmc_map_phandle(dev, "rockchip,pmu");
+	if (!dmc->cru || !dmc->grf || !dmc->pmu)
+		return dev_err_probe(dev, -ENODEV, "CRU, GRF or PMU\n");
+	r = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sram");
+	if (!r || r->start != SRAM_PHYS || resource_size(r) != SRAM_SIZE)
+		return dev_err_probe(dev, -EINVAL, "sram must be %#x + %#x\n",
+				     SRAM_PHYS, SRAM_SIZE);
+	dmc->sram = __arm_ioremap_exec(r->start, SRAM_SIZE, false);
+	if (!dmc->sram)
+		return -ENOMEM;
+
+	/* required: the vendor's 396 MHz OPP needs vdd_logic at 1.25 V, so no rail, no raise */
+	dmc->logic = devm_regulator_get_optional(dev, "logic");
+	if (IS_ERR(dmc->logic))
+		return dev_err_probe(dev, PTR_ERR(dmc->logic), "logic-supply (vdd_logic)\n");
+
+	/* the loader's DDR geometry (GRF_OS_REG1), as the vendor reads it */
+	os = readl(dmc->grf + GRF_OS_REG1);
+	cs = ((os >> 11) & 1) + 1;
+	col = 9 + ((os >> 9) & 3);
+	bank = 3 - ((os >> 8) & 1);
+	row = 13 + ((os >> 6) & 3);
+	bw = 2 >> ((os >> 2) & 3);
+	diebw = 2 >> (os & 3);
+	cap = 1U << (row + col + bank + bw);
+	if (cs > 1)
+		cap += 1U << (13 + ((os >> 4) & 3) + col + bank + bw);
+	dmc->cap_per_die = cap / (cs * (1 << (bw - diebw)));
+	/* as the vendor seeds it: the first raise resets the DLL */
+	dmc->dll_status = DDR3_DLL_DISABLE;
+
+	dev_info(dev, "%s, %u CS, row %u, %u banks, col %u, %u bit, %u MB (%u MB a die); uPCTL %#x/%#x, STAT %u, %u MHz (TOGCNT1U %u), vdd_logic %d uV\n",
+		 ((os >> 13) & 7) == 3 ? "DDR3" : "not DDR3", cs, row, 1 << bank, col, 8 << bw,
+		 cap >> 20, dmc->cap_per_die >> 20, readl(dmc->pctl + PCTL_IPVR),
+		 readl(dmc->pctl + PCTL_IPTR), readl(dmc->pctl + PCTL_STAT) & 7, dmc_cur_mhz(dmc),
+		 readl(dmc->pctl + PCTL_TOGCNT1U),
+		 regulator_get_voltage(dmc->logic));
+	if (((os >> 13) & 7) != 3 || (readl(dmc->pctl + PCTL_STAT) & 7) != ST_ACCESS ||
+	    readl(dmc->pctl + PCTL_TOGCNT1U) != dmc_cur_mhz(dmc))
+		return dev_err_probe(dev, -ENODEV,
+				     "not the DDR3 controller state this driver knows\n");
+
+	ret = dmc_copy(dmc, rk3128_dmc_sram_run, &next, &dmc->sram_run);
+	if (!ret)
+		ret = dmc_copy(dmc, rk3128_dmc_sram_park, &next, &dmc->sram_park);
+	if (ret)
+		return ret;
+	BUILD_BUG_ON(SRAM_PARAM + sizeof(struct dmc_sram) > SRAM_PARK_STACK(0) - 0x40);
+	BUILD_BUG_ON(SRAM_PARK_STACK(NR_CPUS - 1) > SRAM_STACK_TOP - 0x200);
+
+	platform_set_drvdata(pdev, dmc);
+	dmc->dbg = debugfs_create_dir("rk3128-dmc", NULL);
+	debugfs_create_file_unsafe("mhz", 0600, dmc->dbg, dmc, &dmc_mhz_fops);
+	debugfs_create_file("regs", 0400, dmc->dbg, dmc, &dmc_regs_fops);
+#ifdef CONFIG_ROCKCHIP_RK3128_DMC_TEST	/* the hevc test image only, never a product build */
+	debugfs_create_file("test", 0600, dmc->dbg, dmc, &dmc_test_fops);
+#endif
+
+	if (boot_mhz >= 0)
+		mhz = boot_mhz;
+	else
+		of_property_read_u32(dev->of_node, "rockchip,boot-mhz", &mhz);
+	if (mhz) {
+		struct dmc_job j = { };
+
+		mutex_lock(&dmc->lock);
+		ret = dmc_switch(dmc, mhz, false, &j);
+		mutex_unlock(&dmc->lock);
+		if (ret)
+			dev_err(dev, "switch to %u MHz at probe: %d\n", mhz, ret);
+	}
+	return 0;
+}
+
+static const struct of_device_id rk3128_dmc_of_match[] = {
+	{ .compatible = "rockchip,rk3128-dmc" },
+	{ }
+};
+
+static struct platform_driver rk3128_dmc_driver = {
+	.probe = rk3128_dmc_probe,
+	.driver = {
+		.name = "rk3128-dmc",
+		.of_match_table = rk3128_dmc_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(rk3128_dmc_driver);
