+/* at a miss, before anything else runs: the counts become what ran since dmc_irq_snap() */
+static void dmc_irq_mark(struct rk3128_dmc *dmc)
+{
+	unsigned int i, nr = irq_get_nr_irqs();
+
+	for (i = 0; i < KIT_NIRQ && i < nr; i++)
+		dmc->kirq[i] = kstat_irqs_cpu(i, 0) - dmc->kirq[i];
+	for (i = 0; i < NR_SOFTIRQS; i++)
+		dmc->ksirq[i] = kstat_softirqs_cpu(i, 0) - dmc->ksirq[i];
+}
