Subject: [PATCH 1/2] ASoC: dt-bindings: add the Rockchip RK3128 internal codec

The RK3128 and RK3126 have an internal Inno audio codec whose register map
differs from the RK3036 one. Document its node: a register window, the
register clock and the master clock, the GRF that selects it, and the time
its output stage needs to settle before an external amplifier is enabled.

diff --git a/Documentation/devicetree/bindings/sound/rockchip,rk3128-codec.yaml b/Documentation/devicetree/bindings/sound/rockchip,rk3128-codec.yaml
new file mode 100644
index 000000000..5c8a84f14
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/rockchip,rk3128-codec.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/rockchip,rk3128-codec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip RK3128 and RK3126 internal codec
+
+maintainers:
+  - Comzee <reference@example.invalid>
+
+description:
+  The internal audio codec of the RK3128 and RK3126. On the RK3128 it is
+  connected to the 8-channel I2S controller. Only playback is supported.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: rockchip,rk3128-codec
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: clock for the register interface of the codec
+      - description: master clock of the codec, the I2S controller's clock
+
+  clock-names:
+    items:
+      - const: pclk
+      - const: mclk
+
+  rockchip,grf:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The phandle of the syscon node for the GRF register.
+
+  spk-depop-time-ms:
+    default: 200
+    description:
+      Time in msec the output stage is given to settle after power-up,
+      before the external amplifier is enabled.
+
+  "#sound-dai-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - rockchip,grf
+  - "#sound-dai-cells"
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/rk3128-cru.h>
+    codec: audio-codec@20030000 {
+      compatible = "rockchip,rk3128-codec";
+      reg = <0x20030000 0x4000>;
+      clocks = <&cru PCLK_ACODEC>, <&cru SCLK_I2S0>;
+      clock-names = "pclk", "mclk";
+      rockchip,grf = <&grf>;
+      spk-depop-time-ms = <200>;
+      #sound-dai-cells = <0>;
+    };
