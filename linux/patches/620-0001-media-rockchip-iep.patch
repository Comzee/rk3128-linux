+static int iep_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct iep_dev *iep;
+	int ret;
+
+	iep = kzalloc_obj(*iep);
+	if (!iep)
+		return -ENOMEM;
+	iep->dev = get_device(dev);
+	iep->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(iep->regs)) {
+		ret = PTR_ERR(iep->regs);
+		goto free_dev;
+	}
+	iep->clocks[0].id = "axi";
+	iep->clocks[1].id = "ahb";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(iep->clocks), iep->clocks);
+	if (ret)
+		goto free_dev;
+	iep->resets = devm_reset_control_array_get_exclusive(dev);
+	if (IS_ERR(iep->resets)) {
+		ret = PTR_ERR(iep->resets);
+		goto free_dev;
+	}
+	/* The MMU is a runtime-PM supplier and resumes before this device.
+	 * Finish the initial interface reset now, with clocks running, so
+	 * the supplier can access its DTE register on the first job.
+	 */
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(iep->clocks), iep->clocks);
+	if (ret)
+		goto free_dev;
+	ret = reset_control_assert(iep->resets);
+	if (!ret) {
+		udelay(5);
+		ret = reset_control_deassert(iep->resets);
+	}
+	clk_bulk_disable_unprepare(ARRAY_SIZE(iep->clocks), iep->clocks);
+	if (ret)
+		goto free_dev;
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		goto free_dev;
+	/* One IOVA extent per image, including physically scattered imports. */
+	ret = vb2_dma_contig_set_max_seg_size(dev, DMA_BIT_MASK(32));
+	if (ret)
+		goto free_dev;
+	mutex_init(&iep->lock);
+	INIT_LIST_HEAD(&iep->contexts);
+	INIT_WORK(&iep->work, iep_work);
+	spin_lock_init(&iep->irq_lock);
+	platform_set_drvdata(pdev, iep);
+	iep->irq = platform_get_irq(pdev, 0);
+	if (iep->irq < 0) {
+		ret = iep->irq;
+		goto free_dev;
+	}
+	ret = devm_request_irq(dev, iep->irq, iep_irq, IRQF_SHARED, dev_name(dev), iep);
+	if (ret)
+		goto free_dev;
+	iep->v4l2.release = iep_v4l2_release;
+	ret = v4l2_device_register(dev, &iep->v4l2);
+	if (ret)
+		goto free_irq;
+	iep->m2m = v4l2_m2m_init(&iep_m2m_ops);
+	if (IS_ERR(iep->m2m)) {
+		ret = PTR_ERR(iep->m2m);
+		goto unregister;
+	}
+	iep->video = video_device_alloc();
+	if (!iep->video) {
+		ret = -ENOMEM;
+		goto release_m2m;
+	}
+	strscpy(iep->video->name, "rockchip-iep", sizeof(iep->video->name));
+	iep->video->fops = &iep_fops;
+	iep->video->ioctl_ops = &iep_ioctl_ops;
+	iep->video->release = video_device_release;
+	iep->video->v4l2_dev = &iep->v4l2;
+	iep->video->lock = &iep->lock;
+	iep->video->vfl_dir = VFL_DIR_M2M;
+	iep->video->device_caps = V4L2_CAP_VIDEO_M2M | V4L2_CAP_STREAMING |
+		V4L2_CAP_EXT_PIX_FORMAT;
+	video_set_drvdata(iep->video, iep);
+	pm_runtime_enable(dev);
+	ret = video_register_device(iep->video, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto disable_pm;
+	dev_info(dev, "IEP v1 on %s, idle until queued\n", video_device_node_name(iep->video));
+	return 0;
+disable_pm:
+	pm_runtime_disable(dev);
+	video_device_release(iep->video);
+release_m2m:
+	v4l2_m2m_release(iep->m2m);
+unregister:
+	v4l2_device_unregister(&iep->v4l2);
+free_irq:
+	devm_free_irq(dev, iep->irq, iep);
+free_dev:
+	put_device(iep->dev);
+	kfree(iep);
+	return dev_err_probe(dev, ret, "IEP probe failed\n");
+}
+
+static void iep_remove(struct platform_device *pdev)
+{
+	struct iep_dev *iep = platform_get_drvdata(pdev);
+	struct iep_ctx *ctx;
+
+	mutex_lock(&iep->lock);
+	WRITE_ONCE(iep->disconnected, true);
+	v4l2_device_disconnect(&iep->v4l2);
+	video_unregister_device(iep->video);
+	list_for_each_entry(ctx, &iep->contexts, list) {
+		vb2_queue_error(v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx));
+		vb2_queue_error(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx));
+	}
+	v4l2_m2m_suspend(iep->m2m);
+	flush_work(&iep->work);
+	mutex_unlock(&iep->lock);
+	pm_runtime_disable(iep->dev);
+	if (!pm_runtime_status_suspended(iep->dev))
+		iep_runtime_suspend(iep->dev);
+	devm_free_irq(iep->dev, iep->irq, iep);
+	v4l2_device_put(&iep->v4l2);
+}
