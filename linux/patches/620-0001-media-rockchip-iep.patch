+static int iep_release(struct file *file)
+{
+	struct iep_ctx *ctx = fh_ctx(file->private_data);
+	struct iep_dev *iep = ctx->iep;
+
+	mutex_lock(&iep->lock);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	list_del(&ctx->list);
+	v4l2_ctrl_handler_free(&ctx->controls);
+	v4l2_fh_del(&ctx->fh, file);
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+	mutex_unlock(&iep->lock);
+	v4l2_device_put(&iep->v4l2);
+	return 0;
+}
