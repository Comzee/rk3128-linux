+static int iep_open(struct file *file)
+{
+	struct iep_dev *iep = video_drvdata(file);
+	struct iep_ctx *ctx;
+	int ret;
+
+	if (mutex_lock_interruptible(&iep->lock))
+		return -ERESTARTSYS;
+	if (iep->disconnected) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx) {
+		ret = -ENOMEM;
+		goto unlock;
+	}
+	ctx->iep = iep;
+	init_completion(&ctx->done);
+	v4l2_fh_init(&ctx->fh, iep->video);
+	ctx->fmt[0].width = 640;
+	ctx->fmt[0].height = 480;
+	iep_adjust_fmt(&ctx->fmt[0], true);
+	ctx->fmt[1] = ctx->fmt[0];
+	v4l2_ctrl_handler_init(&ctx->controls, 31);
+	ctx->brightness = v4l2_ctrl_new_std(&ctx->controls, NULL,
+					    V4L2_CID_BRIGHTNESS, -32, 31, 1, 0);
+	ctx->contrast = v4l2_ctrl_new_std(&ctx->controls, NULL, V4L2_CID_CONTRAST, 0, 255, 1, 128);
+	ctx->saturation = v4l2_ctrl_new_std(&ctx->controls, NULL,
+					    V4L2_CID_SATURATION, 0, 255, 1, 128);
+	ctx->hue = v4l2_ctrl_new_std(&ctx->controls, NULL, V4L2_CID_HUE, -30, 30, 1, 0);
+	ctx->amount = v4l2_ctrl_new_std(&ctx->controls, NULL, V4L2_CID_SHARPNESS, 0, 127, 1, 8);
+	ctx->filter = v4l2_ctrl_new_custom(&ctx->controls, &iep_filter_control, NULL);
+	ctx->threshold = v4l2_ctrl_new_custom(&ctx->controls, &iep_threshold_control, NULL);
+	ctx->radius = v4l2_ctrl_new_custom(&ctx->controls, &iep_radius_control, NULL);
+	ctx->cg_enable = v4l2_ctrl_new_custom(&ctx->controls, &iep_rgb_controls[0], NULL);
+	ctx->cg = v4l2_ctrl_new_custom(&ctx->controls, &iep_rgb_controls[1], NULL);
+	ctx->order = v4l2_ctrl_new_custom(&ctx->controls, &iep_rgb_controls[2], NULL);
+	ctx->color = v4l2_ctrl_new_custom(&ctx->controls, &iep_rgb_controls[3], NULL);
+	ctx->coefficient = v4l2_ctrl_new_custom(&ctx->controls, &iep_rgb_controls[4], NULL);
+	ctx->alpha = v4l2_ctrl_new_custom(&ctx->controls, &iep_rgb_controls[5], NULL);
+	ctx->weights = v4l2_ctrl_new_custom(&ctx->controls, &iep_rgb_controls[6], NULL);
+	ctx->deinterlace = v4l2_ctrl_new_custom(&ctx->controls, &iep_dei_controls[0], NULL);
+	ctx->ei_mode = v4l2_ctrl_new_custom(&ctx->controls, &iep_dei_controls[1], NULL);
+	ctx->ei_smooth = v4l2_ctrl_new_custom(&ctx->controls, &iep_dei_controls[2], NULL);
+	ctx->ei_select = v4l2_ctrl_new_custom(&ctx->controls, &iep_dei_controls[3], NULL);
+	ctx->ei_radius = v4l2_ctrl_new_custom(&ctx->controls, &iep_dei_controls[4], NULL);
+	ctx->hf = v4l2_ctrl_new_custom(&ctx->controls, &iep_dei_controls[5], NULL);
+	ctx->hf_factor = v4l2_ctrl_new_custom(&ctx->controls, &iep_dei_controls[6], NULL);
+	ctx->pattern = v4l2_ctrl_new_custom(&ctx->controls, &iep_pattern_control, NULL);
+	ctx->solid = v4l2_ctrl_new_custom(&ctx->controls, &iep_solid_control, NULL);
+	ctx->dither_up = v4l2_ctrl_new_custom(&ctx->controls, &iep_dither_control, NULL);
+	ret = ctx->controls.error;
+	if (ret)
+		goto free_ctx;
+	ctx->fh.ctrl_handler = &ctx->controls;
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(iep->m2m, ctx, iep_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		goto free_ctx;
+	}
+	file->private_data = &ctx->fh;
+	v4l2_fh_add(&ctx->fh, file);
+	list_add(&ctx->list, &iep->contexts);
+	v4l2_device_get(&iep->v4l2);
+	mutex_unlock(&iep->lock);
+	return 0;
+free_ctx:
+	v4l2_ctrl_handler_free(&ctx->controls);
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+unlock:
+	mutex_unlock(&iep->lock);
+	return ret;
+}
