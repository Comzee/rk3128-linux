+static int iep_runtime_resume(struct device *dev)
+{
+	struct iep_dev *iep = dev_get_drvdata(dev);
+	int ret;
+	unsigned long flags;
+
+	if (READ_ONCE(iep->broken))
+		return -ENODEV;
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(iep->clocks), iep->clocks);
+	if (ret)
+		return ret;
+	udelay(5);
+	ret = reset_control_deassert(iep->resets);
+	if (ret) {
+		clk_bulk_disable_unprepare(ARRAY_SIZE(iep->clocks), iep->clocks);
+		return ret;
+	}
+	spin_lock_irqsave(&iep->irq_lock, flags);
+	iep->irq_active = true;
+	spin_unlock_irqrestore(&iep->irq_lock, flags);
+	return 0;
+}
+
+static int iep_runtime_suspend(struct device *dev)
+{
+	struct iep_dev *iep = dev_get_drvdata(dev);
+
+	unsigned long flags;
+
+	spin_lock_irqsave(&iep->irq_lock, flags);
+	if (iep->irq_active)
+		writel(IEP_IRQ_CLEAR, iep->regs + IEP_INT);
+	iep->irq_active = false;
+	spin_unlock_irqrestore(&iep->irq_lock, flags);
+	clk_bulk_disable_unprepare(ARRAY_SIZE(iep->clocks), iep->clocks);
+	return 0;
+}
+
+static int __maybe_unused iep_suspend(struct device *dev)
+{
+	struct iep_dev *iep = dev_get_drvdata(dev);
+
+	int ret;
+
+	/* m2m_suspend waits on curr_ctx after dropping its scheduler lock.
+	 * Serialize with release so that context cannot be freed underneath it.
+	 */
+	mutex_lock(&iep->lock);
+	v4l2_m2m_suspend(iep->m2m);
+	ret = pm_runtime_force_suspend(dev);
+	if (ret)
+		v4l2_m2m_resume(iep->m2m);
+	mutex_unlock(&iep->lock);
+	return ret;
+}
+
+static int __maybe_unused iep_resume(struct device *dev)
+{
+	struct iep_dev *iep = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&iep->lock);
+	ret = pm_runtime_force_resume(dev);
+	if (!ret)
+		v4l2_m2m_resume(iep->m2m);
+	mutex_unlock(&iep->lock);
+	return ret;
+}
+
+static const struct dev_pm_ops iep_pm_ops = {
+	SET_RUNTIME_PM_OPS(iep_runtime_suspend, iep_runtime_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(iep_suspend, iep_resume)
+};
