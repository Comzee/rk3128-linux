+/* V4L2's scalar U8 default cannot describe an identity curve or Y/U/V
+ * defaults. Use the same initializer for current and WHICH_DEF_VAL reads.
+ */
+static void iep_table_init(const struct v4l2_ctrl *ctrl, u32 from,
+			   union v4l2_ctrl_ptr ptr)
+{
+	u32 i;
+
+	for (i = from; i < ctrl->elems; i++)
+		ptr.p_u8[i] = ctrl->id == V4L2_CID_RK_IEP_CG_TABLE ?
+			i % 256 : i ? 128 : 16;
+}
+
+static void iep_table_min(const struct v4l2_ctrl *ctrl, u32 index,
+			  union v4l2_ctrl_ptr ptr)
+{
+	ptr.p_u8[index] = ctrl->minimum;
+}
+
+static void iep_table_max(const struct v4l2_ctrl *ctrl, u32 index,
+			  union v4l2_ctrl_ptr ptr)
+{
+	ptr.p_u8[index] = ctrl->maximum;
+}
