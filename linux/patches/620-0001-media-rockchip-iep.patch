+	.equal = v4l2_ctrl_type_op_equal,
+	.init = iep_table_init,
+	.minimum = iep_table_min,
+	.maximum = iep_table_max,
+	.log = v4l2_ctrl_type_op_log,
+	.validate = v4l2_ctrl_type_op_validate,
+};
