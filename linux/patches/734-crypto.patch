diff --git a/Documentation/devicetree/bindings/crypto/rockchip,rk3128-crypto.yaml b/Documentation/devicetree/bindings/crypto/rockchip,rk3128-crypto.yaml
--- /dev/null
+++ b/Documentation/devicetree/bindings/crypto/rockchip,rk3128-crypto.yaml
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/crypto/rockchip,rk3128-crypto.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip RK3128 crypto v1
+
+maintainers:
+  - RK3128 reference <reference@example.invalid>
+
+description: |
+  RK3128 crypto v1 has AES, DES/3DES, MD5/SHA1/SHA256 and an
+  oscillator-backed TRNG. PKA is vendor-unsupported on RK3128. Its two-clock integration differs from RK3288.
+  The crypto and random interfaces share a single register window/reset.
+
+properties:
+  compatible:
+    const: rockchip,rk3128-crypto
+  reg:
+    maxItems: 1
+  interrupts:
+    maxItems: 1
+  clocks:
+    maxItems: 2
+  clock-names:
+    items:
+      - const: sclk
+      - const: hclk
+  resets:
+    maxItems: 1
+  memory-region:
+    description: Private low-DDR CMA pool for the one-shot DMA diagnostic only
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/rk3128-cru.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    crypto@100fc000 {
+        compatible = "rockchip,rk3128-crypto";
+        reg = <0x100fc000 0x4000>;
+        interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&cru SCLK_CRYPTO>, <&cru HCLK_CRYPTO>;
+        clock-names = "sclk", "hclk";
+        resets = <&cru SRST_CRYPTO>;
+    };
