+static int rga1_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct rga1_ctx *ctx =
+		container_of(ctrl->handler, struct rga1_ctx, ctrls);
+
+	/* Freeze the matrix and prescale allocation until both queues stop. */
+	if (ctx->fh.m2m_ctx &&
+	    (vb2_is_streaming(v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx)) ||
+	     vb2_is_streaming(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx))))
+		return -EBUSY;
+	switch (ctrl->id) {
+	case V4L2_CID_RGA1_ROTATE_AA:
+		ctx->rotate_aa = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_GRADIENT_WRAP:
+		ctx->gradient_wrap = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_ALPHA_CALC:
+		ctx->alpha_calc = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_MIX_DEST:
+		ctx->mix_dest = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_ROP_MODE:
+		ctx->rop_mode = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_PATTERN_ORIGIN:
+		ctx->pattern_origin = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_ZERO_KEY:
+		ctx->zero_key = ctrl->val;
+		break;
+
+	case V4L2_CID_RGA1_FG_COLOR:
+		ctx->foreground = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_PALETTE_ALPHA:
+		ctx->palette_alpha = ctrl->val;
+		break;
+
+	case V4L2_CID_RGA1_CSC_ALIAS:
+		ctx->csc_alias = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_LUT:
+		memcpy(ctx->lut, ctrl->p_new.p_u8, sizeof(ctx->lut));
+		break;
+	case V4L2_CID_RGA1_PATTERN:
+		memcpy(ctx->pattern, ctrl->p_new.p_u8, sizeof(ctx->pattern));
+		break;
+	case V4L2_CID_RGA1_GRADIENT:
+		memcpy(ctx->gradient, ctrl->p_new.p_s32, sizeof(ctx->gradient));
+		break;
+
+	case V4L2_CID_RGA1_PATTERN_SIZE:
+		ctx->pattern_size = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_OPERATION:
+		ctx->operation = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_SAMPLING:
+		ctx->sampling = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_DITHER:
+		ctx->dither = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_ALPHA_MODE:
+		ctx->alpha_mode = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_PORTER_DUFF:
+		ctx->pd = ctrl->val;
+		break;
+	case V4L2_CID_ALPHA_COMPONENT:
+		ctx->global_alpha = ctrl->val;
+		break;
+	case V4L2_CID_BG_COLOR:
+		ctx->color = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_COLORKEY:
+		ctx->key = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_KEY_MIN:
+		ctx->key_min = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_KEY_MAX:
+		ctx->key_max = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_ROP:
+		ctx->rop = ctrl->val;
+		break;
+	case V4L2_CID_RGA1_FADING:
+		ctx->fading = ctrl->val;
+		break;
+
+	case V4L2_CID_ROTATE:
+		ctx->angle = ctrl->val;
+		break;
+	case V4L2_CID_HFLIP:
+		ctx->hflip = ctrl->val;
+		break;
+	case V4L2_CID_VFLIP:
+		ctx->vflip = ctrl->val;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
