diff --git a/drivers/media/platform/rockchip/rga/rga1-hw.h b/drivers/media/platform/rockchip/rga/rga1-hw.h
new file mode 100644
index 0000000..21e138c 100644
--- /dev/null
+++ b/drivers/media/platform/rockchip/rga/rga1-hw.h
@@ -0,0 +1,434 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* RK3128 RGA1-plus. Register definitions from Rockchip's RGA1 driver/TRM. */
+#ifndef ROCKCHIP_RGA1_HW_H
+#define ROCKCHIP_RGA1_HW_H
+
+#ifdef RGA1_HOST_TEST
+#include <stdint.h>
+#include <string.h>
+typedef uint32_t u32;
+typedef int32_t s32;
+typedef int64_t s64;
+#else
+#include <linux/types.h>
+#include <linux/string.h>
+#endif
+
+#define RGA1_SYS_CTRL 0x000
+#define RGA1_CMD_CTRL 0x004
+#define RGA1_CMD_ADDR 0x008
+#define RGA1_STATUS 0x00c
+#define RGA1_INT 0x010
+#define RGA1_MMU_CTRL 0x168
+#define RGA1_COMMAND_BYTES 128
+#define RGA1_MAX_SRC 8192
+#define RGA1_MAX_DST 2048
+
+/* Command word indices, register offsets 0x100..0x17c. */
+enum {
+	R1_MODE,
+	R1_SRC_Y,
+	R1_SRC_UV,
+	R1_SRC_V,
+	R1_SRC_VIR,
+	R1_SRC_ACT,
+	R1_X_PARA,
+	R1_Y_PARA,
+	R1_TILE_X,
+	R1_TILE_Y,
+	R1_TILE_H,
+	R1_TILE_V,
+	R1_TILE_OFF_X,
+	R1_TILE_OFF_Y,
+	R1_BG,
+	R1_FG,
+	R1_KEY_MIN,
+	R1_KEY_MAX,
+	R1_LINE,
+	R1_DST,
+	R1_DST_VIR,
+	R1_DST_ACT,
+	R1_ALPHA,
+	R1_PAT,
+	R1_PRE_UV,
+	R1_PRE_V,
+	R1_FADING,
+	R1_MMU_TBL,
+	R1_YUV_OUT,
+	R1_DST_UV,
+};
+
+/* Values are the MODE_CTRL source fields. Names describe little-endian
+ * memory component order (unlike DRM's word-order names).
+ */
+enum rga1_format {
+	RGA1_RGBA32 = 0,
+	RGA1_BGRA32 = 0x100,
+	RGA1_ARGB32 = 0x200,
+	RGA1_ABGR32 = 0x300,
+	RGA1_RGB24 = 8,
+	RGA1_BGR24 = 0x108,
+	RGA1_RGB565 = 0x10,
+	RGA1_A5R5G5B1 = 0x220,
+	RGA1_A5B5G5R1 = 0x320,
+	RGA1_RGBA5551 = 0x20,
+	RGA1_BGRA5551 = 0x120,
+	RGA1_ARGB4444 = 0x230,
+	RGA1_ABGR4444 = 0x330,
+	RGA1_RGBA4444 = 0x30,
+	RGA1_BGRA4444 = 0x130,
+	RGA1_PAL1 = 0x80,
+	RGA1_PAL2 = 0x90,
+	RGA1_PAL4 = 0xa0,
+	RGA1_PAL8 = 0xb0,
+	RGA1_NV16 = 0x40,
+	RGA1_NV61 = 0x440,
+	RGA1_YUV422P = 0x50,
+	RGA1_YVU422P = 0x450,
+	RGA1_NV12 = 0x60,
+	RGA1_NV21 = 0x460,
+	RGA1_YUV420P = 0x70,
+	RGA1_YVU420P = 0x470,
+};
+
+struct rga1_image {
+	u32 y, uv, v;
+	u32 width, height, stride, vir_height;
+	enum rga1_format format;
+};
+
+static inline int rga1_palette(enum rga1_format f)
+{
+	return !!(f & 0x80);
+}
+static inline int rga1_yuv(enum rga1_format f)
+{
+	return (f & 0xc0) == 0x40;
+}
+static inline int rga1_planar(enum rga1_format f)
+{
+	return rga1_yuv(f) && (f & 0x10);
+}
+static inline int rga1_420(enum rga1_format f)
+{
+	return rga1_yuv(f) && (f & 0x20);
+}
+static inline u32 rga1_bpp(enum rga1_format f)
+{
+	if (rga1_yuv(f) || rga1_palette(f))
+		return 1;
+	if (f & 0x30)
+		return 2;
+	return f & 8 ? 3 : 4;
+}
+
+static inline u32 rga1_line_bytes(u32 width, enum rga1_format f)
+{
+	if (rga1_palette(f))
+		return (width + (8U >> ((f >> 4) & 3)) - 1) >>
+		       (3 - ((f >> 4) & 3));
+	return width * rga1_bpp(f);
+}
+
+static inline u32 rga1_fmt_bits(enum rga1_format f, int dst)
+{
+	if (rga1_palette(f))
+		return f; /* RGA1-plus palette selectors 8..11 (TRM), not RGA1 */
+	if (!dst && rga1_planar(f))
+		f &= ~0x400U;
+	return dst ? ((f & 0x30) << 19) | ((f & 8) << 22) |
+			       ((f & 0x100) << 18) | ((f & 0x200) << 18) :
+		     f;
+}
+
+static inline void rga1_src(u32 *cmd, const struct rga1_image *src)
+{
+	cmd[R1_SRC_Y] = src->y;
+	cmd[R1_SRC_UV] = rga1_yuv(src->format) ? src->uv : 0;
+	cmd[R1_SRC_V] = rga1_planar(src->format) ? src->v : 0;
+	if (rga1_planar(src->format) && (src->format & 0x400)) {
+		cmd[R1_SRC_UV] = src->v;
+		cmd[R1_SRC_V] = src->uv;
+	}
+	cmd[R1_SRC_VIR] =
+		(src->stride / 4) |
+		((src->vir_height ? src->vir_height : src->height) << 16);
+	cmd[R1_SRC_ACT] = (src->width - 1) | ((src->height - 1) << 16);
+}
+
+/* A signed pair must be packed with unsigned shifts, including reflections. */
+static inline u32 rga1_pair(s64 low, s64 high)
+{
+	return ((u32)low & 0xffff) | ((u32)high << 16);
+}
+
+/* 16.16 sine, integer degrees. No floating point in kernel or job paths. */
+static inline s32 rga1_sin(u32 angle)
+{
+	static const u32 table[91] = {
+		0,     1144,  2287,  3430,  4572,  5712,  6850,	 7987,	9121,
+		10252, 11380, 12505, 13626, 14742, 15855, 16962, 18064, 19161,
+		20252, 21336, 22415, 23486, 24550, 25607, 26656, 27697, 28729,
+		29753, 30767, 31772, 32768, 33754, 34729, 35693, 36647, 37590,
+		38521, 39441, 40348, 41243, 42126, 42995, 43852, 44695, 45525,
+		46341, 47143, 47930, 48703, 49461, 50203, 50931, 51643, 52339,
+		53020, 53684, 54332, 54963, 55578, 56175, 56756, 57319, 57865,
+		58393, 58903, 59396, 59870, 60326, 60764, 61183, 61584, 61966,
+		62328, 62672, 62997, 63303, 63589, 63856, 64104, 64332, 64540,
+		64729, 64898, 65048, 65177, 65287, 65376, 65446, 65496, 65526,
+		65536,
+
+	};
+	u32 a = angle % 180;
+	s32 value = table[a > 90 ? 180 - a : a];
+
+	return angle % 360 >= 180 ? -value : value;
+}
+
+/*
+ * Inverse affine matrix, 32.32, with the vendor's endpoint-aligned 16.16
+ * ratio. Generalising its quarter-turn and mirror cases also permits their
+ * combinations without a second blit. No signed left shifts or FP in kernel.
+ */
+struct rga1_affine {
+	s64 a, b, c, d, tx, ty;
+};
+static inline struct rga1_affine rga1_matrix(const struct rga1_image *src,
+					     const struct rga1_image *dst, u32 angle,
+					     int hflip, int vflip)
+{
+	s64 a, b = 0, c = 0, d, tx, ty;
+	u32 uw = (angle == 90 || angle == 270) ? dst->height : dst->width;
+	u32 uh = (angle == 90 || angle == 270) ? dst->width : dst->height;
+	s64 xs = (s64)(((src->width - 1) * 65536U) / (uw - 1)) * 65536;
+	s64 ys = (s64)(((src->height - 1) * 65536U) / (uh - 1)) * 65536;
+	a = xs;
+	d = ys;
+	if (angle == 90) {
+		a = d = 0;
+		b = xs;
+		c = -ys;
+	}
+	if (angle == 180) {
+		a = -xs;
+		d = -ys;
+	}
+	if (angle == 270) {
+		a = d = 0;
+		b = -xs;
+		c = ys;
+	}
+	if (angle % 90) {
+		s32 sn = rga1_sin(angle), cs = rga1_sin(angle + 90);
+
+		a = xs * cs / 65536;
+		b = xs * sn / 65536;
+		c = -ys * sn / 65536;
+		d = ys * cs / 65536;
+	}
+	if (hflip) {
+		a = -a;
+		c = -c;
+	}
+	if (vflip) {
+		b = -b;
+		d = -d;
+	}
+	tx = (a < 0 ? -a * (dst->width - 1) : 0) +
+	     (b < 0 ? -b * (dst->height - 1) : 0);
+	ty = (c < 0 ? -c * (dst->width - 1) : 0) +
+	     (d < 0 ? -d * (dst->height - 1) : 0);
+	if (angle % 90) {
+		tx = (s64)(src->width - 1) * 2147483648LL -
+		     (a * (dst->width - 1) + b * (dst->height - 1)) / 2;
+		ty = (s64)(src->height - 1) * 2147483648LL -
+		     (c * (dst->width - 1) + d * (dst->height - 1)) / 2;
+	}
+	return (struct rga1_affine){a, b, c, d, tx, ty};
+}
+
+/* A full tile at endpoint ratio <2 spans fewer than 23 source samples per
+ * axis (7*2*sqrt(2) plus the filter halo). Thirty-two samples also cover its
+ * clipped seed and bus look-behind. These are DMA bounds, not pixel clipping.
+ */
+static inline void rga1_source_span(const struct rga1_image *src,
+				    const struct rga1_image *dst, u32 angle, int hflip,
+				    int vflip, s64 *lo, s64 *hi)
+{
+	struct rga1_affine m = rga1_matrix(src, dst, angle, hflip, vflip);
+	s64 w = ((dst->width + 7) & ~7U) - 1;
+	s64 h = ((dst->height + 7) & ~7U) - 1;
+	s64 x0 = m.tx + (m.a < 0 ? m.a * w : 0) + (m.b < 0 ? m.b * h : 0);
+	s64 y0 = m.ty + (m.c < 0 ? m.c * w : 0) + (m.d < 0 ? m.d * h : 0);
+	s64 x1 = m.tx + (m.a > 0 ? m.a * w : 0) + (m.b > 0 ? m.b * h : 0);
+	s64 y1 = m.ty + (m.c > 0 ? m.c * w : 0) + (m.d > 0 ? m.d * h : 0);
+
+	*lo = ((y0 >> 32) - 32) * src->stride +
+	      ((x0 >> 32) - 32) * rga1_bpp(src->format) - 64;
+	*hi = ((y1 >> 32) + 33) * src->stride +
+	      ((x1 >> 32) + 33) * rga1_bpp(src->format) + 64;
+}
+
+static inline void rga1_blit_filter_halo(u32 *cmd, const struct rga1_image *src,
+				       const struct rga1_image *dst, u32 angle, int hflip,
+				       int vflip, u32 csc, u32 sampling, int halo)
+{
+	struct rga1_affine m = rga1_matrix(src, dst, angle, hflip, vflip);
+	s64 a = m.a, b = m.b, c = m.c, d = m.d, tx = m.tx, ty = m.ty;
+	s64 xmin, ymin, xmax, ymax;
+	s32 xp, yp;
+
+	xmin = tx + (a < 0 ? 7 * a : 0) + (b < 0 ? 7 * b : 0);
+	ymin = ty + (c < 0 ? 7 * c : 0) + (d < 0 ? 7 * d : 0);
+	xmax = tx + (a > 0 ? 7 * a : 0) + (b > 0 ? 7 * b : 0);
+	ymax = ty + (c > 0 ? 7 * c : 0) + (d > 0 ? 7 * d : 0);
+
+	if (sampling == 2 || halo) {
+		/* Bicubic needs the vendor's one-pixel halo on every side of a tile. */
+		xmin -= 4294967296LL;
+		ymin -= 4294967296LL;
+		xmax += 4294967296LL;
+		ymax += 4294967296LL;
+	}
+
+	memset(cmd, 0, RGA1_COMMAND_BYTES);
+	cmd[R1_MODE] = rga1_fmt_bits(src->format, 0) |
+		       rga1_fmt_bits(dst->format, 1) | (csc << 11) |
+		       (1U << 18) | (sampling << 20); /* tile scan */
+	rga1_src(cmd, src);
+	cmd[R1_X_PARA] = rga1_pair(a >> 18, b >> 18);
+	cmd[R1_Y_PARA] = rga1_pair(c >> 18, d >> 18);
+	cmd[R1_TILE_X] = rga1_pair(xmin >> 29, (xmax - xmin) >> 21);
+	cmd[R1_TILE_Y] = rga1_pair(ymin >> 29, (ymax - ymin) >> 21);
+	cmd[R1_TILE_H] = rga1_pair((8 * a) >> 22, (8 * c) >> 22);
+	cmd[R1_TILE_V] = rga1_pair((8 * b) >> 22, (8 * d) >> 22);
+	cmd[R1_TILE_OFF_X] = (tx - xmin) >> 18;
+	cmd[R1_TILE_OFF_Y] = (ty - ymin) >> 18;
+	/* The seed is relative to the first tile, even when that tile is fully
+	 * clipped. Clamping a fully clipped seed shifts every later source tile.
+	 * Prepare sizes the owned MMU guards from the full affine source span. */
+	xp = (s32)(short)(cmd[R1_TILE_X] & 0xffff) >> 3;
+	yp = (s32)(short)(cmd[R1_TILE_Y] & 0xffff) >> 3;
+	{
+		/* Visibility uses the encoded .3 origin and .11 extent, including
+		 * the fetch halo. Ideal/body-only bounds disagree at clipped tiles
+		 * whose last cached sample lies between -1 and zero. */
+		s32 xe = ((s32)(short)(cmd[R1_TILE_X] & 0xffff) * 256 +
+			  (s32)(cmd[R1_TILE_X] >> 16)) >> 11;
+		s32 ye = ((s32)(short)(cmd[R1_TILE_Y] & 0xffff) * 256 +
+			  (s32)(cmd[R1_TILE_Y] >> 16)) >> 11;
+
+		if (!(xe < -1 || xp > (s32)src->width - 1 ||
+		      ye < -1 || yp > (s32)src->height - 1)) {
+			if (xp < 0) xp = 0;
+			if (yp < 0) yp = 0;
+			if (xp >= (s32)src->width) xp = src->width - 1;
+			if (yp >= (s32)src->height) yp = src->height - 1;
+		}
+	}
+
+	cmd[R1_SRC_Y] += (s64)yp * src->stride + (s64)xp * rga1_bpp(src->format);
+	if (rga1_yuv(src->format)) {
+		u32 cy = rga1_420(src->format) ? yp / 2 : yp;
+		u32 cs = rga1_planar(src->format) ? src->stride / 2 :
+						    src->stride;
+		u32 cx = rga1_planar(src->format) ? (u32)(xp / 2) : (u32)xp & ~1U;
+
+		cmd[R1_SRC_UV] += cy * cs + cx;
+		if (rga1_planar(src->format))
+			cmd[R1_SRC_V] += cy * cs + cx;
+	}
+
+	cmd[R1_DST] = dst->y;
+	cmd[R1_DST_VIR] = dst->stride / 4;
+	cmd[R1_DST_ACT] = (dst->width - 1) | ((dst->height - 1) << 16) |
+			  (1U << 28) | (1U << 29);
+	/* No alpha/ROP/dither operation is requested by this interface. */
+}
+
+static inline void rga1_blit_filter(u32 *cmd, const struct rga1_image *src,
+				    const struct rga1_image *dst, u32 angle, int hflip,
+				    int vflip, u32 csc, u32 sampling)
+{
+	rga1_blit_filter_halo(cmd, src, dst, angle, hflip, vflip, csc, sampling, 0);
+}
+
+static inline void rga1_blit(u32 *cmd, const struct rga1_image *src,
+			     const struct rga1_image *dst, u32 angle, int hflip,
+			     int vflip, u32 csc)
+{
+	rga1_blit_filter(cmd, src, dst, angle, hflip, vflip, csc, 1);
+}
+
+/* Separate average-filter pass, reducing each axis by 1, 2, 4 or 8. */
+static inline void rga1_prescale(u32 *cmd, const struct rga1_image *src,
+				 const struct rga1_image *dst, u32 hx, u32 vy)
+{
+	memset(cmd, 0, RGA1_COMMAND_BYTES);
+	cmd[R1_MODE] = 5 | rga1_fmt_bits(src->format, 0) |
+		       rga1_fmt_bits(dst->format, 1);
+	rga1_src(cmd, src);
+	cmd[R1_DST] = dst->y;
+	if (rga1_yuv(dst->format)) {
+		cmd[R1_PRE_UV] = dst->uv;
+		cmd[R1_PRE_V] = rga1_planar(dst->format) ? dst->v : 0;
+		if (rga1_planar(dst->format) && (dst->format & 0x400)) {
+			cmd[R1_PRE_UV] = dst->v;
+			cmd[R1_PRE_V] = dst->uv;
+		}
+		cmd[R1_DST_UV] = dst->uv;
+		/* Keep the vendor's output subsampling selection with CSC off. */
+		cmd[R1_YUV_OUT] = (rga1_420(dst->format) ? 2 : 0) |
+				  (dst->format & 0x400 ? 8 : 0);
+	}
+	cmd[R1_DST_VIR] = dst->stride / 4;
+	cmd[R1_DST_ACT] = (dst->width - 1) | ((dst->height - 1) << 16);
+	cmd[R1_ALPHA] = (hx << 20) | (vy << 22);
+}
+/* Shipped Rockchip RGA1 ROP3 decode table, GPL-2.0, Zhang Shengqin. */
+static const u32 rga1_rop3[256] = {
+	0x000007,  0x000451, 0x006051, 0x800051,  0x007041,  0x800041,
+	0x804830,  0x0004f0, 0x800765, 0x0004b0,  0x000065,  0x0004f4,
+	0x000075,  0x0004e6, 0x804850, 0x800005,  0x006850,  0x800050,
+	0x805028,  0x000568, 0x804031, 0x000471,  0x2b6071,  0x18037aa,
+	0x8007aa,  0x036071, 0x002c6a, 0x803631,  0x002d68,  0x802721,
+	0x8002d0,  0x0006d0, 0x80066e, 0x000528,  0x000066,  0x00056c,
+	0x18007aa, 0x02e06a, 0x003471, 0x834031,  0x800631,  0x02b471,
+	0x006071,  0x8037aa, 0x0036d0, 0x8002d4,  0x002d28,  0x0006d4,
+	0x00006e,  0x000565, 0x003451, 0x800006,  0x0034f0,  0x834830,
+	0x800348,  0x000748, 0x002f48, 0x80034c,  0x0034b0,  0x00074c,
+	0x000031,  0x834850, 0x0034e6, 0x800071,  0x8006f4,  0x000431,
