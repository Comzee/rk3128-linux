+static u32 rga1_pre_shift(u32 src, u32 dst)
+{
+	u32 shift = 0;
+
+	/* 2.14 signed ratios must stay strictly below 2, including endpoints. */
+	while (shift < 3 && ((src >> shift) >= 2 * dst - 1))
+		shift++;
+	return shift;
+}
+
+static int rga1_prepare_streaming(struct vb2_queue *q)
+{
+	struct rga1_ctx *ctx = vb2_get_drv_priv(q);
+	const struct v4l2_pix_format_mplane *src = &ctx->pix[0];
+	const struct v4l2_pix_format_mplane *dst = &ctx->pix[1];
+	const struct rga1_fmt *fmt = rga1_format(src->pixelformat);
+	u32 w = (ctx->angle == 90 || ctx->angle == 270) ? ctx->rect[1].height :
+							  ctx->rect[1].width;
+	u32 h = (ctx->angle == 90 || ctx->angle == 270) ? ctx->rect[1].width :
+							  ctx->rect[1].height;
+	struct rga1_image *mid = &ctx->intermediate;
+
+	ctx->palette_expand =
+		rga1_palette(fmt->hw) && !ctx->operation &&
+		(ctx->angle || ctx->hflip || ctx->vflip || ctx->alpha_mode || ctx->pd ||
+		 ctx->rop || ctx->fading || ctx->key || ctx->dither ||
+		 ctx->rect[0].width != w || ctx->rect[0].height != h);
+
+	ctx->mask_size = 0;
+	ctx->guard_lead = ctx->guard_gap = 16;
+	if ((ctx->gradient_wrap && ctx->operation != 1) ||
+	    (ctx->alpha_calc && !ctx->alpha_mode) ||
+	    (ctx->mix_dest &&
+	     (!ctx->alpha_mode || ctx->pd || !rga1_has_alpha(dst->pixelformat))))
+		return -EINVAL;
+
+	if (ctx->operation == 6) {
+		unsigned int i;
+
+		if (fmt->hw != rga1_format(dst->pixelformat)->hw || ctx->angle ||
+		    ctx->hflip || ctx->vflip || ctx->key || ctx->alpha_mode || ctx->pd ||
+		    ctx->rop || ctx->fading || ctx->dither || fmt->hw == RGA1_ARGB4444 ||
+		    fmt->hw == RGA1_ABGR4444 || rga1_palette(fmt->hw) || ctx->zero_key)
+			return -EINVAL;
+		for (i = 0; i < 2; i++)
+			if (ctx->rect[i].left || ctx->rect[i].top ||
+			    ctx->rect[i].width != ctx->pix[i].width ||
+			    ctx->rect[i].height != ctx->pix[i].height)
+				return -EINVAL;
+		ctx->hx = rga1_pre_shift(src->width, dst->width);
+		ctx->vy = rga1_pre_shift(src->height, dst->height);
+		if (src->width != (dst->width << ctx->hx) ||
+		    src->height != (dst->height << ctx->vy) ||
+		    src->ycbcr_enc != dst->ycbcr_enc ||
+		    rga1_quant(src) != rga1_quant(dst))
+			return -EINVAL;
+		return 0;
+	}
+	if (rga1_planar(rga1_format(dst->pixelformat)->hw))
+		return -EOPNOTSUPP;
+
+	/* A fill can compose a single pixel; switching it back to a blit must
+	 * revalidate before any endpoint-aligned ratio has a zero denominator. */
+	if (!ctx->operation && (w < 2 || h < 2))
+		return -EINVAL;
+
+	if (ctx->rotate_aa && ctx->angle % 90 && !rga1_palette(fmt->hw) &&
+	    src->pixelformat != V4L2_PIX_FMT_RGB24 &&
+	    src->pixelformat != V4L2_PIX_FMT_BGR24 &&
+	    src->pixelformat != V4L2_PIX_FMT_RGB565)
+		return -EOPNOTSUPP;
+	if (ctx->angle % 90 &&
+	    (fmt->yuv || rga1_format(dst->pixelformat)->yuv || ctx->operation ||
+	     ctx->alpha_mode || ctx->rop || ctx->key || ctx->fading || ctx->zero_key ||
+	     rga1_has_alpha(dst->pixelformat)))
+		return -EOPNOTSUPP;
+	if ((ctx->csc_alias &&
+	     (!fmt->yuv || src->ycbcr_enc != V4L2_YCBCR_ENC_601 ||
+	      rga1_quant(src) != V4L2_QUANTIZATION_LIM_RANGE)))
+		return -EINVAL;
+	if (rga1_format(dst->pixelformat)->yuv &&
+	    (ctx->operation || ctx->alpha_mode || ctx->rop || ctx->key ||
+	     ctx->fading || rga1_palette(fmt->hw) ||
+	     (dst->ycbcr_enc == V4L2_YCBCR_ENC_709 &&
+	      rga1_quant(dst) == V4L2_QUANTIZATION_FULL_RANGE)))
+		return -EINVAL;
+
+	if (ctx->operation >= 2 && ctx->operation <= 4)
+		return -EOPNOTSUPP;
+
+	/* Alpha-bearing 8888 targets use the separately verified DST_VIR fetch. */
+	if (ctx->alpha_mode && dst->pixelformat != V4L2_PIX_FMT_RGB24 &&
+	    dst->pixelformat != V4L2_PIX_FMT_BGR24 && !rga1_has_alpha(dst->pixelformat))
+		return -EOPNOTSUPP;
+	if (ctx->zero_key && ((src->pixelformat != V4L2_PIX_FMT_RGBA32 &&
+			       src->pixelformat != V4L2_PIX_FMT_ABGR32 &&
+			       src->pixelformat != V4L2_PIX_FMT_ARGB32 &&
+			       src->pixelformat != V4L2_PIX_FMT_BGRA32) ||
+			      (dst->pixelformat != V4L2_PIX_FMT_RGB24 &&
+			       dst->pixelformat != V4L2_PIX_FMT_BGR24 &&
+			       dst->pixelformat != V4L2_PIX_FMT_RGB565) ||
+			      ctx->operation || ctx->alpha_mode || ctx->rop ||
+			      ctx->key || ctx->fading))
+		return -EINVAL;
+	if ((ctx->rop_mode == 0 && ctx->rop > 16) ||
+	    (ctx->rop_mode == 1 && ctx->rop > 256))
+		return -EINVAL;
+	if (ctx->rop && ctx->rop_mode == 2) {
+		size_t size = ALIGN(DIV_ROUND_UP(src->width, 8), 4) * src->height;
+
+		if (!ctx->mask_buf || ctx->mask_buf->size < size || fmt->yuv ||
+		    rga1_palette(fmt->hw) || src->pixelformat != dst->pixelformat ||
+		    src->width != dst->width || src->height != dst->height ||
+		    ctx->rect[0].width != src->width ||
+		    ctx->rect[0].height != src->height ||
+		    ctx->rect[1].width != dst->width ||
+		    ctx->rect[1].height != dst->height || ctx->angle || ctx->hflip ||
+		    ctx->vflip || ctx->key || ctx->fading || ctx->dither ||
+		    rga1_sg_check(ctx->mask_sgt, size))
+			return -EINVAL;
+		ctx->mask_size = size;
+	}
+	if (rga1_format(dst->pixelformat)->yuv &&
+	    dst->ycbcr_enc == V4L2_YCBCR_ENC_709 &&
+	    (!fmt->yuv || src->ycbcr_enc != dst->ycbcr_enc ||
+	     rga1_quant(src) != rga1_quant(dst)))
+		return -EOPNOTSUPP;
+
+	/* Operations share registers: reject combinations before any allocation/DMA.
+	 * Only blits may scale/rotate. Fill and filters use the compose rectangle.
+	 */
+	if ((ctx->operation &&
+	     (ctx->angle || ctx->hflip || ctx->vflip || ctx->key ||
+	      (ctx->alpha_mode && ctx->operation != 1) ||
+	      (ctx->rop && !(ctx->operation == 1 && ctx->rop_mode == 0)) || ctx->fading ||
+	      (ctx->dither && ctx->operation != 1))) ||
+	    ((ctx->operation == 2 || ctx->operation == 3) &&
+	     (src->pixelformat != dst->pixelformat || fmt->yuv ||
+	      ctx->rect[0].width != w || ctx->rect[0].height != h)) ||
+	    (ctx->rop && ctx->alpha_mode) || (ctx->pd && !ctx->alpha_mode) ||
+	    (ctx->key && (ctx->key_min > ctx->key_max)) ||
+	    (ctx->dither && dst->pixelformat != V4L2_PIX_FMT_RGB565))
+		return -EINVAL;
+	if (ctx->operation == 1 && ctx->rop) {
+		unsigned int i;
+
+		if (ctx->gradient_wrap || ctx->dither)
+			return -EINVAL;
+		for (i = 0; i < ARRAY_SIZE(ctx->gradient); i++)
+			if (ctx->gradient[i])
+				return -EINVAL;
+	}
+
+	if (ctx->operation == 5 || ctx->rop) {
+		u32 pw = ctx->pattern_size & 0xffff,
+		    ph = ctx->pattern_size >> 16;
+
+		if (!pw || !ph || pw > 255 || ph > 255 || pw * ph > 255 ||
+		    (ctx->pattern_origin & 0xffff) >= pw ||
+		    (ctx->pattern_origin >> 16) >= ph)
+			return -EINVAL;
+	}
+	if (rga1_palette(fmt->hw) &&
+	    (ctx->operation ||
+	     (!ctx->palette_expand &&
+	      (ctx->angle || ctx->hflip || ctx->vflip || ctx->alpha_mode || ctx->pd ||
+	       ctx->rop || ctx->fading || ctx->key || ctx->dither ||
+	       ctx->rect[0].width != w || ctx->rect[0].height != h))))
+		return -EINVAL;
+	if (ctx->operation == 1 || ctx->operation == 5 ||
+	    (rga1_palette(fmt->hw) && !ctx->palette_expand)) {
+		ctx->hx = ctx->vy = 0;
+		return 0;
+	}
+	/* RGB passes through unchanged; the YUV CSC always produces full RGB. */
+	if (!rga1_format(dst->pixelformat)->yuv &&
+	    rga1_quant(dst) !=
+		    (fmt->yuv ? V4L2_QUANTIZATION_FULL_RANGE : rga1_quant(src)))
+		return -EINVAL;
+	ctx->hx = rga1_pre_shift(ctx->rect[0].width, w);
+	ctx->vy = rga1_pre_shift(ctx->rect[0].height, h);
+	/* A prescale destination is itself limited to 2048 on each axis. */
+	if (ctx->hx || ctx->vy || ctx->angle % 90) {
+		while ((ctx->rect[0].width >> ctx->hx) > RGA1_MAX_DST &&
+		       ctx->hx < 3)
+			ctx->hx++;
+		while ((ctx->rect[0].height >> ctx->vy) > RGA1_MAX_DST &&
+		       ctx->vy < 3)
+			ctx->vy++;
+	}
+	mid->width = ctx->rect[0].width >> ctx->hx;
+	mid->height = ctx->rect[0].height >> ctx->vy;
+	/* No silent truncation of odd prescale/chroma rows or source borders. */
+	if ((mid->width << ctx->hx) != ctx->rect[0].width ||
+	    (mid->height << ctx->vy) != ctx->rect[0].height || mid->width < 2 ||
+	    mid->height < 2 ||
+	    ((ctx->hx || ctx->vy) &&
+	     (mid->width > RGA1_MAX_DST || mid->height > RGA1_MAX_DST)) ||
+	    mid->width >= 2 * w - 1 || mid->height >= 2 * h - 1 ||
+	    w > 8 * (mid->width - 1) + 1 || h > 8 * (mid->height - 1) + 1)
+		return -EINVAL;
+	if ((ctx->hx || ctx->vy) && fmt->yuv &&
+	    ((mid->width & 1) || (rga1_420(fmt->hw) && (mid->height & 1))))
+		return -EINVAL;
+	mid->format = ctx->palette_expand ? (ctx->angle % 90 ? RGA1_RGB24 : RGA1_RGBA32)
+					  : fmt->hw;
+	if (mid->format == RGA1_ARGB4444 || mid->format == RGA1_ABGR4444)
+		mid->format = RGA1_RGBA4444;
+	if (mid->format == RGA1_NV21)
+		mid->format = RGA1_NV12;
+	if (mid->format == RGA1_NV61)
+		mid->format = RGA1_NV16;
+	mid->stride = ALIGN(mid->width * rga1_bpp(mid->format), 4);
+	if (ctx->palette_expand) {
+		struct rga1_image *expanded = &ctx->expanded_image;
+
+		expanded->width = ctx->rect[0].width;
+		expanded->height = ctx->rect[0].height;
+		expanded->format = mid->format;
+		expanded->stride = ALIGN(expanded->width * rga1_bpp(expanded->format), 4);
+		if (expanded->width > RGA1_MAX_DST || expanded->height > RGA1_MAX_DST)
+			return -EOPNOTSUPP;
+	}
+
+	if (ctx->angle % 90) {
+		struct rga1_image input = *mid;
+		struct rga1_image output = {.width = w, .height = h};
+		s64 lo, hi;
+
+		/* The worker reads RGB scratch after either expansion or prescale.
+		 * Only a direct source pass keeps the user's packed/padded stride. */
+		if (!(ctx->hx || ctx->vy || ctx->palette_expand)) {
+			input.width = ctx->rect[0].width;
+			input.height = ctx->rect[0].height;
+			input.stride = src->plane_fmt[0].bytesperline;
+		}
+		rga1_source_span(&input, &output, ctx->angle, ctx->hflip, ctx->vflip, &lo,
+				 &hi);
+		ctx->guard_lead += DIV_ROUND_UP((u64)(lo < 0 ? -lo : 0), PAGE_SIZE);
+		ctx->guard_gap += DIV_ROUND_UP((u64)(hi > 0 ? hi : 0), PAGE_SIZE);
+	}
+
+	return 0;
+}
+
+static void rga1_free_mmu(struct rga1_ctx *ctx);
+
+static int rga1_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct rga1_ctx *ctx = vb2_get_drv_priv(q);
+	struct rga1_dev *rga = ctx->rga;
+	struct rga1_image *mid = &ctx->intermediate;
+	int ret;
+
+	if (rga->disconnected || rga->broken) {
+		ret = -EIO;
+		goto fail;
+	}
+	ret = pm_runtime_resume_and_get(rga->dev);
+	if (ret < 0)
+		goto fail;
+	dev_info_once(rga->dev, "silicon version %#x\n",
+		      readl(rga->regs + 0x28));
+	if (ctx->operation != 6 && (ctx->hx || ctx->vy || ctx->palette_expand) &&
+	    !ctx->scratch) {
+		ctx->scratch_size = mid->stride * mid->height;
+		if (rga1_yuv(mid->format))
+			ctx->scratch_size += rga1_420(mid->format) ?
+						     ctx->scratch_size / 2 :
+						     ctx->scratch_size;
+
+		ctx->scratch = dma_alloc_coherent(rga->dev, ctx->scratch_size,
+						  &ctx->scratch_dma,
+						  GFP_KERNEL);
+		if (!ctx->scratch) {
+			pm_runtime_put(rga->dev);
+			ret = -ENOMEM;
+			goto fail;
+		}
+		mid->y = ctx->scratch_dma;
+		mid->uv = mid->y + mid->stride * mid->height;
+		mid->v =
+			mid->uv + (mid->stride / 2) * (rga1_420(mid->format) ?
+							       mid->height / 2 :
+							       mid->height);
+	}
+	if (ctx->palette_expand && (ctx->hx || ctx->vy) && !ctx->expanded) {
+		struct rga1_image *expanded = &ctx->expanded_image;
+
+		ctx->expanded_size = expanded->stride * expanded->height;
+		ctx->expanded = dma_alloc_coherent(rga->dev, ctx->expanded_size,
+						   &ctx->expanded_dma, GFP_KERNEL);
+		if (!ctx->expanded) {
+			pm_runtime_put(rga->dev);
+			ret = -ENOMEM;
+			goto fail;
+		}
+		expanded->y = ctx->expanded_dma;
+	}
+
+	if (!ctx->page_table) {
+		size_t pages = rga1_pages(&ctx->pix[0]) + rga1_pages(&ctx->pix[1]) +
+			       DIV_ROUND_UP(ctx->scratch_size, PAGE_SIZE) +
+			       DIV_ROUND_UP(ctx->expanded_size, PAGE_SIZE) +
+			       DIV_ROUND_UP(ctx->mask_size, PAGE_SIZE) + ctx->guard_lead +
+			       ctx->guard_gap + 32;
+
+		if (pages > 0xffffffffU / PAGE_SIZE) {
+			pm_runtime_put(rga->dev);
+			ret = -E2BIG;
+			goto fail;
+		}
+		ctx->page_table_size = PAGE_ALIGN(pages * sizeof(u32));
+		ctx->page_table =
+			dma_alloc_coherent(rga->dev, ctx->page_table_size,
+					   &ctx->page_table_dma, GFP_KERNEL);
+		ctx->guard = dma_alloc_coherent(rga->dev, PAGE_SIZE,
+						&ctx->guard_dma, GFP_KERNEL);
+		if (!ctx->page_table || !ctx->guard) {
+			if (ctx->page_table)
+				dma_free_coherent(rga->dev,
+						  ctx->page_table_size,
+						  ctx->page_table,
+						  ctx->page_table_dma);
+			if (ctx->guard)
+				dma_free_coherent(rga->dev, PAGE_SIZE,
+						  ctx->guard, ctx->guard_dma);
+			ctx->page_table = NULL;
+			ctx->guard = NULL;
+			pm_runtime_put(rga->dev);
+			ret = -ENOMEM;
+			goto fail;
+		}
+	}
+	memset(ctx->guard, 0, PAGE_SIZE);
+	if (!ctx->aux) {
+		ctx->aux = dma_alloc_coherent(rga->dev, 1024, &ctx->aux_dma,
+					      GFP_KERNEL);
+		if (!ctx->aux) {
+			pm_runtime_put(rga->dev);
+			ret = -ENOMEM;
+			goto fail;
+		}
+	}
+	ctx->sequence[rga1_side(q->type)] = 0;
+	WRITE_ONCE(ctx->aborting, false);
+	return 0;
+fail:
+	if (!vb2_is_streaming(V4L2_TYPE_IS_OUTPUT(q->type) ?
+				      v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx) :
+				      v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx))) {
+		if (ctx->scratch) {
+			dma_free_coherent(rga->dev, ctx->scratch_size,
+					  ctx->scratch, ctx->scratch_dma);
+			ctx->scratch = NULL;
+		}
+		if (ctx->expanded) {
+			dma_free_coherent(ctx->rga->dev, ctx->expanded_size,
+					  ctx->expanded, ctx->expanded_dma);
+			ctx->expanded = NULL;
+		}
+		ctx->expanded_size = 0;
+		ctx->scratch_size = 0;
+		rga1_free_mmu(ctx);
+	}
+	rga1_return_buffers(q, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void rga1_free_mmu(struct rga1_ctx *ctx)
+{
+	if (!ctx->page_table)
+		return;
+	dma_free_coherent(ctx->rga->dev, ctx->page_table_size, ctx->page_table,
+			  ctx->page_table_dma);
+	dma_free_coherent(ctx->rga->dev, PAGE_SIZE, ctx->guard, ctx->guard_dma);
+	ctx->page_table = NULL;
+	ctx->guard = NULL;
+	if (ctx->aux) {
+		dma_free_coherent(ctx->rga->dev, 1024, ctx->aux, ctx->aux_dma);
+		ctx->aux = NULL;
+	}
+}
+
+static void rga1_stop_streaming(struct vb2_queue *q)
+{
+	struct rga1_ctx *ctx = vb2_get_drv_priv(q);
+	struct vb2_queue *other = V4L2_TYPE_IS_OUTPUT(q->type) ?
+					  v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx) :
+					  v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx);
+
+	/* m2m_cancel_job has finished the worker before vb2 calls this. */
+	rga1_return_buffers(q, VB2_BUF_STATE_ERROR);
+	if (!vb2_is_streaming(other) && ctx->scratch) {
+		dma_free_coherent(ctx->rga->dev, ctx->scratch_size,
+				  ctx->scratch, ctx->scratch_dma);
+		ctx->scratch = NULL;
+		if (ctx->expanded) {
+			dma_free_coherent(ctx->rga->dev, ctx->expanded_size,
+					  ctx->expanded, ctx->expanded_dma);
+			ctx->expanded = NULL;
+		}
+		ctx->expanded_size = 0;
+		ctx->scratch_size = 0;
+	}
+	if (!vb2_is_streaming(other))
+		rga1_free_mmu(ctx);
+	pm_runtime_put(ctx->rga->dev);
+}
+
+static const struct vb2_ops rga1_qops = {
+	.queue_setup = rga1_queue_setup,
+	.buf_prepare = rga1_buf_prepare,
+	.buf_queue = rga1_buf_queue,
+	.prepare_streaming = rga1_prepare_streaming,
+	.start_streaming = rga1_start_streaming,
+	.stop_streaming = rga1_stop_streaming,
+};
+
+static int rga1_queues(void *priv, struct vb2_queue *src, struct vb2_queue *dst)
+{
+	struct rga1_ctx *ctx = priv;
+	struct vb2_queue *q[2] = { src, dst };
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < 2; i++) {
+		q[i]->type = i ? V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE :
+				 V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+		q[i]->io_modes = VB2_MMAP | VB2_DMABUF;
+		q[i]->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+		q[i]->drv_priv = ctx;
+		q[i]->ops = &rga1_qops;
+		q[i]->mem_ops = &vb2_dma_sg_memops;
+		q[i]->bidirectional = true;
+		q[i]->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+		q[i]->lock = &ctx->rga->mutex;
+		q[i]->dev = ctx->rga->dev;
+		ret = vb2_queue_init(q[i]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int rga1_reset(struct rga1_dev *rga)
+{
+	u32 val;
+	int ret;
+
+	writel(0, rga->regs + RGA1_INT);
+	writel(1, rga->regs + RGA1_SYS_CTRL);
+	ret = readl_poll_timeout(rga->regs + RGA1_SYS_CTRL, val, !(val & 1), 1,
+				 1000);
+	if (ret) {
+		/* Only RGA's own AXI/AHB resets; never VIO's shared domain. */
+		ret = reset_control_reset(rga->resets);
+		if (!ret)
+			ret = readl_poll_timeout(rga->regs + RGA1_STATUS, val,
+						 !(val & 1), 1, 1000);
+	}
+	writel(RGA1_IRQ_CLEAR, rga->regs + RGA1_INT);
+	synchronize_irq(rga->irq);
+	if (ret) {
+		dev_err(rga->dev,
+			"reset failed: holding reset and gating RGA\n");
+		WRITE_ONCE(rga->broken, true);
+		reset_control_assert(rga->resets);
+		clk_bulk_disable_unprepare(rga->num_clks, rga->clks);
+		rga->clocks_on = false;
+	}
+	return ret;
+}
+
+static irqreturn_t rga1_irq(int irq, void *priv)
+{
+	struct rga1_dev *rga = priv;
+	u32 status = readl(rga->regs + RGA1_INT) & 0xf;
+
+	if (!status)
+		return IRQ_NONE;
+	writel(RGA1_IRQ_ENABLE | (status << 4), rga->regs + RGA1_INT);
+	WRITE_ONCE(rga->irq_status, READ_ONCE(rga->irq_status) | status);
+	if (status & (BIT(0) | BIT(1) | READ_ONCE(rga->expected_irq)))
+		complete(&rga->done);
+	return IRQ_HANDLED;
+}
+
+static int rga1_execute(struct rga1_ctx *ctx, bool mmu)
+{
+	struct rga1_dev *rga = ctx->rga;
+	u32 val;
+	int ret;
+
+	if (READ_ONCE(ctx->aborting) || READ_ONCE(rga->broken))
+		return -ECANCELED;
+	ret = rga1_reset(rga);
+	if (ret)
+		return ret;
+	reinit_completion(&rga->done);
+	WRITE_ONCE(rga->irq_status, 0);
+	WRITE_ONCE(rga->expected_irq, BIT(2));
+	writel(0, rga->regs + RGA1_SYS_CTRL);
+	writel(0, rga->regs + RGA1_MMU_CTRL);
+	/* All commands use a fresh table, 4 KiB pages and all-channel TLB flush.
+	 * The command fetch itself is physical, as in the shipped vendor driver.
+	 */
+	if (mmu) {
+		rga->cmd[R1_MMU_TBL] = ctx->page_table_dma >> 2;
+		rga->cmd[R1_FADING] |= 0x2f;
+	}
+
+	dma_wmb();
+	writel(rga->cmd_dma, rga->regs + RGA1_CMD_ADDR);
+	writel(BIT(2) | BIT(3), rga->regs + RGA1_SYS_CTRL);
+	writel(RGA1_IRQ_ENABLE | RGA1_IRQ_CLEAR, rga->regs + RGA1_INT);
+	writel(1, rga->regs + RGA1_CMD_CTRL);
+
+	if (READ_ONCE(ctx->aborting))
+		complete(&rga->done);
+	if (!wait_for_completion_timeout(&rga->done,
+					 msecs_to_jiffies(RGA1_TIMEOUT_MS))) {
+		dev_err(rga->dev, "job timeout, status=%#x irq=%#x\n",
+			readl(rga->regs + RGA1_STATUS),
+			readl(rga->regs + RGA1_INT));
+		ret = -ETIMEDOUT;
+	} else if (READ_ONCE(ctx->aborting)) {
+		ret = -ECANCELED;
+	} else if (!(READ_ONCE(rga->irq_status) &
+		     READ_ONCE(rga->expected_irq)) ||
+		   (READ_ONCE(rga->irq_status) & (BIT(0) | BIT(1)))) {
+		dev_err(rga->dev, "job error irq=%#x\n", rga->irq_status);
+		ret = -EIO;
+	}
+	if (!ret) {
+		/* IRQ completion must precede an idle engine before any reset or RAM
+		 * update consumer. This is a bounded hardware completion check.
+		 */
+		ret = readl_poll_timeout(rga->regs + RGA1_STATUS, val,
+					 !(val & 1), 1, 1000);
+		if (ret)
+			dev_err(rga->dev, "completion without idle engine\n");
+	}
+
+	/* Quiesce DMA and IRQ before returning either buffer, including errors. */
+	if (rga1_reset(rga))
+		ret = -EIO;
+	return ret;
+}
+
+static struct rga1_image rga1_image(struct rga1_ctx *ctx,
+				    struct vb2_v4l2_buffer *buf,
+				    unsigned int side, u32 base)
+{
+	const struct v4l2_pix_format_mplane *p = &ctx->pix[side];
+	struct rga1_image img = {
+		.y = base,
+		.width = p->width,
+		.height = p->height,
+		.stride = p->plane_fmt[0].bytesperline,
+		.format = rga1_format(p->pixelformat)->hw,
+	};
+
+	img.uv = img.y + img.stride * img.height;
+	img.v = img.uv +
+		(img.stride / 2) *
+			(rga1_420(img.format) ? img.height / 2 : img.height);
+	if (p->num_planes == 3) {
+		img.uv = base + PAGE_ALIGN(p->plane_fmt[0].sizeimage);
+		img.v = img.uv + PAGE_ALIGN(p->plane_fmt[1].sizeimage);
+	}
+	img.vir_height = img.height;
+	img.width = ctx->rect[side].width;
+	img.height = ctx->rect[side].height;
+	img.y += ctx->rect[side].top * img.stride +
+		 rga1_line_bytes(ctx->rect[side].left, img.format);
+	if (rga1_yuv(img.format)) {
+		u32 cy = rga1_420(img.format) ? ctx->rect[side].top / 2 :
+						ctx->rect[side].top;
+		u32 cs = rga1_planar(img.format) ? img.stride / 2 : img.stride;
+		u32 cx = rga1_planar(img.format) ? ctx->rect[side].left / 2 :
+						   ctx->rect[side].left;
+		img.uv += cy * cs + cx;
+		img.v += cy * cs + cx;
+	}
+	return img;
+}
+
+/* Map the exact two images used by this pass. Extra entries all refer to
+ * this context's private guard page. The worker is serialized by the m2m core.
+ */
+static void rga1_map_sg(u32 *table, struct sg_table *sgt, size_t size)
+{
+	struct scatterlist *sg;
+	unsigned int i;
+	size_t n = 0, pages = DIV_ROUND_UP(size, PAGE_SIZE);
+
+	for_each_sg(sgt->sgl, sg, sgt->nents, i) {
+		dma_addr_t addr = sg_dma_address(sg);
+		size_t offset;
+
+		for (offset = 0; offset < sg_dma_len(sg) && n < pages;
+		     offset += PAGE_SIZE)
+			table[n++] = addr + offset;
+	}
+}
+
+static void rga1_map_buffer(u32 *table, struct vb2_v4l2_buffer *buf,
+			    const struct v4l2_pix_format_mplane *p)
+{
+	unsigned int i;
+
+	for (i = 0; i < p->num_planes; i++) {
+		size_t size = p->plane_fmt[i].sizeimage;
+
+		rga1_map_sg(table, vb2_dma_sg_plane_desc(&buf->vb2_buf, i), size);
+		table += DIV_ROUND_UP(size, PAGE_SIZE);
+	}
+}
+
+static u32 rga1_map_pass(struct rga1_ctx *ctx, struct vb2_v4l2_buffer *src,
+			 struct vb2_v4l2_buffer *dst, bool pre)
+{
+	size_t source_size = ctx->from_palette ? ctx->expanded_size : ctx->scratch_size;
+	dma_addr_t source_dma = ctx->from_palette ? ctx->expanded_dma : ctx->scratch_dma;
+	size_t target_size = ctx->palette_first ? ctx->expanded_size : ctx->scratch_size;
+	dma_addr_t target_dma = ctx->palette_first ? ctx->expanded_dma : ctx->scratch_dma;
+	size_t src_pages =
+		src ? rga1_pages(&ctx->pix[0]) : DIV_ROUND_UP(source_size, PAGE_SIZE);
+	size_t start = src_pages + ctx->guard_lead + ctx->guard_gap;
+	size_t i;
+
+	for (i = 0; i < ctx->page_table_size / sizeof(u32); i++)
+		ctx->page_table[i] = ctx->guard_dma;
+	if (src)
+		rga1_map_buffer(ctx->page_table + ctx->guard_lead, src, &ctx->pix[0]);
+	else
+		for (i = 0; i < src_pages; i++)
+			ctx->page_table[ctx->guard_lead + i] = source_dma + i * PAGE_SIZE;
+
+	if (ctx->mask_size) {
+		ctx->mask_base = start * PAGE_SIZE;
+		rga1_map_sg(ctx->page_table + start, ctx->mask_sgt, ctx->mask_size);
+		start += DIV_ROUND_UP(ctx->mask_size, PAGE_SIZE) + 16;
+	}
+
+	if (pre)
+		for (i = 0; i < DIV_ROUND_UP(target_size, PAGE_SIZE); i++)
+			ctx->page_table[start + i] = target_dma + i * PAGE_SIZE;
+	else
+		rga1_map_buffer(ctx->page_table + start, dst, &ctx->pix[1]);
+	return start * PAGE_SIZE;
+}
+
+static struct rga1_image rga1_rebase(struct rga1_image img, u32 base)
+{
+	img.uv = base + img.uv - img.y;
+	img.v = base + img.v - img.y;
+	img.y = base;
+	return img;
+}
+
+static void rga1_palette_command(struct rga1_ctx *ctx, const struct rga1_image *in,
+				 const struct rga1_image *out)
+{
+	u32 *cmd = ctx->rga->cmd;
+
+	u32 mono_bg = in->format == RGA1_PAL1 ? ctx->foreground : ctx->color;
+	u32 mono_fg = in->format == RGA1_PAL1 ? ctx->color : ctx->foreground;
+
+	memset(cmd, 0, RGA1_COMMAND_BYTES);
+	cmd[R1_MODE] = 1 | rga1_fmt_bits(in->format, 0) | rga1_fmt_bits(out->format, 1) |
+		       BIT(28);
+	rga1_src(cmd, in);
+	cmd[R1_DST] = out->y;
+	cmd[R1_DST_VIR] = out->stride / 4;
+	cmd[R1_DST_ACT] = (out->width - 1) | ((out->height - 1) << 16);
+	cmd[R1_BG] = 0xff000000 | (mono_bg & 0xff00) | ((mono_bg & 0xff) << 16) |
+		     (mono_bg >> 16);
+	cmd[R1_FG] = 0xff000000 | (mono_fg & 0xff00) | ((mono_fg & 0xff) << 16) |
+		     (mono_fg >> 16);
+	cmd[R1_YUV_OUT] = ctx->palette_alpha << 7;
+}
+
+static void rga1_effects(struct rga1_ctx *ctx, const struct rga1_image *in,
+			 const struct rga1_image *out)
+{
+	u32 *cmd = ctx->rga->cmd;
+
+	if (ctx->operation == 1 || ctx->operation == 5) {
+		memset(cmd, 0, RGA1_COMMAND_BYTES);
+		cmd[R1_MODE] =
+			2 | rga1_fmt_bits(out->format, 1) | ((ctx->operation == 5) << 22);
+		cmd[R1_DST] = out->y;
+		cmd[R1_DST_VIR] = out->stride / 4;
+		cmd[R1_DST_ACT] = (out->width - 1) | ((out->height - 1) << 16);
+		/* The internal color path is ABGR, not the V4L2 memory byte order. */
+		cmd[R1_FG] = (ctx->global_alpha << 24) | (ctx->color & 0xff00) |
+			     ((ctx->color & 0xff) << 16) | (ctx->color >> 16);
+		if (ctx->gradient_wrap)
+			cmd[R1_ALPHA] |= BIT(30);
+		if (ctx->dither)
+			cmd[R1_ALPHA] |= BIT(29);
+		cmd[R1_KEY_MIN] = rga1_pair(ctx->gradient[0], ctx->gradient[1]);
+		cmd[R1_KEY_MAX] = rga1_pair(ctx->gradient[2], ctx->gradient[3]);
+		cmd[R1_PRE_UV] = rga1_pair(ctx->gradient[4], ctx->gradient[5]);
+		cmd[R1_PRE_V] = rga1_pair(ctx->gradient[6], ctx->gradient[7]);
+		cmd[R1_PAT] = ((ctx->pattern_size & 0xffff) - 1) |
+			      (((ctx->pattern_size >> 16) - 1) << 8) |
+			      ((ctx->pattern_origin & 255) << 16) |
+			      ((ctx->pattern_origin >> 16) << 24);
+		cmd[R1_LINE] = (ctx->pattern_origin & 255) +
+			       (ctx->pattern_origin >> 16) * (ctx->pattern_size & 0xffff);
+		goto common_effects;
+	}
+	if (rga1_palette(in->format)) {
+		rga1_palette_command(ctx, in, out);
+		return;
+	}
+
+common_effects:
+	cmd[R1_MODE] = (cmd[R1_MODE] & ~(3U << 20)) | (ctx->sampling << 20);
+	if (ctx->dither)
+		cmd[R1_ALPHA] |= BIT(29);
+	if (ctx->zero_key)
+		cmd[R1_MODE] |= BIT(30);
+	/* Use the documented linear scan for untransformed, unscaled mixing.
+	 * Tile clipping flags are meaningful only in the affine path.
+	 */
+	if ((ctx->alpha_mode || ctx->rop) && !ctx->angle && !ctx->hflip &&
+	    !ctx->vflip && in->width == out->width &&
+	    in->height == out->height) {
+		cmd[R1_MODE] &= ~(3U << 18);
+		cmd[R1_DST_ACT] &= 0x0fffffff;
+	}
+	if (ctx->alpha_mode) {
+		if (rga1_has_alpha(ctx->pix[1].pixelformat))
+			cmd[R1_DST_VIR] |= BIT(28);
+		if (ctx->alpha_calc)
+			cmd[R1_ALPHA] |= BIT(28);
+		if (ctx->mix_dest)
+			cmd[R1_MODE] |= BIT(31);
+		cmd[R1_ALPHA] |= 1 | ((ctx->alpha_mode - 1) << 2) |
+				 (ctx->global_alpha << 8);
+		if (ctx->pd)
+			cmd[R1_ALPHA] |= BIT(16) | ((ctx->pd - 1) << 4);
+	}
+	if (ctx->rop) {
+		u32 code = ctx->rop - 1;
+
+		if (!ctx->rop_mode)
+			code = (code & 3) * 5 | (code & 12) * 20;
+		if (ctx->operation != 1)
+			cmd[R1_MODE] |= BIT(22);
+		cmd[R1_ALPHA] |= 3 | (ctx->rop_mode << 18);
+		cmd[R1_PRE_UV] = rga1_rop3[code & 255];
+		if (ctx->rop_mode == 2) {
+			cmd[R1_PRE_V] = rga1_rop3[code >> 8];
+			cmd[R1_SRC_UV] = ctx->mask_base;
+			cmd[R1_DST_VIR] |=
+				(ALIGN(DIV_ROUND_UP(ctx->pix[0].width, 8), 4) / 4) << 16;
+		}
+		cmd[R1_PAT] = ((ctx->pattern_size & 0xffff) - 1) |
+			      (((ctx->pattern_size >> 16) - 1) << 8) |
+			      ((ctx->pattern_origin & 255) << 16) |
+			      ((ctx->pattern_origin >> 16) << 24);
+		cmd[R1_LINE] = (ctx->pattern_origin & 255) +
+			       (ctx->pattern_origin >> 16) * (ctx->pattern_size & 0xffff);
+	}
+	if (ctx->fading) {
+		cmd[R1_ALPHA] |= BIT(17) | (ctx->global_alpha << 8);
+		cmd[R1_FADING] = ((ctx->fading >> 16) << 8) |
+				 (ctx->fading & 0xff00) << 8 |
+				 (ctx->fading & 0xff) << 24;
+	}
+	if (ctx->key) {
+		/* The stencil stage sets source alpha to zero. Consume it in the mix stage
+		 * even when ordinary blending is off, so keyed RGB pixels preserve DST.
+		 */
+		if (!ctx->alpha_mode)
+			cmd[R1_ALPHA] |= 1 | (1U << 2) | (255U << 8);
+		cmd[R1_MODE] |= 7U << 14;
+		if (ctx->key == 2)
+			cmd[R1_MODE] |= BIT(13);
+		cmd[R1_KEY_MIN] = (ctx->key_min & 0xff00) |
+				  ((ctx->key_min & 0xff) << 16) |
+				  (ctx->key_min >> 16);
+		cmd[R1_KEY_MAX] = (ctx->key_max & 0xff00) |
+				  ((ctx->key_max & 0xff) << 16) |
+				  (ctx->key_max >> 16);
+	}
+}
+
+static int rga1_load_ram(struct rga1_ctx *ctx, bool palette, enum rga1_format format)
+{
+	struct rga1_dev *rga = ctx->rga;
+
+	memcpy(ctx->aux, palette ? ctx->lut : ctx->pattern, 1024);
+	memset(rga->cmd, 0, RGA1_COMMAND_BYTES);
+	rga->cmd[R1_MODE] = (palette ? 6 | (rga1_fmt_bits(format, 0) & 0x30)
+				     : 7 | rga1_fmt_bits(format, 1)) |
+			    BIT(28);
+	rga->cmd[R1_DST] = ctx->aux_dma;
+	rga->cmd[R1_PAT] = 255;
+	return rga1_execute(ctx, false);
+}
+
+static void rga1_work(struct work_struct *work)
+{
+	struct rga1_dev *rga = container_of(work, struct rga1_dev, work);
+	struct rga1_ctx *ctx = v4l2_m2m_get_curr_priv(rga->m2m);
+	struct vb2_v4l2_buffer *src, *dst;
+	struct rga1_image in, out;
+	enum vb2_buffer_state state = VB2_BUF_STATE_ERROR;
+	u32 csc;
+	int ret = -EIO;
+
+	if (!ctx)
+		return;
+	ctx->palette_first = ctx->from_palette = false;
+	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+	in = rga1_image(ctx, src, 0, ctx->guard_lead * PAGE_SIZE);
+	out = rga1_image(ctx, dst, 1, 0);
+	if (rga->disconnected)
+		goto finish;
+	if (rga1_palette(in.format) || ctx->operation == 5 || ctx->rop) {
+		bool palette = rga1_palette(in.format);
+
+		ret = rga1_load_ram(ctx, palette, palette ? in.format : out.format);
+		if (ret)
+			goto finish;
+	}
+	if (ctx->palette_expand) {
+		struct rga1_image mid;
+
+		ctx->palette_first = ctx->hx || ctx->vy;
+		mid = rga1_rebase(ctx->palette_first ? ctx->expanded_image
+						     : ctx->intermediate,
+				  rga1_map_pass(ctx, src, dst, true));
+
+		rga1_palette_command(ctx, &in, &mid);
+		ret = rga1_execute(ctx, true);
+		if (ret)
+			goto finish;
+		in = rga1_rebase(ctx->palette_first ? ctx->expanded_image
+						    : ctx->intermediate,
+				 ctx->guard_lead * PAGE_SIZE);
+		ctx->from_palette = ctx->palette_first;
+		ctx->palette_first = false;
+		if (ctx->rop) {
+			ret = rga1_load_ram(ctx, false, out.format);
+			if (ret)
+				goto finish;
+		}
+	}
+
+	if (ctx->operation == 6) {
+		out = rga1_rebase(out, out.y + rga1_map_pass(ctx, src, dst, false));
+		/* The average engine ignores output UV swap. With equal formats
+		 * and no CSC, paired chroma channels are independent: bypass both
+		 * swaps to preserve either UV or VU byte order exactly. Internal
+		 * blit prescale still canonicalizes its scratch to UV as before. */
+		if (rga1_yuv(in.format) && !rga1_planar(in.format)) {
+			in.format &= ~0x400U;
+			out.format &= ~0x400U;
+		}
+		rga1_prescale(rga->cmd, &in, &out, ctx->hx, ctx->vy);
+		goto execute;
+	}
+
+	if (ctx->hx || ctx->vy) {
+		struct rga1_image mid = rga1_rebase(
+			ctx->intermediate,
+			rga1_map_pass(ctx, ctx->palette_expand ? NULL : src, dst, true));
+
+		rga1_prescale(rga->cmd, &in, &mid, ctx->hx, ctx->vy);
+		ret = rga1_execute(ctx, true);
+		if (ret)
+			goto finish;
+		in = rga1_rebase(ctx->intermediate, ctx->guard_lead * PAGE_SIZE);
+		ctx->from_palette = false;
+	}
+	out = rga1_rebase(
+		out,
+		out.y + rga1_map_pass(ctx,
+				      (ctx->hx || ctx->vy || ctx->palette_expand) ? NULL
+										  : src,
+				      dst, false));
+	csc = ctx->pix[0].ycbcr_enc == V4L2_YCBCR_ENC_709	       ? 2 :
+	      rga1_quant(&ctx->pix[0]) == V4L2_QUANTIZATION_FULL_RANGE ? 1 :
+									 0;
+	if (ctx->angle % 90) {
+		memset(rga->cmd, 0, RGA1_COMMAND_BYTES);
+		rga->cmd[R1_MODE] = 2 | rga1_fmt_bits(out.format, 1);
+		rga->cmd[R1_DST] = out.y;
+		rga->cmd[R1_DST_VIR] = out.stride / 4;
+		rga->cmd[R1_DST_ACT] = (out.width - 1) | ((out.height - 1) << 16);
+		rga->cmd[R1_FG] = 0xff000000;
+		ret = rga1_execute(ctx, true);
+		if (ret)
+			goto finish;
+	}
+
+	/* Distinct tile/pixel step precisions can put the last bilinear sample
+	 * just before a tile's encoded origin. A fetch halo prevents cache-gap
+	 * pixels for every arbitrary angle; AA coverage is enabled separately. */
+	if (!ctx->operation && !rga1_palette(in.format))
+		rga1_blit_filter_halo(rga->cmd, &in, &out, ctx->angle, ctx->hflip,
+				    ctx->vflip, ctx->csc_alias ? 3 : csc, ctx->sampling,
+				    ctx->angle % 90);
+	rga1_effects(ctx, &in, &out);
+	if (ctx->rotate_aa && ctx->angle % 90)
+		rga->cmd[R1_ALPHA] |= BIT(31) | 1 | (1U << 2) | (255U << 8);
+	if (rga1_yuv(out.format)) {
+		u32 mode;
+		bool same = rga1_yuv(in.format) &&
+			    ctx->pix[0].ycbcr_enc == ctx->pix[1].ycbcr_enc &&
+			    rga1_quant(&ctx->pix[0]) ==
+				    rga1_quant(&ctx->pix[1]);
+
+		mode = same					   ? 0 :
+		       ctx->pix[1].ycbcr_enc == V4L2_YCBCR_ENC_709 ? 3 :
+		       rga1_quant(&ctx->pix[1]) ==
+				       V4L2_QUANTIZATION_FULL_RANGE ?
+								     1 :
+								     2;
+		rga->cmd[R1_YUV_OUT] = 1 | (rga1_420(out.format) ? 2 : 0) |
+				       (out.format & 0x400 ? 8 : 0) |
+				       (mode << 4);
+		rga->cmd[R1_DST_UV] = out.uv;
+	}
+
+execute:
+	ret = rga1_execute(ctx, true);
+	if (!ret)
+		state = VB2_BUF_STATE_DONE;
+finish:
+	/* Check even if an earlier image pass failed. execute has quiesced DMA;
+	 * these coherent mappings stay owned until job_finish releases the job. */
+	dma_rmb();
+	if (memchr_inv(ctx->guard, 0, PAGE_SIZE)) {
+		dev_err(rga->dev, "image DMA modified a guard page\n");
+		WRITE_ONCE(rga->broken, true);
+		state = VB2_BUF_STATE_ERROR;
+	}
+	src = v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx);
+	dst = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+	v4l2_m2m_buf_copy_metadata(src, dst);
+	src->sequence = ctx->sequence[0]++;
+	dst->sequence = ctx->sequence[1]++;
+	v4l2_m2m_buf_done(src, state);
+	v4l2_m2m_buf_done(dst, state);
+	v4l2_m2m_job_finish(rga->m2m, ctx->fh.m2m_ctx);
+}
+
+static void rga1_device_run(void *priv)
+{
+	struct rga1_ctx *ctx = priv;
+
+	queue_work(ctx->rga->wq, &ctx->rga->work);
+}
+
+static void rga1_job_abort(void *priv)
+{
+	struct rga1_ctx *ctx = priv;
+
+	WRITE_ONCE(ctx->aborting, true);
+	complete(&ctx->rga->done);
+	/* The worker quiesces/reset DMA before job_finish wakes cancel_job. */
+}
+
+static const struct v4l2_m2m_ops rga1_m2m_ops = {
+	.device_run = rga1_device_run,
+	.job_abort = rga1_job_abort,
+};
+
+static int rga1_open(struct file *file)
+{
+	struct rga1_dev *rga = video_drvdata(file);
+	struct rga1_ctx *ctx;
+	struct v4l2_format f = { .type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE };
+	int ret;
+
+	if (mutex_lock_interruptible(&rga->mutex))
+		return -ERESTARTSYS;
+	if (rga->disconnected) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx) {
+		ret = -ENOMEM;
+		goto unlock;
+	}
+	ctx->rga = rga;
+	v4l2_fh_init(&ctx->fh, &rga->video);
+	file->private_data = &ctx->fh;
+	f.fmt.pix_mp.width = f.fmt.pix_mp.height = 100;
+	rga1_try_fmt(file, NULL, &f);
+	ctx->pix[0] = ctx->pix[1] = f.fmt.pix_mp;
+	ctx->rect[0] = ctx->rect[1] =
+		(struct v4l2_rect){ .width = 100, .height = 100 };
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(rga->m2m, ctx, rga1_queues);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		goto free_fh;
+	}
+	v4l2_ctrl_handler_init(&ctx->ctrls, 24);
+	v4l2_ctrl_new_std(&ctx->ctrls, &rga1_ctrl_ops, V4L2_CID_ROTATE, 0, 359, 1, 0);
+	v4l2_ctrl_new_std(&ctx->ctrls, &rga1_ctrl_ops, V4L2_CID_HFLIP, 0, 1, 1,
+			  0);
+	v4l2_ctrl_new_std(&ctx->ctrls, &rga1_ctrl_ops, V4L2_CID_VFLIP, 0, 1, 1,
+			  0);
+	v4l2_ctrl_new_std(&ctx->ctrls, &rga1_ctrl_ops, V4L2_CID_ALPHA_COMPONENT,
+			  0, 255, 1, 255);
+	v4l2_ctrl_new_std(&ctx->ctrls, &rga1_ctrl_ops, V4L2_CID_BG_COLOR, 0,
+			  0xffffff, 1, 0);
+	for (unsigned int i = 0; i < ARRAY_SIZE(rga1_controls); i++)
+		v4l2_ctrl_new_custom(&ctx->ctrls, &rga1_controls[i], NULL);
+	ctx->sampling = 1;
+	ctx->guard_lead = ctx->guard_gap = 16;
+	ctx->rop_mode = 1;
+	ctx->global_alpha = 255;
+	ctx->foreground = 0xffffff;
+	ctx->pattern_size = 0x10001;
+	if (ctx->ctrls.error) {
+		ret = ctx->ctrls.error;
+		v4l2_ctrl_handler_free(&ctx->ctrls);
+		v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+		goto free_fh;
+	}
+	ctx->fh.ctrl_handler = &ctx->ctrls;
+	v4l2_fh_add(&ctx->fh, file);
+	v4l2_device_get(&rga->v4l2);
+	mutex_unlock(&rga->mutex);
+	return 0;
+free_fh:
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+unlock:
+	mutex_unlock(&rga->mutex);
+	return ret;
+}
+
+static int rga1_release(struct file *file)
+{
+	struct rga1_ctx *ctx = rga1_ctx(file);
+	struct rga1_dev *rga = ctx->rga;
+
+	mutex_lock(&rga->mutex);
+	if (!rga->disconnected) {
+		/* job_finish wakes cancel_job before its final scheduler accesses. */
+		v4l2_m2m_suspend(rga->m2m);
+		flush_workqueue(rga->wq);
+	}
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	if (ctx->scratch)
+		dma_free_coherent(rga->dev, ctx->scratch_size, ctx->scratch,
+				  ctx->scratch_dma);
+	if (ctx->expanded)
+		dma_free_coherent(rga->dev, ctx->expanded_size, ctx->expanded,
+				  ctx->expanded_dma);
+
+	rga1_free_mmu(ctx);
+	rga1_put_mask(ctx);
+	v4l2_ctrl_handler_free(&ctx->ctrls);
+	v4l2_fh_del(&ctx->fh, file);
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+	if (!rga->disconnected)
+		v4l2_m2m_resume(rga->m2m);
+	mutex_unlock(&rga->mutex);
+	v4l2_device_put(&rga->v4l2);
+	return 0;
+}
+
+/* Fixed-width resource import; not a scalar control whose arbitrary min/max
+ * values would pretend to identify valid DMA-BUFs. video_ioctl2 holds mutex. */
+static long rga1_default(struct file *file, void *fh, bool valid_prio, unsigned int cmd,
+			 void *arg)
+{
+	struct rga1_ctx *ctx = rga1_ctx(file);
+	struct rga1_mask *mask = arg;
+
+	if (cmd != VIDIOC_RGA1_SET_MASK)
+		return -ENOTTY;
+	if (mask->flags || mask->fd < -1)
+		return -EINVAL;
+	if (vb2_is_streaming(v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx)) ||
+	    vb2_is_streaming(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
+		return -EBUSY;
+	return rga1_set_mask(ctx, mask->fd);
+}
+
+static const struct v4l2_ioctl_ops rga1_ioctl_ops = {
+	.vidioc_default = rga1_default,
+	.vidioc_querycap = rga1_querycap,
+	.vidioc_g_selection = rga1_g_selection,
+	.vidioc_s_selection = rga1_s_selection,
+	.vidioc_enum_fmt_vid_cap = rga1_enum_fmt,
+	.vidioc_enum_fmt_vid_out = rga1_enum_fmt,
+	.vidioc_g_fmt_vid_cap_mplane = rga1_g_fmt,
+	.vidioc_g_fmt_vid_out_mplane = rga1_g_fmt,
+	.vidioc_try_fmt_vid_cap_mplane = rga1_try_fmt,
+	.vidioc_try_fmt_vid_out_mplane = rga1_try_fmt,
+	.vidioc_s_fmt_vid_cap_mplane = rga1_s_fmt,
+	.vidioc_s_fmt_vid_out_mplane = rga1_s_fmt,
+	.vidioc_reqbufs = v4l2_m2m_ioctl_reqbufs,
+	.vidioc_create_bufs = v4l2_m2m_ioctl_create_bufs,
+	.vidioc_querybuf = v4l2_m2m_ioctl_querybuf,
+	.vidioc_prepare_buf = v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_qbuf = v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf = v4l2_m2m_ioctl_dqbuf,
+	.vidioc_expbuf = v4l2_m2m_ioctl_expbuf,
+	.vidioc_streamon = v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff = v4l2_m2m_ioctl_streamoff,
+	.vidioc_subscribe_event = v4l2_ctrl_subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
+
+static const struct v4l2_file_operations rga1_fops = {
+	.owner = THIS_MODULE,
+	.open = rga1_open,
+	.release = rga1_release,
+	.poll = v4l2_m2m_fop_poll,
+	.mmap = v4l2_m2m_fop_mmap,
+	.unlocked_ioctl = video_ioctl2,
+};
+
+static int rga1_runtime_resume(struct device *dev)
+{
+	struct rga1_dev *rga = dev_get_drvdata(dev);
+	int ret;
+
+	if (READ_ONCE(rga->broken))
+		return -EIO;
+	ret = clk_bulk_prepare_enable(rga->num_clks, rga->clks);
+	if (!ret)
+		rga->clocks_on = true;
+	return ret;
+}
+
+static int rga1_runtime_suspend(struct device *dev)
+{
+	struct rga1_dev *rga = dev_get_drvdata(dev);
+
+	if (rga->clocks_on) {
+		clk_bulk_disable_unprepare(rga->num_clks, rga->clks);
+		rga->clocks_on = false;
+	}
+	return 0;
+}
+
+static void rga1_v4l2_release(struct v4l2_device *v4l2)
+{
+	struct rga1_dev *rga = container_of(v4l2, struct rga1_dev, v4l2);
+
+	v4l2_m2m_release(rga->m2m);
+	v4l2_device_unregister(v4l2);
+	dma_free_coherent(rga->dev, RGA1_COMMAND_BYTES, rga->cmd, rga->cmd_dma);
+	put_device(rga->dev);
+	kfree(rga);
+}
+
+static void rga1_video_release(struct video_device *video)
+{
+	struct rga1_dev *rga = container_of(video, struct rga1_dev, video);
+
+	v4l2_device_put(&rga->v4l2);
+}
+
+static int rga1_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct rga1_dev *rga;
+	int ret;
+
+	rga = kzalloc_obj(*rga);
+	if (!rga)
+		return -ENOMEM;
+	rga->dev = get_device(dev);
+	mutex_init(&rga->mutex);
+	init_completion(&rga->done);
+	INIT_WORK(&rga->work, rga1_work);
+	platform_set_drvdata(pdev, rga);
+	rga->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(rga->regs)) {
+		ret = PTR_ERR(rga->regs);
+		goto free;
+	}
+	rga->num_clks = devm_clk_bulk_get_all(dev, &rga->clks);
+	if (rga->num_clks < 0) {
+		ret = rga->num_clks;
+		goto free;
+	}
+	if (rga->num_clks != 2) {
+		ret = -EINVAL;
+		goto free;
+	}
+	rga->resets = devm_reset_control_array_get_exclusive(dev);
+	if (IS_ERR(rga->resets)) {
+		ret = PTR_ERR(rga->resets);
+		goto free;
+	}
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		goto free;
+	rga->cmd = dma_alloc_coherent(dev, RGA1_COMMAND_BYTES, &rga->cmd_dma,
+				      GFP_KERNEL);
+	if (!rga->cmd) {
+		ret = -ENOMEM;
+		goto free;
+	}
+	rga->irq = platform_get_irq(pdev, 0);
+	if (rga->irq < 0) {
+		ret = rga->irq;
+		goto free_cmd;
+	}
+	ret = devm_request_irq(dev, rga->irq, rga1_irq, IRQF_NO_AUTOEN,
+			       dev_name(dev), rga);
+	if (ret)
+		goto free_cmd;
+	rga->wq = alloc_ordered_workqueue(RGA1_NAME, WQ_MEM_RECLAIM);
+	if (!rga->wq) {
+		ret = -ENOMEM;
+		goto free_irq;
+	}
+	rga->v4l2.release = rga1_v4l2_release;
+	ret = v4l2_device_register(dev, &rga->v4l2);
+	if (ret)
+		goto destroy_wq;
+	rga->m2m = v4l2_m2m_init(&rga1_m2m_ops);
+	if (IS_ERR(rga->m2m)) {
+		ret = PTR_ERR(rga->m2m);
+		goto unreg_v4l2;
+	}
+	pm_runtime_enable(dev);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		goto release_m2m;
+	ret = rga1_reset(rga);
+	if (!ret)
+		enable_irq(rga->irq);
+	pm_runtime_put(dev);
+	if (ret)
+		goto release_m2m;
+	strscpy(rga->video.name, RGA1_NAME, sizeof(rga->video.name));
+	rga->video.fops = &rga1_fops;
+	rga->video.ioctl_ops = &rga1_ioctl_ops;
+	rga->video.release = rga1_video_release;
+	rga->video.lock = &rga->mutex;
+	rga->video.v4l2_dev = &rga->v4l2;
+	rga->video.vfl_dir = VFL_DIR_M2M;
+	rga->video.device_caps = V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_STREAMING;
+	video_set_drvdata(&rga->video, rga);
+	ret = video_register_device(&rga->video, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto release_m2m;
+	dev_info(dev,
+		 "RGA1-plus registered as %s (internal MMU, RGB capture)\n",
+		 video_device_node_name(&rga->video));
+	return 0;
+release_m2m:
+	pm_runtime_disable(dev);
+	v4l2_m2m_release(rga->m2m);
+unreg_v4l2:
+	v4l2_device_unregister(&rga->v4l2);
+destroy_wq:
+	destroy_workqueue(rga->wq);
+free_irq:
+	devm_free_irq(dev, rga->irq, rga);
+free_cmd:
+	dma_free_coherent(dev, RGA1_COMMAND_BYTES, rga->cmd, rga->cmd_dma);
+free:
+	put_device(dev);
+	kfree(rga);
+	return dev_err_probe(dev, ret, "RGA1 probe failed\n");
+}
+
+static void rga1_remove(struct platform_device *pdev)
+{
+	struct rga1_dev *rga = platform_get_drvdata(pdev);
+
+	v4l2_device_get(&rga->v4l2);
+	mutex_lock(&rga->mutex);
+	v4l2_m2m_suspend(rga->m2m);
+	/* Keep close from freeing a context while job_finish still uses it. */
+	flush_workqueue(rga->wq);
+	rga->disconnected = true;
+	v4l2_device_disconnect(&rga->v4l2);
+	video_unregister_device(&rga->video);
+	mutex_unlock(&rga->mutex);
+	destroy_workqueue(rga->wq);
+	devm_free_irq(rga->dev, rga->irq, rga);
+	pm_runtime_disable(rga->dev);
+	if (!pm_runtime_status_suspended(rga->dev))
+		rga1_runtime_suspend(rga->dev);
+	pm_runtime_set_suspended(rga->dev);
+	v4l2_device_put(&rga->v4l2);
+}
+
+static const struct dev_pm_ops rga1_pm_ops = { RUNTIME_PM_OPS(
+	rga1_runtime_suspend, rga1_runtime_resume, NULL) };
+
+static const struct of_device_id rga1_match[] = {
+	{ .compatible = "rockchip,rk3128-rga" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, rga1_match);
+
+static struct platform_driver rga1_driver = {
+	.probe = rga1_probe, .remove = rga1_remove,
+	.driver = {
+		.name = RGA1_NAME,
+		.of_match_table = rga1_match,
+		.pm = pm_ptr(&rga1_pm_ops),
+	},
+};
+module_platform_driver(rga1_driver);
+
+MODULE_DESCRIPTION("Rockchip RK3128 RGA1-plus V4L2 mem2mem driver");
+MODULE_LICENSE("GPL");
+
+MODULE_IMPORT_NS("DMA_BUF");
+
+MODULE_IMPORT_NS("DMA_BUF");
