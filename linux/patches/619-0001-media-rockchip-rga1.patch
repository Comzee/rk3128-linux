diff --git a/drivers/media/platform/rockchip/rga/Kconfig b/drivers/media/platform/rockchip/rga/Kconfig
index 846e555..75c9eab 100644
--- a/drivers/media/platform/rockchip/rga/Kconfig
+++ b/drivers/media/platform/rockchip/rga/Kconfig
@@ -13,3 +13,19 @@ config VIDEO_ROCKCHIP_RGA
 	  image scaling, rotation, BitBLT, alpha blending and image blur/sharpness.
 
 	  To compile this driver as a module choose m here.
+
+config VIDEO_ROCKCHIP_RGA1
+	tristate "Rockchip RK3128 RGA1-plus 2D accelerator"
+	depends on V4L_MEM2MEM_DRIVERS && VIDEO_DEV
+	depends on ARCH_ROCKCHIP || COMPILE_TEST
+	select VIDEOBUF2_DMA_SG
+	select V4L2_MEM2MEM_DEV
+	help
+	  V4L2 mem2mem driver for the RK3128 RGA1-plus blitter, with RGB,
+	  planar/semi-planar YUV and packed palette inputs; RGB/YUV output,
+	  crop/compose, scaling, integer rotation/AA, fill, alpha and raster controls.
+	  DMA-BUF import uses the internal MMU with 4 KiB DMA page tables.
+	  No userspace physical addresses are accepted.
+	  The device tree must enable the engine explicitly.
+
+	  To compile as a module choose M; the module is rockchip-rga1.
