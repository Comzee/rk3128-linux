+static int rga1_queue_setup(struct vb2_queue *q, unsigned int *nbufs,
+			    unsigned int *nplanes, unsigned int sizes[],
+			    struct device *alloc_devs[])
+{
+	struct rga1_ctx *ctx = vb2_get_drv_priv(q);
+	const struct v4l2_pix_format_mplane *p = &ctx->pix[rga1_side(q->type)];
+	unsigned int i;
+
+	if (*nplanes && *nplanes != p->num_planes)
+		return -EINVAL;
+	for (i = 0; i < p->num_planes; i++) {
+		if (*nplanes && sizes[i] < p->plane_fmt[i].sizeimage)
+			return -EINVAL;
+		if (!*nplanes)
+			sizes[i] = p->plane_fmt[i].sizeimage;
+	}
+	*nplanes = p->num_planes;
+	return 0;
+}
+
+/* The engine consumes 32-bit, page-aligned DMA addresses, never CPU PFNs.
+ * Reject exporters whose DMA segment layout cannot be represented exactly.
+ */
+static int rga1_sg_check(struct sg_table *sgt, size_t size)
+{
+	struct scatterlist *sg;
+	unsigned int i;
+	size_t total = 0, needed = PAGE_ALIGN(size);
+
+	for_each_sg(sgt->sgl, sg, sgt->nents, i) {
+		dma_addr_t addr = sg_dma_address(sg);
+		size_t len = sg_dma_len(sg);
+
+		if (!len || !IS_ALIGNED(addr, PAGE_SIZE) ||
+		    !IS_ALIGNED(len, PAGE_SIZE) ||
+		    upper_32_bits((u64)addr + len - 1))
+			return -EINVAL;
+		total += len < needed - total ? len : needed - total;
+	}
+	return total >= PAGE_ALIGN(size) ? 0 : -EINVAL;
+}
+
+static unsigned int rga1_sg_discontinuities(struct sg_table *sgt)
+{
+	struct scatterlist *sg;
+	dma_addr_t end = 0;
+	unsigned int i, jumps = 0;
+
+	for_each_sg(sgt->sgl, sg, sgt->nents, i) {
+		if (i && sg_dma_address(sg) != end)
+			jumps++;
+		end = sg_dma_address(sg) + sg_dma_len(sg);
+	}
+	return jumps;
+}
+
+static int rga1_buf_prepare(struct vb2_buffer *vb)
+{
+	struct rga1_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	const struct v4l2_pix_format_mplane *p = &ctx->pix[rga1_side(vb->type)];
+	unsigned int i;
+
+	if (vb->num_planes != p->num_planes)
+		return -EINVAL;
+	if (V4L2_TYPE_IS_OUTPUT(vb->type)) {
+		if (vbuf->field == V4L2_FIELD_ANY)
+			vbuf->field = V4L2_FIELD_NONE;
+		if (vbuf->field != V4L2_FIELD_NONE)
+			return -EINVAL;
+	}
+	for (i = 0; i < p->num_planes; i++) {
+		u32 size = p->plane_fmt[i].sizeimage;
+		struct sg_table *sgt = vb2_dma_sg_plane_desc(vb, i);
+
+		if (vb2_plane_size(vb, i) < size || vb->planes[i].data_offset ||
+		    rga1_sg_check(sgt, size) ||
+		    (V4L2_TYPE_IS_OUTPUT(vb->type) &&
+		     vb2_get_plane_payload(vb, i) < size))
+			return -EINVAL;
+		if (rga1_sg_discontinuities(sgt))
+			dev_info_once(ctx->rga->dev,
+				      "internal MMU maps discontiguous DMA-BUF pages (%u "
+				      "discontinuities)\n",
+				      rga1_sg_discontinuities(sgt));
+	}
+	for (i = 0; i < p->num_planes; i++)
+		vb2_set_plane_payload(vb, i, p->plane_fmt[i].sizeimage);
+	return 0;
+}
+
+static void rga1_buf_queue(struct vb2_buffer *vb)
+{
+	struct rga1_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, to_vb2_v4l2_buffer(vb));
+}
+
+static void rga1_return_buffers(struct vb2_queue *q,
+				enum vb2_buffer_state state)
+{
+	struct rga1_ctx *ctx = vb2_get_drv_priv(q);
+	struct vb2_v4l2_buffer *buf;
+
+	while ((buf = V4L2_TYPE_IS_OUTPUT(q->type) ?
+			      v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx) :
+			      v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx)))
+		v4l2_m2m_buf_done(buf, state);
+}
