+++ b/drivers/media/platform/rockchip/rga/rga1.c
@@ -0,0 +1,2194 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * RK3128 RGA1-plus V4L2 mem2mem driver.
+ * Register programming derived from Rockchip's GPL RGA1 driver (2012),
+ * authors Zhang Shengqin et al., and the RK3128 TRM chapter 19.
+ *
+ * RGA1 has a different command/MMU ABI from RGA2. Keep its bounded,
+ * image worker separate; do not reset any shared VIO or VPU resource.
+ */
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/dma-mapping.h>
+#include <linux/dma-buf.h>
+#include <linux/interrupt.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/reset.h>
+#include <linux/workqueue.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-sg.h>
+
+#include "rga1-hw.h"
+#include "rga1-controls.h"
+
+#define RGA1_NAME "rockchip-rga1"
+#define RGA1_TIMEOUT_MS 1000
+#define RGA1_IRQ_ENABLE (BIT(10) | BIT(9) | BIT(8))
+#define RGA1_IRQ_CLEAR GENMASK(7, 4)
+
+struct rga1_dev {
+	struct device *dev;
+	void __iomem *regs;
+	struct clk_bulk_data *clks;
+	int num_clks, irq;
+	struct reset_control *resets;
+	struct v4l2_device v4l2;
+	struct video_device video;
+	struct v4l2_m2m_dev *m2m;
+	struct mutex mutex;
+	struct workqueue_struct *wq;
+	struct work_struct work;
+	struct completion done;
+	u32 irq_status, expected_irq;
+	bool disconnected, broken, clocks_on;
+	u32 *cmd;
+	dma_addr_t cmd_dma;
+};
+
+struct rga1_ctx {
+	struct v4l2_fh fh;
+	struct rga1_dev *rga;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_pix_format_mplane pix[2]; /* output, capture */
+	u32 sequence[2], angle;
+	struct v4l2_rect rect[2];
+	bool hflip, vflip, aborting, palette_expand, palette_first, from_palette;
+	void *scratch;
+	dma_addr_t scratch_dma;
+	size_t scratch_size;
+	struct rga1_image intermediate, expanded_image;
+	void *expanded;
+	dma_addr_t expanded_dma;
+	size_t expanded_size;
+	u32 *page_table;
+	dma_addr_t page_table_dma;
+	size_t page_table_size;
+	void *guard;
+	dma_addr_t guard_dma;
+	u32 hx, vy;
+	u32 operation, sampling, dither, alpha_mode, pd, global_alpha, color;
+	u32 key, key_min, key_max, rop, fading;
+	u32 pattern_size, csc_alias;
+	u32 foreground, palette_alpha, zero_key;
+	u32 gradient_wrap, alpha_calc, mix_dest, rop_mode, pattern_origin, mask_base,
+		rotate_aa;
+	u32 guard_lead, guard_gap;
+	size_t mask_size;
+	struct dma_buf *mask_buf;
+	struct dma_buf_attachment *mask_attach;
+	struct sg_table *mask_sgt;
+	u8 lut[1024], pattern[1024];
+	s32 gradient[8];
+	void *aux;
+	dma_addr_t aux_dma;
+};
+
+struct rga1_fmt {
+	u32 fourcc;
+	enum rga1_format hw;
+	bool yuv;
+	bool input;
+};
+
+static const struct rga1_fmt rga1_formats[] = {
+	{V4L2_PIX_FMT_RGB24, RGA1_RGB24, false, true},
+	{V4L2_PIX_FMT_BGR24, RGA1_BGR24, false, true},
+	{V4L2_PIX_FMT_RGB565, RGA1_RGB565, false, true},
+	{V4L2_PIX_FMT_NV12, RGA1_NV12, true, true},
+	{V4L2_PIX_FMT_NV16, RGA1_NV16, true, true},
+	{V4L2_PIX_FMT_RGBA32, RGA1_RGBA32, false, true},
+	{V4L2_PIX_FMT_RGBX32, RGA1_RGBA32, false, true},
+	{V4L2_PIX_FMT_ABGR32, RGA1_BGRA32, false, true},
+	{V4L2_PIX_FMT_XBGR32, RGA1_BGRA32, false, true},
+	{V4L2_PIX_FMT_ARGB32, RGA1_ARGB32, false, true},
+	{V4L2_PIX_FMT_XRGB32, RGA1_ARGB32, false, true},
+	{V4L2_PIX_FMT_BGRA32, RGA1_ABGR32, false, true},
+	{V4L2_PIX_FMT_BGRX32, RGA1_ABGR32, false, true},
+	{V4L2_PIX_FMT_RGBA555, RGA1_RGBA5551, false, true},
+	{V4L2_PIX_FMT_RGBX555, RGA1_RGBA5551, false, true},
+	{V4L2_PIX_FMT_BGRA555, RGA1_BGRA5551, false, true},
+	{V4L2_PIX_FMT_BGRX555, RGA1_BGRA5551, false, true},
+	{V4L2_PIX_FMT_ARGB444, RGA1_ARGB4444, false, true},
+	{V4L2_PIX_FMT_XRGB444, RGA1_ARGB4444, false, true},
+	{V4L2_PIX_FMT_ABGR444, RGA1_ABGR4444, false, true},
+	{V4L2_PIX_FMT_XBGR444, RGA1_ABGR4444, false, true},
+	{V4L2_PIX_FMT_RGBA444, RGA1_RGBA4444, false, true},
+	{V4L2_PIX_FMT_RGBX444, RGA1_RGBA4444, false, true},
+	{V4L2_PIX_FMT_BGRA444, RGA1_BGRA4444, false, true},
+	{V4L2_PIX_FMT_BGRX444, RGA1_BGRA4444, false, true},
+	{V4L2_PIX_FMT_NV21, RGA1_NV21, true, true},
+	{V4L2_PIX_FMT_NV61, RGA1_NV61, true, true},
+	{V4L2_PIX_FMT_YUV420, RGA1_YUV420P, true, true},
+	{V4L2_PIX_FMT_YVU420, RGA1_YVU420P, true, true},
+	{V4L2_PIX_FMT_YUV422P, RGA1_YUV422P, true, true},
+	{V4L2_PIX_FMT_YVU422M, RGA1_YVU422P, true, true},
+	{V4L2_PIX_FMT_PAL8, RGA1_PAL8, false, false},
+	{V4L2_PIX_FMT_RGA1_PAL1, RGA1_PAL1, false, true},
+	{V4L2_PIX_FMT_RGA1_PAL2, RGA1_PAL2, false, true},
+	{V4L2_PIX_FMT_RGA1_PAL4, RGA1_PAL4, false, true},
+};
+
+static const struct rga1_fmt *rga1_format(u32 fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(rga1_formats); i++)
+		if (rga1_formats[i].fourcc == fourcc)
+			return &rga1_formats[i];
+	return &rga1_formats[0];
+}
+
+static bool rga1_capture_format(const struct rga1_fmt *fmt)
+{
+	return !rga1_palette(fmt->hw) && fmt->hw != RGA1_ARGB4444 &&
+	       fmt->hw != RGA1_ABGR4444;
+}
+
+static struct rga1_ctx *rga1_ctx(struct file *file)
+{
+	return container_of(file_to_v4l2_fh(file), struct rga1_ctx, fh);
+}
+
+static unsigned int rga1_side(enum v4l2_buf_type type)
+{
+	return V4L2_TYPE_IS_OUTPUT(type) ? 0 : 1;
+}
+
+/* The standard YVU422M contract has three independently owned memory planes.
+ * Map each plane on a page boundary; no physical contiguity is assumed. */
+static bool rga1_multiplanar(u32 fourcc)
+{
+	return fourcc == V4L2_PIX_FMT_YVU422M;
+}
+
+static size_t rga1_pages(const struct v4l2_pix_format_mplane *p)
+{
+	size_t pages = 0;
+	unsigned int i;
+
+	for (i = 0; i < p->num_planes; i++)
+		pages += DIV_ROUND_UP(p->plane_fmt[i].sizeimage, PAGE_SIZE);
+	return pages;
+}
+
+static void rga1_size(struct v4l2_pix_format_mplane *p)
+{
+	const struct rga1_fmt *fmt = rga1_format(p->pixelformat);
+	u32 stride = ALIGN(clamp(p->plane_fmt[0].bytesperline,
+				 rga1_line_bytes(p->width, fmt->hw),
+				 RGA1_MAX_SRC * 4U),
+			   4);
+	u32 size = stride * p->height;
+
+	if (fmt->yuv && !rga1_multiplanar(p->pixelformat))
+		size += rga1_420(fmt->hw) ? size / 2 : size;
+	memset(p->plane_fmt, 0, sizeof(p->plane_fmt));
+	p->num_planes = 1;
+	p->plane_fmt[0].bytesperline = stride;
+	p->plane_fmt[0].sizeimage = size;
+	if (rga1_multiplanar(p->pixelformat)) {
+		p->num_planes = 3;
+		p->plane_fmt[1].bytesperline = p->plane_fmt[2].bytesperline = stride / 2;
+		p->plane_fmt[1].sizeimage = p->plane_fmt[2].sizeimage = size / 2;
+	}
+}
+
+/* DEFAULT is format-dependent: RGB defaults to full, YUV usually limited. */
+static u32 rga1_quant(const struct v4l2_pix_format_mplane *p)
+{
+	if (p->quantization != V4L2_QUANTIZATION_DEFAULT)
+		return p->quantization;
+	return V4L2_MAP_QUANTIZATION_DEFAULT(!rga1_format(p->pixelformat)->yuv,
+					     p->colorspace, p->ycbcr_enc);
+}
+
+static int rga1_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct rga1_ctx *ctx = rga1_ctx(file);
+	struct v4l2_pix_format_mplane *p = &f->fmt.pix_mp;
+	bool output = V4L2_TYPE_IS_OUTPUT(f->type);
+	const struct rga1_fmt *fmt = rga1_format(p->pixelformat);
+	u32 max = output ? RGA1_MAX_SRC : RGA1_MAX_DST;
+
+	/* Palette and planar YUV are source formats in the normal blit path. */
+	if ((output && !fmt->input) ||
+	    (!output && (!rga1_capture_format(fmt) ||
+			 (rga1_planar(fmt->hw) && ctx->operation != 6))))
+		fmt = &rga1_formats[0];
+	p->pixelformat = fmt->fourcc;
+	p->width = clamp(p->width, 2U, max);
+	p->height = clamp(p->height, 2U, max);
+	if (fmt->yuv) {
+		p->width &= ~1U;
+		if (rga1_420(fmt->hw))
+			p->height &= ~1U;
+	}
+	p->field = V4L2_FIELD_NONE;
+	if (output) {
+		if (p->colorspace != V4L2_COLORSPACE_REC709 &&
+		    p->colorspace != V4L2_COLORSPACE_SMPTE170M &&
+		    p->colorspace != V4L2_COLORSPACE_JPEG &&
+		    p->colorspace != V4L2_COLORSPACE_SRGB)
+			p->colorspace = fmt->yuv ? V4L2_COLORSPACE_SMPTE170M :
+						   V4L2_COLORSPACE_SRGB;
+		if (p->ycbcr_enc != V4L2_YCBCR_ENC_601 &&
+		    p->ycbcr_enc != V4L2_YCBCR_ENC_709)
+			p->ycbcr_enc =
+				V4L2_MAP_YCBCR_ENC_DEFAULT(p->colorspace);
+		if (p->quantization > V4L2_QUANTIZATION_LIM_RANGE)
+			p->quantization = V4L2_QUANTIZATION_DEFAULT;
+		/* MODE_CTRL[12:11]=3 aliases 601 limited, not 709 full. */
+		if (fmt->yuv && p->ycbcr_enc == V4L2_YCBCR_ENC_709 &&
+		    rga1_quant(p) == V4L2_QUANTIZATION_FULL_RANGE)
+			p->quantization = V4L2_QUANTIZATION_LIM_RANGE;
+		if (!p->xfer_func || p->xfer_func > V4L2_XFER_FUNC_SMPTE2084)
+			p->xfer_func =
+				V4L2_MAP_XFER_FUNC_DEFAULT(p->colorspace);
+	} else {
+		u32 enc = p->ycbcr_enc, quant = p->quantization;
+
+		p->colorspace = ctx->pix[0].colorspace;
+		p->ycbcr_enc = ctx->pix[0].ycbcr_enc;
+		p->xfer_func = ctx->pix[0].xfer_func;
+		p->quantization = ctx->pix[0].quantization;
+		if (p->flags & V4L2_PIX_FMT_FLAG_SET_CSC) {
+			if (fmt->yuv) {
+				if (enc == V4L2_YCBCR_ENC_601 ||
+				    enc == V4L2_YCBCR_ENC_709)
+					p->ycbcr_enc = enc;
+				p->quantization =
+					quant <= V4L2_QUANTIZATION_LIM_RANGE ?
+						quant :
+						V4L2_QUANTIZATION_DEFAULT;
+				if (p->ycbcr_enc == V4L2_YCBCR_ENC_709 &&
+				    rga1_quant(p) ==
+					    V4L2_QUANTIZATION_FULL_RANGE)
+					p->quantization =
+						V4L2_QUANTIZATION_LIM_RANGE;
+			} else {
+				p->quantization =
+					rga1_format(ctx->pix[0].pixelformat)
+							->yuv ?
+						V4L2_QUANTIZATION_FULL_RANGE :
+						rga1_quant(&ctx->pix[0]);
+			}
+		}
+	}
+
+	p->flags = 0;
+	if (!output)
+		p->plane_fmt[0].bytesperline =
+			min(p->plane_fmt[0].bytesperline, 0x3ffcU);
+	rga1_size(p);
+	return 0;
+}
+
+static int rga1_g_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	f->fmt.pix_mp = rga1_ctx(file)->pix[rga1_side(f->type)];
+	return 0;
+}
+
+static int rga1_s_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct rga1_ctx *ctx = rga1_ctx(file);
+	unsigned int side = rga1_side(f->type);
+	int ret = rga1_try_fmt(file, priv, f);
+
+	if (ret)
+		return ret;
+	if (vb2_is_busy(v4l2_m2m_get_vq(ctx->fh.m2m_ctx, f->type)) ||
+	    vb2_is_streaming(v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx)) ||
+	    vb2_is_streaming(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
+		return -EBUSY;
+	ctx->pix[side] = f->fmt.pix_mp;
+	ctx->rect[side] = (struct v4l2_rect){ .width = f->fmt.pix_mp.width,
+					      .height = f->fmt.pix_mp.height };
+	if (!side) {
+		ctx->pix[1].colorspace = ctx->pix[0].colorspace;
+		ctx->pix[1].ycbcr_enc = ctx->pix[0].ycbcr_enc;
+		ctx->pix[1].quantization = ctx->pix[0].quantization;
+		ctx->pix[1].xfer_func = ctx->pix[0].xfer_func;
+	}
+	return 0;
+}
+
+static int rga1_querycap(struct file *file, void *priv,
+			 struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, RGA1_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "RK3128 RGA1-plus", sizeof(cap->card));
+	return 0;
+}
+
+static int rga1_enum_fmt(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	bool output = V4L2_TYPE_IS_OUTPUT(f->type);
+	struct rga1_ctx *ctx = rga1_ctx(file);
+	unsigned int i, index = 0;
+
+	for (i = 0; i < ARRAY_SIZE(rga1_formats); i++) {
+		const struct rga1_fmt *fmt = &rga1_formats[i];
+
+		if ((output && !fmt->input) ||
+		    (!output && (!rga1_capture_format(fmt) ||
+				 (rga1_planar(fmt->hw) && ctx->operation != 6))))
+			continue;
+		if (index++ == f->index)
+			break;
+	}
+	if (i == ARRAY_SIZE(rga1_formats))
+		return -EINVAL;
+	f->pixelformat = rga1_formats[i].fourcc;
+	if (rga1_palette(rga1_formats[i].hw) &&
+	    f->pixelformat != V4L2_PIX_FMT_PAL8)
+		strscpy(f->description, "RGA1 packed palette indices",
+			sizeof(f->description));
+	if (!output)
+		f->flags |= V4L2_FMT_FLAG_CSC_QUANTIZATION;
+	if (!output && rga1_formats[i].yuv)
+		f->flags |= V4L2_FMT_FLAG_CSC_YCBCR_ENC;
+	return 0;
+}
+
+static int rga1_g_selection(struct file *file, void *priv,
+			    struct v4l2_selection *sel)
+{
+	struct rga1_ctx *ctx = rga1_ctx(file);
+	unsigned int side = rga1_side(sel->type);
+	u32 active = side ? V4L2_SEL_TGT_COMPOSE : V4L2_SEL_TGT_CROP;
+
+	if (sel->type != V4L2_BUF_TYPE_VIDEO_OUTPUT &&
+	    sel->type != V4L2_BUF_TYPE_VIDEO_CAPTURE)
+		return -EINVAL;
+	if (sel->target == active) {
+		sel->r = ctx->rect[side];
+		return 0;
+	}
+	if (sel->target != active + 1 && sel->target != active + 2)
+		return -EINVAL;
+	sel->r = (struct v4l2_rect){ .width = ctx->pix[side].width,
+				     .height = ctx->pix[side].height };
+	return 0;
+}
+
+static int rga1_s_selection(struct file *file, void *priv,
+			    struct v4l2_selection *sel)
+{
+	struct rga1_ctx *ctx = rga1_ctx(file);
+	unsigned int side = rga1_side(sel->type);
+	const struct rga1_fmt *fmt = rga1_format(ctx->pix[side].pixelformat);
+	struct v4l2_rect *r = &sel->r;
+	u32 minimum = side && (ctx->operation == 1 || ctx->operation == 5) ? 1 :
+									     2;
+
+	if ((sel->type != V4L2_BUF_TYPE_VIDEO_OUTPUT &&
+	     sel->type != V4L2_BUF_TYPE_VIDEO_CAPTURE) ||
+	    sel->target != (side ? V4L2_SEL_TGT_COMPOSE : V4L2_SEL_TGT_CROP) ||
+	    sel->flags)
+		return -EINVAL;
+	if (vb2_is_streaming(v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx)) ||
+	    vb2_is_streaming(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
+		return -EBUSY;
+	/* Exact selections: never round a requested edge or silently lose a border. */
+	if (r->left < 0 || r->top < 0 || r->width < minimum ||
+	    r->height < minimum || r->width > ctx->pix[side].width ||
+	    r->height > ctx->pix[side].height ||
+	    (u32)r->left > ctx->pix[side].width - r->width ||
+	    (u32)r->top > ctx->pix[side].height - r->height ||
+	    (fmt->yuv && ((r->left | r->width) & 1)) ||
+	    (rga1_420(fmt->hw) && ((r->top | r->height) & 1)) ||
+	    (rga1_palette(fmt->hw) && (r->left % (8U >> ((fmt->hw >> 4) & 3)))))
+		return -EINVAL;
+	ctx->rect[side] = *r;
+	return 0;
+}
+
+static int rga1_sg_check(struct sg_table *sgt, size_t size);
+
+static void rga1_put_mask(struct rga1_ctx *ctx)
+{
+	if (!ctx->mask_buf)
+		return;
+	dma_buf_unmap_attachment_unlocked(ctx->mask_attach, ctx->mask_sgt, DMA_TO_DEVICE);
+	dma_buf_detach(ctx->mask_buf, ctx->mask_attach);
+	dma_buf_put(ctx->mask_buf);
+	ctx->mask_buf = NULL;
+	ctx->mask_attach = NULL;
+	ctx->mask_sgt = NULL;
+}
+
+/* Replacement is transactional: a bad fd/exporter leaves the old mask owned.
+ * The caller serializes producers and brackets CPU access with DMA_BUF_SYNC. */
+static int rga1_set_mask(struct rga1_ctx *ctx, int fd)
+{
+	struct dma_buf *buf;
+	struct dma_buf_attachment *attach;
+	struct sg_table *sgt;
+	int ret;
+
+	if (fd == -1) {
+		rga1_put_mask(ctx);
+		return 0;
+	}
+	buf = dma_buf_get(fd);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+	attach = dma_buf_attach(buf, ctx->rga->dev);
+	if (IS_ERR(attach)) {
+		ret = PTR_ERR(attach);
+		goto put;
+	}
+	sgt = dma_buf_map_attachment_unlocked(attach, DMA_TO_DEVICE);
+	if (IS_ERR(sgt)) {
+		ret = PTR_ERR(sgt);
+		goto detach;
+	}
+	ret = rga1_sg_check(sgt, min_t(size_t, buf->size, 1));
+	if (ret) {
+		dma_buf_unmap_attachment_unlocked(attach, sgt, DMA_TO_DEVICE);
+		goto detach;
+	}
+	rga1_put_mask(ctx);
+	ctx->mask_buf = buf;
+	ctx->mask_attach = attach;
+	ctx->mask_sgt = sgt;
+	return 0;
+detach:
+	dma_buf_detach(buf, attach);
+put:
+	dma_buf_put(buf);
+	return ret;
+}
