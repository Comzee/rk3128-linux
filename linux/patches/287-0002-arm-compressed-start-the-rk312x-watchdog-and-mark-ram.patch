From: RK3128 reference (development record #287)
Subject: [PATCH] ARM: compressed: start the RK312x watchdog and mark RAM on entry

First boot of a mainline kernel on the RK3128 reference board, which has no
serial console: the only log is a RAM region read back from Android after a
warm reset, and a hang with no watchdog needs a power cycle by hand. With
RK312X_DECOMP_WDT the decompressor, when it runs from RK312x DRAM, starts
dw_wdt (longest timeout, system reset) before anything else and writes a
marker to RK312X_DECOMP_MARK, so the next boot can tell "the kernel was
entered" from "the loader never jumped to it", and a hang anywhere resets
the board. qemu's virt machine (DRAM at 0x40000000) skips both.
---
--- a/arch/arm/boot/compressed/head.S
+++ b/arch/arm/boot/compressed/head.S
@@ -246,6 +246,76 @@
 		msr	spsr_cxsf, r9		@ Save the CPU boot mode in
 						@ SPSR
 #endif
+
+#ifdef CONFIG_RK312X_DECOMP_WDT
+		/*
+		 * RK312x bring-up with no UART: when this image runs from RK312x
+		 * DRAM (0x60000000-0x6fffffff; qemu's virt and other boards are
+		 * left alone), start the SoC watchdog (dw_wdt at 0x2004c000,
+		 * longest timeout, system reset) so that a hang anywhere before
+		 * its driver probes resets the board, and leave a marker in RAM
+		 * that survives the warm reset (MMU and caches are off here, so
+		 * the stores reach DRAM): the magic, the entry registers, the
+		 * watchdog's TORR, CR and counter read back; "DCMP" follows after
+		 * the decompression, "STXT" at the kernel's stext (layout in
+		 * Kconfig RK312X_DECOMP_MARK). Uses r0-r3 only; r7, r8, r9 kept.
+		 * Every instruction here has an ARM and a Thumb-2 encoding.
+		 */
+		adr	r3, .
+		and	r0, r3, #0xf0000000
+		cmp	r0, #0x60000000
+		bne	.Lrk312x_wdt_done
+		movw	r0, #0x0000
+		movt	r0, #0x2000		@ CRU
+		mov	r1, #0x80000000		@ CLKGATE_CON7 bit 15 (pclk_wdt) = 0
+		str	r1, [r0, #0xec]		@ (bit 31: its write-enable)
+		movw	r0, #0xc000
+		movt	r0, #0x2004		@ WDT
+		mov	r1, #0xff		@ TORR: TOP = TOP_INIT = 15 (2^31 clocks)
+		str	r1, [r0, #0x04]
+		mov	r1, #0x01		@ CR: enable, reset mode (no IRQ first)
+		str	r1, [r0, #0x00]
+		mov	r1, #0x76		@ CRR: restart the counter
+		str	r1, [r0, #0x0c]
+		movw	r2, #:lower16:CONFIG_RK312X_DECOMP_MARK
+		movt	r2, #:upper16:CONFIG_RK312X_DECOMP_MARK
+		ldr	r1, [r0, #0x04]		@ read back: TORR, CR, the counter
+		str	r1, [r2, #0x20]
+		ldr	r1, [r0, #0x00]
+		str	r1, [r2, #0x24]
+		ldr	r1, [r0, #0x08]
+		str	r1, [r2, #0x28]
+		mov	r0, r2
+		movw	r1, #0x4b52		@ "RK3128-ZIMG-RUN!"
+		movt	r1, #0x3133
+		str	r1, [r0, #0x00]
+		movw	r1, #0x3832
+		movt	r1, #0x5a2d
+		str	r1, [r0, #0x04]
+		movw	r1, #0x4d49
+		movt	r1, #0x2d47
+		str	r1, [r0, #0x08]
+		movw	r1, #0x5552
+		movt	r1, #0x214e
+		str	r1, [r0, #0x0c]
+		str	r3, [r0, #0x10]		@ where the loader put us (this code)
+		str	r8, [r0, #0x14]		@ r2 at entry: the DTB
+		str	r7, [r0, #0x18]		@ r1 at entry: the machine number
+		str	r9, [r0, #0x1c]		@ CPSR at entry
+#ifdef CONFIG_DEBUG_RK312X_RAMLOG
+		movw	r0, #:lower16:CONFIG_DEBUG_RK312X_RAMLOG_PHYS
+		movt	r0, #:upper16:CONFIG_DEBUG_RK312X_RAMLOG_PHYS
+		movw	r1, #0x4c52		@ "RLOG"
+		movt	r1, #0x474f
+		str	r1, [r0, #0x00]
+		mov	r1, #16			@ the text starts at +16
+		str	r1, [r0, #0x04]
+		mov	r1, #0
+		str	r1, [r0, #0x10]
+#endif
+		dsb
+.Lrk312x_wdt_done:
+#endif
 		/*
 		 * Note that some cache flushing and other stuff may
 		 * be needed here - is there an Angel SWI call for this?
@@ -640,6 +710,26 @@
 		bl	cache_clean_flush
 		bl	cache_off
 
+#ifdef CONFIG_RK312X_DECOMP_WDT
+		/* decompressed, caches off: "DCMP", the watchdog counter, r4 */
+		adr	r3, .
+		and	r0, r3, #0xf0000000
+		cmp	r0, #0x60000000
+		bne	.Lrk312x_dcmp_done
+		movw	r2, #:lower16:CONFIG_RK312X_DECOMP_MARK
+		movt	r2, #:upper16:CONFIG_RK312X_DECOMP_MARK
+		movw	r0, #0xc000
+		movt	r0, #0x2004
+		ldr	r1, [r0, #0x08]
+		str	r1, [r2, #0x2c]
+		movw	r1, #0x4344		@ "DCMP"
+		movt	r1, #0x504d
+		str	r1, [r2, #0x30]
+		str	r4, [r2, #0x34]		@ where the kernel was inflated to
+		dsb
+.Lrk312x_dcmp_done:
+#endif
+
 #ifdef CONFIG_ARM_VIRT_EXT
 		mrs	r0, spsr		@ Get saved CPU boot mode
 		and	r0, r0, #MODE_MASK
--- a/arch/arm/kernel/head.S
+++ b/arch/arm/kernel/head.S
@@ -104,6 +104,27 @@
 	@ ensure svc mode and all interrupts masked
 	safe_svcmode_maskall r9
 
+#ifdef CONFIG_RK312X_DECOMP_WDT
+	@ RK312x bring-up mark (MMU off): "STXT", the watchdog counter, r2, r1
+	adr	r3, .
+	and	r4, r3, #0xf0000000
+	cmp	r4, #0x60000000
+	bne	1f
+	movw	r4, #:lower16:CONFIG_RK312X_DECOMP_MARK
+	movt	r4, #:upper16:CONFIG_RK312X_DECOMP_MARK
+	movw	r5, #0xc000
+	movt	r5, #0x2004
+	ldr	r5, [r5, #0x08]
+	str	r5, [r4, #0x3c]
+	movw	r5, #0x5453			@ "STXT"
+	movt	r5, #0x5458
+	str	r5, [r4, #0x38]
+	str	r2, [r4, #0x40]
+	str	r1, [r4, #0x44]
+	dsb
+1:
+#endif
+
 	mrc	p15, 0, r9, c0, c0		@ get processor id
 	bl	__lookup_processor_type		@ r5=procinfo r9=cpuid
 	movs	r10, r5				@ invalid processor (r5=0)?
--- a/arch/arm/mach-rockchip/Kconfig
+++ b/arch/arm/mach-rockchip/Kconfig
@@ -22,3 +22,35 @@
 	help
 	  Support for Rockchip's Cortex-A9 Single-to-Quad-Core-SoCs
 	  containing the RK2928, RK30xx and RK31xx series.
+
+config RK312X_DECOMP_WDT
+	bool "RK312x: start the SoC watchdog from the zImage decompressor"
+	depends on ARCH_ROCKCHIP && !CPU_V7M
+	help
+	  For bring-up of an RK3126/RK3128 board that has no serial console:
+	  the first instructions of the zImage, when it runs from RK312x DRAM
+	  (0x60000000-0x6fffffff), start the SoC watchdog (dw_wdt) with its
+	  longest timeout (2^31 clocks of pclk_wdt, about 29 s at 74.25 MHz)
+	  and write a marker ("RK3128-ZIMG-RUN!", the load address, r2, r1
+	  and the CPSR, the watchdog registers) to RK312X_DECOMP_MARK, with
+	  two more stage marks after the decompression and at the kernel's
+	  stext. A hang before the watchdog driver probes then resets the
+	  board, and the marks tell the next boot how far the kernel got. Once dw_wdt probes it finds the
+	  watchdog running and the watchdog core keeps it alive until user
+	  space opens it (WATCHDOG_HANDLE_BOOT_ENABLED). The watchdog cannot
+	  be stopped again before the next reset.
+
+config RK312X_DECOMP_MARK
+	hex "RK312x: physical address of the decompressor's RAM marker"
+	depends on RK312X_DECOMP_WDT
+	default 0x7f120010
+	help
+	  0x48 bytes are written here. It must be RAM that the boot loader
+	  and the kernel leave alone and that survives a warm reset, such as
+	  a place in a ramoops region. Layout (32-bit words, little endian):
+	  +0x00 "RK3128-ZIMG-RUN!"; +0x10 where the decompressor ran, r2 (the
+	  DTB), r1, the CPSR at entry; +0x20 the watchdog's TORR, CR and
+	  counter (CCVR) read back after it was started; +0x2c the counter
+	  and +0x30 "DCMP" once the kernel is inflated, +0x34 where to;
+	  +0x38 "STXT" and +0x3c the counter at the kernel's stext, +0x40 its
+	  r2 and +0x44 its r1.
