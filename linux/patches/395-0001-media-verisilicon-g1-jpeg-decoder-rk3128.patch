diff --git a/drivers/media/platform/verisilicon/hantro_g1_jpeg_dec.c b/drivers/media/platform/verisilicon/hantro_g1_jpeg_dec.c
new file mode 100644
index 0000000..1306ead
--- /dev/null
+++ b/drivers/media/platform/verisilicon/hantro_g1_jpeg_dec.c
@@ -0,0 +1,583 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hantro G1 JPEG decoder
+ *
+ * Copyright (C) STMicroelectronics SA 2024
+ * Authors: Hugues Fruchet <hugues.fruchet@foss.st.com>
+ *          for STMicroelectronics.
+ *
+ * This code is inspired from coda-jpeg.c
+ *
+ * Ported to mainline and to the Rockchip RK3128 VPU (VDPU1) by
+ * RK3128 reference: a job the hardware cannot take ends without leaking its
+ * runtime PM reference or arming the watchdog, Huffman tables of any size,
+ * quantisation and Huffman tables chosen per component, the stream length
+ * counted from the entropy-coded segment, and the bottom fill only where
+ * the last macroblock row is half coded (as Rockchip's MPP drives this
+ * block).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/dma-mapping.h>
+#include <media/v4l2-jpeg.h>
+#include <media/v4l2-mem2mem.h>
+#include "hantro.h"
+#include "hantro_g1_regs.h"
+#include "hantro_hw.h"
+#include "hantro_jpeg.h"
+
+#define JPEG_HUFFVAL_OFF	16
+#define JPEG_AC_SIZE		162
+#define JPEG_DC_SIZE		12
+/* the stream length register is 24 bits wide */
+#define JPEG_MAX_STREAM_LEN	(BIT(24) - 1)
+
+/*
+ * The table buffer the G1 reads at G1_REG_ADDR_QTABLE: one quantisation
+ * table per component in natural order, then the AC Huffman values (luma
+ * table first), then the DC ones, byte-swapped in 32-bit words.
+ */
+struct hantro_jpeg_vlc_hw_table {
+	u8 qp_tables[3][JPEG_QUANT_SIZE];
+	u8 ac_tables[2][JPEG_AC_SIZE];
+	u8 dc_tables[2][JPEG_DC_SIZE];
+	u8 padding[4];
+};
+
+/* Which of the stream's two tables of a class each hardware slot holds */
+struct hantro_jpeg_vlc_sel {
+	int ac_luma, dc_luma;	/* the stream table the luma uses (Ta[0], Td[0]) */
+	bool cb_ac, cr_ac;	/* chroma uses the hardware's second table */
+	bool cb_dc, cr_dc;
+};
+
+static void hantro_jpeg_get_default_huffman_tables(struct v4l2_jpeg_reference *huffman_tables)
+{
+	huffman_tables[0].start = (u8 *)v4l2_jpeg_ref_table_luma_dc_ht;
+	huffman_tables[0].length = sizeof(v4l2_jpeg_ref_table_luma_dc_ht);
+	huffman_tables[1].start = (u8 *)v4l2_jpeg_ref_table_chroma_dc_ht;
+	huffman_tables[1].length = sizeof(v4l2_jpeg_ref_table_chroma_dc_ht);
+	huffman_tables[2].start = (u8 *)v4l2_jpeg_ref_table_luma_ac_ht;
+	huffman_tables[2].length = sizeof(v4l2_jpeg_ref_table_luma_ac_ht);
+	huffman_tables[3].start = (u8 *)v4l2_jpeg_ref_table_chroma_ac_ht;
+	huffman_tables[3].length = sizeof(v4l2_jpeg_ref_table_chroma_ac_ht);
+}
+
+static void set_buffers(struct hantro_dev *vpu, struct hantro_ctx *ctx,
+			struct vb2_buffer *src_buf,
+			struct vb2_buffer *dst_buf,
+			struct v4l2_jpeg_header *header)
+{
+	dma_addr_t src_dma, dst_dma;
+
+	/*
+	 * Source (stream) buffer: the entropy-coded segment. The G1 reads
+	 * 64-bit words, so the address is that of the word holding the
+	 * segment's first byte and STRM_START_BIT (stream_bit_offset()) skips
+	 * to it; the buffer itself is page aligned.
+	 */
+	src_dma = vb2_dma_contig_plane_dma_addr(src_buf, 0);
+	src_dma += ALIGN_DOWN(header->ecs_offset, 8);
+	vdpu_write_relaxed(vpu, src_dma, G1_REG_ADDR_STR);
+
+	/* Destination (decoded frame) buffer: luma, then interleaved CbCr. */
+	dst_dma = hantro_get_dec_buf_addr(ctx, dst_buf);
+	vdpu_write_relaxed(vpu, dst_dma, G1_REG_ADDR_DST);
+	vdpu_write_relaxed(vpu, dst_dma +
+			   ctx->dst_fmt.plane_fmt[0].bytesperline *
+			   ctx->dst_fmt.height,
+			   G1_REG_ADDR_DST_CHROMA);
+
+	/* Auxiliary buffer prepared in hantro_jpeg_prepare_vlc_hw_table(). */
+	vdpu_write_relaxed(vpu, ctx->jpeg_dec.priv.dma, G1_REG_ADDR_QTABLE);
+}
+
+static int to_jpeg_mode(int subsampling)
+{
+	switch (subsampling) {
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_422:
+		return 3;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_420:
+		return 2;
+	/*
+	 * Currently unsupported:
+	 * case V4L2_JPEG_CHROMA_SUBSAMPLING_GRAY:
+	 * case V4L2_JPEG_CHROMA_SUBSAMPLING_444:
+	 * case V4L2_JPEG_CHROMA_SUBSAMPLING_411:
+	 */
+	default:
+		return 2;
+	}
+}
+
+static u32 to_pixelformat(int subsampling)
+{
+	switch (subsampling) {
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_422:
+		return V4L2_PIX_FMT_NV16;
+	case V4L2_JPEG_CHROMA_SUBSAMPLING_420:
+		return V4L2_PIX_FMT_NV12;
+	/*
+	 * Currently unsupported:
+	 * case V4L2_JPEG_CHROMA_SUBSAMPLING_GRAY:
+	 * case V4L2_JPEG_CHROMA_SUBSAMPLING_444:
+	 * case V4L2_JPEG_CHROMA_SUBSAMPLING_411:
+	 */
+	default:
+		return 0;
+	}
+}
+
+static const u8 *huff_bits(struct v4l2_jpeg_header *header, int idx)
+{
+	static const u8 none[JPEG_HUFFVAL_OFF];
+
+	return header->huffman_tables[idx].start ?: none;
+}
+
+static void write_vlc_code_lengths(struct hantro_ctx *ctx,
+				   struct v4l2_jpeg_header *header,
+				   const struct hantro_jpeg_vlc_sel *sel)
+{
+	struct hantro_dev *vpu = ctx->dev;
+	const u8 *bits1;
+	const u8 *bits2;
+	u32 reg;
+
+	/* First 16 bytes are BITS code lengths. Hardware wants luma in AC1. */
+	bits1 = huff_bits(header, 2 + sel->ac_luma);
+	bits2 = huff_bits(header, 2 + !sel->ac_luma);
+
+	/* AC1 table code lengths (luma) */
+	reg = G1_REG_DEC_JPEG_VLC_AC1_CODE1_CNT(bits1[0]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE2_CNT(bits1[1]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE3_CNT(bits1[2]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE4_CNT(bits1[3]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE5_CNT(bits1[4]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE6_CNT(bits1[5]);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_JPEG_VLC_AC_CODE_LENGTHS_A);
+
+	reg = G1_REG_DEC_JPEG_VLC_AC1_CODE7_CNT(bits1[6]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE8_CNT(bits1[7]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE9_CNT(bits1[8]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE10_CNT(bits1[9]);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_JPEG_VLC_AC_CODE_LENGTHS_B);
+
+	reg = G1_REG_DEC_JPEG_VLC_AC1_CODE11_CNT(bits1[10]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE12_CNT(bits1[11]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE13_CNT(bits1[12]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE14_CNT(bits1[13]);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_JPEG_VLC_AC_CODE_LENGTHS_C);
+
+	reg = G1_REG_DEC_JPEG_VLC_AC1_CODE15_CNT(bits1[14]) |
+	      G1_REG_DEC_JPEG_VLC_AC1_CODE16_CNT(bits1[15]) |
+	/* AC2 table code lengths (the not-luma) */
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE1_CNT(bits2[0]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE2_CNT(bits2[1]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE3_CNT(bits2[2]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE4_CNT(bits2[3]);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_JPEG_VLC_AC_CODE_LENGTHS_D);
+
+	reg = G1_REG_DEC_JPEG_VLC_AC2_CODE5_CNT(bits2[4]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE6_CNT(bits2[5]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE7_CNT(bits2[6]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE8_CNT(bits2[7]);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_JPEG_VLC_AC_CODE_LENGTHS_E);
+
+	reg = G1_REG_DEC_JPEG_VLC_AC2_CODE9_CNT(bits2[8]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE10_CNT(bits2[9]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE11_CNT(bits2[10]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE12_CNT(bits2[11]);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_JPEG_VLC_AC_CODE_LENGTHS_F);
+
+	reg = G1_REG_DEC_JPEG_VLC_AC2_CODE13_CNT(bits2[12]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE14_CNT(bits2[13]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE15_CNT(bits2[14]) |
+	      G1_REG_DEC_JPEG_VLC_AC2_CODE16_CNT(bits2[15]);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_JPEG_VLC_AC_CODE_LENGTHS_G);
+
+	/* Hardware requires that DC1 registers contains luma table */
+	bits1 = huff_bits(header, sel->dc_luma);
+	bits2 = huff_bits(header, !sel->dc_luma);
+
+	/* DC1 table code lengths (luma) */
+	reg = G1_REG_DEC_JPEG_VLC_DC1_CODE1_CNT(bits1[0]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE2_CNT(bits1[1]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE3_CNT(bits1[2]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE4_CNT(bits1[3]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE5_CNT(bits1[4]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE6_CNT(bits1[5]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE7_CNT(bits1[6]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE8_CNT(bits1[7]);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_JPEG_VLC_DC_CODE_LENGTHS_A);
+
+	reg = G1_REG_DEC_JPEG_VLC_DC1_CODE9_CNT(bits1[8]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE10_CNT(bits1[9]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE11_CNT(bits1[10]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE12_CNT(bits1[11]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE13_CNT(bits1[12]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE14_CNT(bits1[13]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE15_CNT(bits1[14]) |
+	      G1_REG_DEC_JPEG_VLC_DC1_CODE16_CNT(bits1[15]);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_JPEG_VLC_DC_CODE_LENGTHS_B);
+
+	/* DC2 table code lengths (not-luma) */
+	reg = G1_REG_DEC_JPEG_VLC_DC2_CODE1_CNT(bits2[0]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE2_CNT(bits2[1]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE3_CNT(bits2[2]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE4_CNT(bits2[3]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE5_CNT(bits2[4]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE6_CNT(bits2[5]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE7_CNT(bits2[6]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE8_CNT(bits2[7]);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_JPEG_VLC_DC_CODE_LENGTHS_C);
+
+	reg = G1_REG_DEC_JPEG_VLC_DC2_CODE9_CNT(bits2[8]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE10_CNT(bits2[9]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE11_CNT(bits2[10]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE12_CNT(bits2[11]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE13_CNT(bits2[12]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE14_CNT(bits2[13]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE15_CNT(bits2[14]) |
+	      G1_REG_DEC_JPEG_VLC_DC2_CODE16_CNT(bits2[15]);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_JPEG_VLC_DC_CODE_LENGTHS_D);
+}
+
+static void copy_huffvals(u8 *dst, size_t size, const struct v4l2_jpeg_reference *t)
+{
+	if (!t->start)
+		return;
+	memcpy(dst, t->start + JPEG_HUFFVAL_OFF,
+	       min_t(size_t, t->length - JPEG_HUFFVAL_OFF, size));
+}
+
+static void hantro_jpeg_prepare_vlc_hw_table(struct v4l2_jpeg_header *header,
+					     const struct hantro_jpeg_vlc_sel *sel,
+					     void *vlc_hw_table)
+{
+	struct hantro_jpeg_vlc_hw_table *hw_table = vlc_hw_table;
+	u32 *hw_table_le = vlc_hw_table;
+	u32 i, j;
+
+	/* Values a table has fewer of than its slot stay zero */
+	memset(hw_table, 0, sizeof(*hw_table));
+
+	/* QP tables, one per component, in natural order */
+	for (j = 0; j < 3; j++) {
+		const struct v4l2_jpeg_reference *qt = &header->quantization_tables
+			[header->frame.component[j].quantization_table_selector];
+
+		for (i = 0; i < JPEG_QUANT_SIZE; i++)
+			hw_table->qp_tables[j][v4l2_jpeg_zigzag_scan_index[i]] = qt->start[i];
+	}
+
+	/* HUFFVAL code values follow the 16 bytes of BITS code lengths */
+	copy_huffvals(hw_table->ac_tables[0], JPEG_AC_SIZE,
+		      &header->huffman_tables[2 + sel->ac_luma]);
+	copy_huffvals(hw_table->ac_tables[1], JPEG_AC_SIZE,
+		      &header->huffman_tables[2 + !sel->ac_luma]);
+	copy_huffvals(hw_table->dc_tables[0], JPEG_DC_SIZE,
+		      &header->huffman_tables[sel->dc_luma]);
+	copy_huffvals(hw_table->dc_tables[1], JPEG_DC_SIZE,
+		      &header->huffman_tables[!sel->dc_luma]);
+
+	/* Hardware requires 32-bits little-endian ordering */
+	for (i = 0; i < (sizeof(*hw_table) / sizeof(u32)); i++)
+		hw_table_le[i] = __swab32(hw_table_le[i]);
+}
+
+static int stream_bit_offset(struct v4l2_jpeg_header *header)
+{
+	/* the segment's first bit within the 64-bit word set_buffers() points at */
+	return (header->ecs_offset % 8) * 8;
+}
+
+/*
+ * Checks the headers against what the G1 decodes here (baseline, 8-bit,
+ * 4:2:0 or 4:2:2 in one interleaved scan, the size and capture format set
+ * by userspace) and picks the hardware's Huffman slots. 0 or -EINVAL.
+ */
+static int check_header(struct hantro_ctx *ctx, struct v4l2_jpeg_header *header,
+			u32 jpeg_size, struct hantro_jpeg_vlc_sel *sel)
+{
+	struct hantro_dev *vpu = ctx->dev;
+	struct v4l2_jpeg_scan_header *scan = header->scan;
+	size_t height = ctx->dst_fmt.height;
+	size_t width = ctx->dst_fmt.width;
+	u32 dst_pixelformat;
+	bool used[4] = { };
+	u32 i;
+
+	if (header->frame.precision != 8) {
+		dev_dbg(vpu->dev, "%u-bit JPEG not supported\n",
+			header->frame.precision);
+		return -EINVAL;
+	}
+
+	/* Check JPEG width/height, in macroblocks (the capture is MB aligned) */
+	if (MB_WIDTH(header->frame.width) != MB_WIDTH(width) ||
+	    MB_HEIGHT(header->frame.height) != MB_HEIGHT(height)) {
+		dev_dbg(vpu->dev,
+			"Resolution mismatch: %ux%u (JPEG) versus %zux%zu (user)\n",
+			header->frame.width, header->frame.height, width, height);
+		return -EINVAL;
+	}
+
+	/* Check destination pixel format match with JPEG subsampling */
+	dst_pixelformat = to_pixelformat(header->frame.subsampling);
+	if (!dst_pixelformat || header->frame.num_components != 3) {
+		dev_dbg(vpu->dev, "Unsupported JPEG subsampling (%d)\n",
+			header->frame.subsampling);
+		return -EINVAL;
+	}
+
+	if (dst_pixelformat != ctx->dst_fmt.pixelformat) {
+		dev_dbg(vpu->dev, "Decoder pixel format mismatch (expected %p4cc but got %p4cc)\n",
+			&dst_pixelformat, &ctx->dst_fmt.pixelformat);
+		return -EINVAL;
+	}
+
+	/* One interleaved scan of the three components, in frame order */
+	if (scan->num_components != 3) {
+		dev_dbg(vpu->dev, "Non-interleaved scan not supported\n");
+		return -EINVAL;
+	}
+
+	/* Check JPEG quantization tables: the one of each component */
+	for (i = 0; i < 3; i++) {
+		const struct v4l2_jpeg_reference *qt = &header->quantization_tables
+			[header->frame.component[i].quantization_table_selector];
+
+		if (scan->component[i].component_selector !=
+		    header->frame.component[i].component_identifier) {
+			dev_dbg(vpu->dev, "Scan components out of frame order\n");
+			return -EINVAL;
+		}
+		if (!qt->start || qt->length != JPEG_QUANT_SIZE) {
+			dev_dbg(vpu->dev, "Missing or 16-bit quantization table\n");
+			return -EINVAL;
+		}
+		if (scan->component[i].dc_entropy_coding_table_selector > 1 ||
+		    scan->component[i].ac_entropy_coding_table_selector > 1)
+			return -EINVAL;
+		used[scan->component[i].dc_entropy_coding_table_selector] = true;
+		used[2 + scan->component[i].ac_entropy_coding_table_selector] = true;
+	}
+
+	/* Check JPEG huffman tables: the ones the scan uses */
+	if (!header->num_dht)
+		hantro_jpeg_get_default_huffman_tables(header->huffman_tables);
+
+	for (i = 0; i < 4; i++) {
+		size_t len = header->huffman_tables[i].length;
+
+		if (!used[i])
+			continue;
+		if (!header->huffman_tables[i].start) {
+			dev_dbg(vpu->dev, "Missing Huffman[%d] table\n", i);
+			return -EINVAL;
+		}
+		/* AC tables hold at most 162 values, DC ones 12 */
+		if (len <= JPEG_HUFFVAL_OFF ||
+		    len > JPEG_HUFFVAL_OFF + ((i & 2) ? JPEG_AC_SIZE : JPEG_DC_SIZE)) {
+			dev_dbg(vpu->dev, "invalid Huffman table %d length: %zu\n",
+				i, len);
+			return -EINVAL;
+		}
+	}
+
+	if (jpeg_size <= header->ecs_offset ||
+	    jpeg_size - ALIGN_DOWN(header->ecs_offset, 8) > JPEG_MAX_STREAM_LEN) {
+		dev_dbg(vpu->dev, "Invalid stream size %u\n", jpeg_size);
+		return -EINVAL;
+	}
+
+	/*
+	 * The hardware's first table of a class is the luma's; a chroma
+	 * component selects the second one when its table is another.
+	 */
+	sel->ac_luma = scan->component[0].ac_entropy_coding_table_selector;
+	sel->dc_luma = scan->component[0].dc_entropy_coding_table_selector;
+	sel->cb_ac = scan->component[1].ac_entropy_coding_table_selector != sel->ac_luma;
+	sel->cr_ac = scan->component[2].ac_entropy_coding_table_selector != sel->ac_luma;
+	sel->cb_dc = scan->component[1].dc_entropy_coding_table_selector != sel->dc_luma;
+	sel->cr_dc = scan->component[2].dc_entropy_coding_table_selector != sel->dc_luma;
+
+	return 0;
+}
+
+/*
+ * A job the hardware cannot take ends here, with an error, the way the
+ * VPU981 AV1 decoder ends one: hantro_irq_done() cancels the watchdog
+ * hantro_end_prepare_run() armed and gives back the job's runtime PM
+ * reference and clocks (on RK3128 the PM reference holds the bus shared
+ * with the HEVC decoder). Returning an error to device_run() instead would
+ * keep both, and leave the watchdog to abort a later job.
+ */
+static int hantro_g1_jpeg_dec_fail(struct hantro_ctx *ctx)
+{
+	hantro_end_prepare_run(ctx);
+	hantro_irq_done(ctx->dev, VB2_BUF_STATE_ERROR);
+	return 0;
+}
+
+int hantro_g1_jpeg_dec_run(struct hantro_ctx *ctx)
+{
+	struct hantro_dev *vpu = ctx->dev;
+	struct vb2_v4l2_buffer *src_buf, *dst_buf;
+	size_t height = ctx->dst_fmt.height;
+	size_t width = ctx->dst_fmt.width;
+	struct v4l2_jpeg_scan_header scan_header;
+	struct v4l2_jpeg_reference quantization_tables[4] = { };
+	struct v4l2_jpeg_reference huffman_tables[4] = { };
+	struct v4l2_jpeg_header header;
+	struct hantro_jpeg_vlc_sel sel;
+	u32 mb_width, mb_height;
+	bool half_mb_row;
+	void *vaddr;
+	u32 jpeg_size;
+	u32 reg;
+	int ret;
+
+	hantro_start_prepare_run(ctx);
+
+	/* A video decode on this core has priority (hantro_start_streaming()). */
+	if (atomic_read(&vpu->video_dec_streaming)) {
+		dev_dbg(vpu->dev, "A video decode is streaming\n");
+		return hantro_g1_jpeg_dec_fail(ctx);
+	}
+
+	src_buf = hantro_get_src_buf(ctx);
+	dst_buf = hantro_get_dst_buf(ctx);
+
+	jpeg_size = vb2_get_plane_payload(&src_buf->vb2_buf, 0);
+	vaddr = vb2_plane_vaddr(&src_buf->vb2_buf, 0);
+	if (!vaddr)
+		return hantro_g1_jpeg_dec_fail(ctx);
+
+	memset(&header, 0, sizeof(header));
+	header.scan = &scan_header;
+	header.quantization_tables = quantization_tables;
+	header.huffman_tables = huffman_tables;
+
+	ret = v4l2_jpeg_parse_header(vaddr, jpeg_size, &header);
+	if (ret < 0) {
+		dev_dbg(vpu->dev, "Error parsing JPEG stream markers\n");
+		return hantro_g1_jpeg_dec_fail(ctx);
+	}
+
+	ret = check_header(ctx, &header, jpeg_size, &sel);
+	if (ret)
+		return hantro_g1_jpeg_dec_fail(ctx);
+
+	/* Write VLC table code lengths */
+	write_vlc_code_lengths(ctx, &header, &sel);
+
+	/* Prepare VLC QP/AC/DC hardware tables */
+	hantro_jpeg_prepare_vlc_hw_table(&header, &sel, ctx->jpeg_dec.priv.cpu);
+
+	reg = G1_REG_DEC_CTRL0_DEC_MODE(3) |
+	      G1_REG_DEC_CTRL0_FILTERING_DIS;
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_CTRL0);
+
+	/* Frame dimensions */
+	mb_width = MB_WIDTH(width);
+	mb_height = MB_HEIGHT(height);
+	reg = G1_REG_DEC_CTRL1_PIC_MB_WIDTH(mb_width) |
+	      G1_REG_DEC_CTRL1_PIC_MB_HEIGHT_P(mb_height) |
+	      G1_REG_DEC_CTRL1_PIC_MB_W_EXT(mb_width >> 9) |
+	      G1_REG_DEC_CTRL1_PIC_MB_H_EXT(mb_height >> 8);
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_CTRL1);
+
+	reg = G1_REG_DEC_CTRL2_JPEG_MODE(to_jpeg_mode(header.frame.subsampling)) |
+	      G1_REG_DEC_CTRL2_JPEG_STREAM_ALL |
+	      G1_REG_DEC_CTRL2_JPEG_QTABLES(header.frame.num_components);
+
+	/* Luminance uses the first tables; chrominance as check_header() chose */
+	if (sel.cb_dc)
+		reg |= G1_REG_DEC_CTRL2_CB_DC_VLCTABLE;
+	if (sel.cb_ac)
+		reg |= G1_REG_DEC_CTRL2_CB_AC_VLCTABLE;
+	if (sel.cr_dc)
+		reg |= G1_REG_DEC_CTRL2_CR_DC_VLCTABLE;
+	if (sel.cr_ac)
+		reg |= G1_REG_DEC_CTRL2_CR_AC_VLCTABLE;
+
+	reg |= G1_REG_DEC_CTRL2_STRM_START_BIT(stream_bit_offset(&header));
+
+	if (header.restart_interval)
+		reg |= G1_REG_DEC_CTRL2_SYNC_MARKER_E;
+	vdpu_write_relaxed(vpu,
+			   G1_REG_DEC_CTRL5_PJPEG_REST_FREQ(header.restart_interval),
+			   G1_REG_DEC_CTRL5);
+
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_CTRL2);
+
+	reg = G1_REG_DEC_CTRL3_STREAM_LEN(jpeg_size -
+					  ALIGN_DOWN(header.ecs_offset, 8));
+	vdpu_write_relaxed(vpu, reg, G1_REG_DEC_CTRL3);
+
+	/*
+	 * Vertical alignment: a 4:2:2 MCU is 8 lines high, so when the height
+	 * leaves 1 to 8 lines in the last macroblock row only its upper half
+	 * is coded, and the hardware fills the lower one. A 4:2:0 MCU is a
+	 * whole macroblock: nothing to fill.
+	 */
+	half_mb_row = header.frame.subsampling == V4L2_JPEG_CHROMA_SUBSAMPLING_422 &&
+		      header.frame.height % MB_DIM &&
+		      header.frame.height % MB_DIM <= 8;
+
+	vdpu_write_relaxed(vpu, half_mb_row ? G1_REG_DEC_CTRL4_PJPEG_FILDOWN_E : 0,
+			   G1_REG_DEC_CTRL4);
+
+	/* Disable slice mode */
+	vdpu_write_relaxed(vpu, G1_REG_JPEG_CTRL_SLICE_H(0) |
+			   (half_mb_row ? G1_REG_JPEG_CTRL_HEIGHT8_FLAG : 0),
+			   G1_REG_JPEG_CTRL);
+
+	set_buffers(vpu, ctx, &src_buf->vb2_buf, &dst_buf->vb2_buf, &header);
+
+	hantro_end_prepare_run(ctx);
+
+	/* Start decoding! */
+	vdpu_write_relaxed(vpu,
+			   G1_REG_CONFIG_DEC_AXI_RD_ID(0xffu) |
+			   G1_REG_CONFIG_DEC_TIMEOUT_E |
+			   G1_REG_CONFIG_DEC_OUT_ENDIAN |
+			   G1_REG_CONFIG_DEC_STRENDIAN_E |
+			   G1_REG_CONFIG_DEC_MAX_BURST(16) |
+			   G1_REG_CONFIG_DEC_OUTSWAP32_E |
+			   G1_REG_CONFIG_DEC_INSWAP32_E |
+			   G1_REG_CONFIG_DEC_STRSWAP32_E |
+			   G1_REG_CONFIG_DEC_CLK_GATE_E,
+			   G1_REG_CONFIG);
+	vdpu_write(vpu, G1_REG_INTERRUPT_DEC_E, G1_REG_INTERRUPT);
+
+	return 0;
+}
+
+void hantro_jpeg_dec_exit(struct hantro_ctx *ctx)
+{
+	struct hantro_dev *vpu = ctx->dev;
+	struct hantro_jpeg_dec_hw_ctx *jpeg_dec = &ctx->jpeg_dec;
+	struct hantro_aux_buf *priv = &jpeg_dec->priv;
+
+	dma_free_coherent(vpu->dev, priv->size, priv->cpu, priv->dma);
+}
+
+int hantro_jpeg_dec_init(struct hantro_ctx *ctx)
+{
+	struct hantro_dev *vpu = ctx->dev;
+	struct hantro_jpeg_dec_hw_ctx *jpeg_dec = &ctx->jpeg_dec;
+	struct hantro_aux_buf *priv = &jpeg_dec->priv;
+	struct hantro_jpeg_vlc_hw_table *hw_table;
+
+	priv->cpu = dma_alloc_coherent(vpu->dev, sizeof(*hw_table), &priv->dma,
+				       GFP_KERNEL);
+	if (!priv->cpu)
+		return -ENOMEM;
+
+	priv->size = sizeof(*hw_table);
+
+	return 0;
+}
