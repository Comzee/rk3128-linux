From: Comzee <117947104+Comzee@users.noreply.github.com>
Subject: [PATCH] drm/rockchip: count RK3126 scanout FIFO and bus errors

The RK3126 FIFO-empty status bits are outside the RK3036 IRQ descriptor.
Count both windows and bus errors in the VOP owner and expose a bounded,
read-only per-CRTC snapshot. Retain W1C bits as pulses rather than cached
state so acknowledging one source cannot silently clear another.

Signed-off-by: Comzee <117947104+Comzee@users.noreply.github.com>
---
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop.c b/drivers/gpu/drm/rockchip/rockchip_drm_vop.c
index 0b9a83b..707ac78 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop.c
@@ -7,6 +7,7 @@
 #include <linux/clk.h>
 #include <linux/component.h>
 #include <linux/delay.h>
+#include <linux/debugfs.h>
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
 #include <linux/log2.h>
@@ -20,6 +21,7 @@
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/reset.h>
+#include <linux/seq_file.h>
 
 #include <drm/drm.h>
 #include <drm/drm_atomic.h>
@@ -180,6 +182,10 @@ struct vop {
 
 	unsigned int irq;
 
+	/* Monotonic since bind; protected by irq_lock, including on 32-bit. */
+	u64 frame_irqs, win0_empty, win1_empty, bus_errors, last_error_ns;
+	u32 last_error_status;
+
 	/* vop AHP clk */
 	struct clk *hclk;
 	/* vop dclk */
@@ -231,6 +237,12 @@ static void vop_reg_set(struct vop *vop, const struct vop_reg *reg,
 		vop->regsbak[offset >> 2] = v;
 	}
 
+	/* IRQ acknowledge bits are pulses, never persistent register state. */
+	if (vop->data->intr->empty_status.mask &&
+	    (reg == &vop->data->intr->clear ||
+	     reg == &vop->data->intr->empty_clear))
+		vop->regsbak[offset >> 2] &= ~(mask << shift);
+
 	if (reg->relaxed)
 		writel_relaxed(v, vop->regs + offset);
 	else
@@ -703,6 +715,18 @@ static int vop_enable(struct drm_crtc *crtc, struct drm_crtc_state *old_state)
 
 	spin_unlock(&vop->reg_lock);
 
+	/* Error reporting is independent of userspace's vblank subscription. */
+	if (vop->data->intr->empty_status.mask) {
+		spin_lock_irq(&vop->irq_lock);
+		VOP_INTR_SET_TYPE(vop, clear, BUS_ERROR_INTR, 1);
+		VOP_INTR_SET_TYPE(vop, enable, BUS_ERROR_INTR, 1);
+		vop_reg_set(vop, &vop->data->intr->empty_clear, 0, ~0, 3,
+			    "empty_clear");
+		vop_reg_set(vop, &vop->data->intr->empty_enable, 0, ~0, 3,
+			    "empty_enable");
+		spin_unlock_irq(&vop->irq_lock);
+	}
+
 	drm_crtc_vblank_on(crtc);
 
 	return 0;
@@ -773,6 +797,14 @@ static void vop_crtc_atomic_disable(struct drm_crtc *crtc,
 
 	vop_dsp_hold_valid_irq_disable(vop);
 
+	if (vop->data->intr->empty_status.mask) {
+		spin_lock_irq(&vop->irq_lock);
+		VOP_INTR_SET_TYPE(vop, enable, BUS_ERROR_INTR, 0);
+		vop_reg_set(vop, &vop->data->intr->empty_enable, 0, ~0, 0,
+			    "empty_enable");
+		spin_unlock_irq(&vop->irq_lock);
+	}
+
 	vop->is_enabled = false;
 
 	/*
@@ -1870,7 +1902,62 @@ vop_crtc_verify_crc_source(struct drm_crtc *crtc, const char *source_name,
 }
 #endif
 
+/* Only RK3126 has the register layout sampled here. Reads never wake it. */
+static int vop_errors_show(struct seq_file *s, void *unused)
+{
+	struct vop *vop = s->private;
+	unsigned long flags;
+	u64 frames, empty0, empty1, bus, last_ns;
+	u32 last_status;
+	int ret, i;
+
+	spin_lock_irqsave(&vop->irq_lock, flags);
+	frames = vop->frame_irqs;
+	empty0 = vop->win0_empty;
+	empty1 = vop->win1_empty;
+	bus = vop->bus_errors;
+	last_ns = vop->last_error_ns;
+	last_status = vop->last_error_status;
+	spin_unlock_irqrestore(&vop->irq_lock, flags);
+	seq_printf(s, "frame_irqs=%llu win0_empty=%llu win1_empty=%llu bus_errors=%llu\n",
+		   frames, empty0, empty1, bus);
+	seq_printf(s, "last_error_ns=%llu last_error_status=%08x\n",
+		   last_ns, last_status);
+
+	mutex_lock(&vop->vop_lock);
+	if (pm_runtime_get_if_in_use(vop->dev) <= 0) {
+		seq_puts(s, "registers=inactive\n");
+		goto unlock;
+	}
+	ret = vop_core_clks_enable(vop);
+	if (ret) {
+		pm_runtime_put(vop->dev);
+		mutex_unlock(&vop->vop_lock);
+		return ret;
+	}
+	/* Bounded read-only snapshot, including IRQ, AXI and both windows. */
+	for (i = 0; i < 0xe0; i += 4)
+		seq_printf(s, "%03x %08x\n", i, vop_readl(vop, i));
+	vop_core_clks_disable(vop);
+	pm_runtime_put(vop->dev);
+unlock:
+	mutex_unlock(&vop->vop_lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(vop_errors);
+
+static int vop_crtc_late_register(struct drm_crtc *crtc)
+{
+	struct vop *vop = to_vop(crtc);
+
+	if (vop->data->intr->empty_status.mask)
+		debugfs_create_file("vop_errors", 0444, crtc->debugfs_entry,
+				    vop, &vop_errors_fops);
+	return 0;
+}
+
 static const struct drm_crtc_funcs vop_crtc_funcs = {
+	.late_register = vop_crtc_late_register,
 	.set_config = drm_atomic_helper_set_config,
 	.page_flip = drm_atomic_helper_page_flip,
 	.destroy = drm_crtc_cleanup,
@@ -1913,7 +2000,7 @@ static irqreturn_t vop_isr(int irq, void *data)
 {
 	struct vop *vop = data;
 	struct drm_crtc *crtc = &vop->crtc;
-	uint32_t active_irqs;
+	u32 active_irqs, empty = 0, status;
 	int ret = IRQ_NONE;
 
 	/*
@@ -1935,6 +2022,25 @@ static irqreturn_t vop_isr(int irq, void *data)
 	spin_lock(&vop->irq_lock);
 
 	active_irqs = VOP_INTR_GET_TYPE(vop, status, INTR_MASK);
+	if (active_irqs & FS_INTR)
+		vop->frame_irqs++;
+	if (vop->data->intr->empty_status.mask) {
+		status = vop_readl(vop, vop->data->intr->status.offset);
+		empty = (status >> vop->data->intr->empty_status.shift) &
+			vop->data->intr->empty_status.mask;
+		if (empty) {
+			vop->win0_empty += !!(empty & BIT(0));
+			vop->win1_empty += !!(empty & BIT(1));
+			vop_reg_set(vop, &vop->data->intr->empty_clear, 0,
+				    ~0, empty, "empty_clear");
+		}
+		if (active_irqs & BUS_ERROR_INTR)
+			vop->bus_errors++;
+		if (empty || (active_irqs & BUS_ERROR_INTR)) {
+			vop->last_error_ns = ktime_get_ns();
+			vop->last_error_status = status;
+		}
+	}
 	/* Clear all active interrupt sources */
 	if (active_irqs)
 		VOP_INTR_SET_TYPE(vop, clear, active_irqs, 1);
@@ -1942,6 +2048,14 @@ static irqreturn_t vop_isr(int irq, void *data)
 	spin_unlock(&vop->irq_lock);
 
 	/* This is expected for vop iommu irqs, since the irq is shared */
+	if (empty)
+		ret = IRQ_HANDLED;
+	if (vop->data->intr->empty_status.mask &&
+	    (active_irqs & BUS_ERROR_INTR)) {
+		DRM_DEV_ERROR_RATELIMITED(vop->dev, "VOP bus error\n");
+		active_irqs &= ~BUS_ERROR_INTR;
+		ret = IRQ_HANDLED;
+	}
 	if (!active_irqs)
 		goto out_disable;
 
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop.h b/drivers/gpu/drm/rockchip/rockchip_drm_vop.h
index a12dd77..8316553 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop.h
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop.h
@@ -141,6 +141,10 @@ struct vop_intr {
 	struct vop_reg enable;
 	struct vop_reg clear;
 	struct vop_reg status;
+	/* RK3126 FIFO status has a different shift from its enables/clears. */
+	struct vop_reg empty_status;
+	struct vop_reg empty_enable;
+	struct vop_reg empty_clear;
 };
 
 struct vop_scl_extension {
diff --git a/drivers/gpu/drm/rockchip/rockchip_vop_reg.c b/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
index 07f46ec..8ff0f6b 100644
--- a/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
+++ b/drivers/gpu/drm/rockchip/rockchip_vop_reg.c
@@ -239,8 +239,20 @@ static const struct vop_output rk3126_output = {
 	.mipi_dclk_pol = VOP_REG(RK3036_AXI_BUS_CTRL, 0x1, 29),
 };
 
+static const struct vop_intr rk3126_intr = {
+	.intrs = rk3036_vop_intrs,
+	.nintrs = ARRAY_SIZE(rk3036_vop_intrs),
+	.line_flag_num[0] = VOP_REG(RK3036_INT_STATUS, 0xfff, 12),
+	.status = VOP_REG_SYNC(RK3036_INT_STATUS, 0xf, 0),
+	.enable = VOP_REG_SYNC(RK3036_INT_STATUS, 0xf, 4),
+	.clear = VOP_REG_SYNC(RK3036_INT_STATUS, 0xf, 8),
+	.empty_status = VOP_REG_SYNC(RK3036_INT_STATUS, 0x3, 28),
+	.empty_enable = VOP_REG_SYNC(RK3036_INT_STATUS, 0x3, 24),
+	.empty_clear = VOP_REG_SYNC(RK3036_INT_STATUS, 0x3, 26),
+};
+
 static const struct vop_data rk3126_vop = {
-	.intr = &rk3036_intr,
+	.intr = &rk3126_intr,
 	.common = &rk3036_common,
 	.modeset = &rk3036_modeset,
 	.output = &rk3126_output,
