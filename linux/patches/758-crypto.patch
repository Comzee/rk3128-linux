diff --git a/drivers/char/hw_random/rk3128-rng-pmu.h b/drivers/char/hw_random/rk3128-rng-pmu.h
--- /dev/null
+++ b/drivers/char/hw_random/rk3128-rng-pmu.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef RK3128_RNG_PMU_H
+#define RK3128_RNG_PMU_H
+
+#include <linux/bits.h>
+#include <linux/device.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
+
+/* RK312x PMU chapter: crypto request +0xc bit7, idle/ack +0x10 bits7/23.
+ * Check the always-on PMU before ANY crypto-register access. A previous
+ * interrupted diagnostic may have left the master port isolated across reset.
+ * Release only crypto's request, never another domain or power-mode policy.
+ */
+static inline int rk3128_crypto_ensure_active(struct device *dev)
+{
+	struct regmap *pmu;
+	u32 status, request;
+	int err;
+
+	pmu = syscon_regmap_lookup_by_compatible("rockchip,rk3128-pmu");
+	if (IS_ERR(pmu))
+		return dev_err_probe(dev, PTR_ERR(pmu), "crypto PMU syscon\n");
+	err = regmap_read(pmu, 0xc, &request);
+	if (!err)
+		err = regmap_read(pmu, 0x10, &status);
+	if (err)
+		return dev_err_probe(dev, err, "crypto PMU state\n");
+	if (!(request & BIT(7)) && !(status & (BIT(7) | BIT(23))))
+		return 0;
+	err = regmap_update_bits(pmu, 0xc, BIT(7), 0);
+	if (!err)
+		err = regmap_read_poll_timeout(pmu, 0x10, status,
+			!(status & (BIT(7) | BIT(23))), 1, 10000);
+	if (err)
+		return dev_err_probe(dev, err, "crypto remains idled; refusing register access\n");
+	dev_warn(dev, "released retained crypto PMU idle request before probe\n");
+	return 0;
+}
+#endif
