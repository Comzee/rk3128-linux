+/* The v1 PIO protocol is documented and independently used by NetBSD.
+ * RK3128's AES/TDES_STS DONE bits remain zero after a correct result; CTRL's
+ * self-clearing START is the verified completion signal. The poll sleeps if
+ * the first read is not complete, and every block has a bounded deadline.
+ */
+static int rk_pio_chunk(struct rk3128_dev *d, struct rk3128_cipher_ctx *ctx,
+			u32 mode, u8 iv[16], unsigned int bytes, bool decrypt)
+{
+	struct rk3128_cipher *alg = ctx->alg;
+	unsigned int block = alg->des ? 8 : 16, off, i;
+	u32 control = alg->des ? RK_CRYPTO_TDES_CTRL : RK_CRYPTO_AES_CTRL;
+	u32 din = alg->des ? RK_CRYPTO_TDES_DIN_0 : RK_CRYPTO_AES_DIN_0;
+	u32 dout = alg->des ? RK_CRYPTO_TDES_DOUT_0 : RK_CRYPTO_AES_DOUT_0;
+	u32 keyreg = alg->des ? RK_CRYPTO_TDES_KEY1_0 : RK_CRYPTO_AES_KEY_0;
+	u32 start = alg->des ? RK_CRYPTO_TDES_START : RK_CRYPTO_AES_START, v;
+	bool cbc = alg->mode & (alg->des ? RK_CRYPTO_TDES_CHAINMODE_CBC : RK_CRYPTO_AES_CBC_MODE);
+	u8 nextiv[16], work[16];
+	int err;
+
+	/* PIO's native chaining failed known answers. Use the proven hardware
+	 * ECB primitive with the standard CBC/CTR construction, as crypto mode
+	 * templates do. Every cipher block still runs on silicon, never a software
+	 * AES/DES substitute. Counter arithmetic is big endian, including tails.
+	 */
+	mode &= ~(alg->des ? RK_CRYPTO_TDES_CHAINMODE_CBC :
+		  RK_CRYPTO_AES_CBC_MODE | RK_CRYPTO_AES_CTR_MODE);
+	if (alg->ctr)
+		mode &= ~RK_CRYPTO_AES_DEC;
+	rk_write(d, RK_CRYPTO_INTENA, 0);
+	rk_write(d, RK_CRYPTO_INTSTS, 0x3f);
+	for (off = 0; off < bytes; off += block) {
+		memcpy(work, alg->ctr ? iv : d->pio_in + off, block);
+		if (cbc && decrypt)
+			memcpy(nextiv, work, block);
+		if (cbc && !decrypt)
+			for (i = 0; i < block; i++)
+				work[i] ^= iv[i];
+		for (i = 0; i < block; i += 4)
+			rk_write(d, din + i, get_unaligned_le32(work + i));
+		for (i = 0; i < ctx->keylen; i += 4)
+			rk_write(d, keyreg + i, get_unaligned_le32(ctx->key + i));
+		rk_write(d, control, mode);
+		rk_dma_start(d, start);
+		err = readl_poll_timeout(d->reg + RK_CRYPTO_CTRL, v, !(v & start), 1, 10000);
+		if (err) {
+			memzero_explicit(nextiv, sizeof(nextiv));
+			memzero_explicit(work, sizeof(work));
+			return rk_abort(d, err);
+		}
+		for (i = 0; i < block; i += 4)
+			put_unaligned_le32(readl(d->reg + dout + i), work + i);
+		if (alg->ctr)
+			for (i = 0; i < block; i++)
+				work[i] ^= ((u8 *)d->pio_in)[off + i];
+		if (cbc && decrypt)
+			for (i = 0; i < block; i++)
+				work[i] ^= iv[i];
+		memcpy(d->pio_out + off, work, block);
+		if (alg->ctr)
+			crypto_inc(iv, block);
+		else if (cbc)
+			memcpy(iv, decrypt ? nextiv : work, block);
+		cond_resched();
+	}
+	memzero_explicit(nextiv, sizeof(nextiv));
+	memzero_explicit(work, sizeof(work));
+	return 0;
+}
