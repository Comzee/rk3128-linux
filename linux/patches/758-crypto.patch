+static int rk_rng_sample(struct rk3128_dev *r, u8 data[RK_RNG_BYTES])
+{
+	u32 ctrl;
+	unsigned int i;
+	int err;
+
+	writel(RK_RNG_START << 16 | RK_RNG_START, r->reg + RK_RNG_CTRL);
+	err = readl_poll_timeout(r->reg + RK_RNG_CTRL, ctrl,
+				 !(ctrl & RK_RNG_START), 50, 20000);
+	if (err)
+		return err;
+	for (i = 0; i < RK_RNG_BYTES; i += 4)
+		put_unaligned_le32(readl(r->reg + RK_RNG_DATA + i), data + i);
+	if (rk_rng_health_block(&r->health, data))
+		return -EIO;
+	return 0;
+}
+
+static void rk_rng_fail(struct rk3128_dev *r)
+{
+	r->rng_failed = true;
+	writel(0, r->reg + RK_RNG_OSC);
+	dev_err_ratelimited(r->dev, "TRNG timeout/health failure; output latched off until driver removal\n");
+}
+
+static int rk_rng_init(struct hwrng *rng)
+{
+	struct rk3128_dev *r = container_of(rng, struct rk3128_dev, rng);
+	u8 discard[RK_RNG_BYTES];
+	unsigned int i;
+	int err = 0;
+
+	mutex_lock(&r->lock);
+	if (r->rng_failed || r->broken) {
+		err = -EIO;
+		goto out;
+	}
+	/* The oscillator is independent of the crypto clocks and flush signals.
+	 * Keep it on while selected. Withhold/test 1024 startup bits (90B 4.3).
+	 * Preserve continuous-test history across source selection as well.
+	 */
+	writel(RK_RNG_ENABLE | RK_RNG_PERIOD, r->reg + RK_RNG_OSC);
+	for (i = 0; i < 4; i++) {
+		err = rk_rng_sample(r, discard);
+		if (err) {
+			rk_rng_fail(r);
+			break;
+		}
+	}
+	memzero_explicit(discard, sizeof(discard));
+out:
+	mutex_unlock(&r->lock);
+	return err;
+}
+
+static void rk_rng_cleanup(struct hwrng *rng)
+{
+	struct rk3128_dev *r = container_of(rng, struct rk3128_dev, rng);
+
+	mutex_lock(&r->lock);
+	if (!r->broken)
+		writel(0, r->reg + RK_RNG_OSC);
+	mutex_unlock(&r->lock);
+}
+
+static int rk_rng_read(struct hwrng *rng, void *buf, size_t max, bool wait)
+{
+	struct rk3128_dev *r = container_of(rng, struct rk3128_dev, rng);
+	u8 data[RK_RNG_BYTES];
+	int err;
+	size_t n = min_t(size_t, max, sizeof(data));
+
+	if (!wait || !n)
+		return 0;
+	mutex_lock(&r->lock);
+	if (r->rng_failed || r->broken) {
+		err = -EIO;
+		goto out;
+	}
+	err = rk_rng_sample(r, data);
+	if (err) {
+		rk_rng_fail(r);
+		goto clear;
+	}
+	/* Never expose any part of a sample that failed either health test. */
+	memcpy(buf, data, n);
+	err = n;
+clear:
+	memzero_explicit(data, sizeof(data));
+out:
+	mutex_unlock(&r->lock);
+	return err;
+}
+
