Subject: [PATCH 2/2] ASoC: codecs: add the RK3128/RK3126 internal codec

The RK3128 and RK3126 internal codec is an Inno design whose analog half
has the ADC registers in front of the DAC ones, so inno_rk3036.c (which
finds its DAC power at 0x88 and its output stage at 0x90..0xa0) registers
on it and plays silence. This is a playback driver for it: DAC, headphone
mixer and output stage, with the power sequences of the Rockchip vendor
driver (rk312x_codec.c). The sequence runs as a DAPM supply, so an external
speaker amplifier (simple-audio-amplifier) is switched on after it and off
before it.

---
diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 8e251e1d8..e5df5943c 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -134,6 +134,7 @@ config SND_SOC_ALL_CODECS
 	imply SND_SOC_ICS43432
 	imply SND_SOC_IDT821034
 	imply SND_SOC_INNO_RK3036
+	imply SND_SOC_INNO_RK3128
 	imply SND_SOC_ISABELLE
 	imply SND_SOC_JZ4740_CODEC
 	imply SND_SOC_JZ4725B_CODEC
@@ -1392,6 +1393,18 @@ config SND_SOC_INNO_RK3036
 	depends on ARCH_ROCKCHIP || COMPILE_TEST
 	select REGMAP_MMIO
 
+config SND_SOC_INNO_RK3128
+	tristate "Inno codec driver for RK3128 and RK3126 SoCs"
+	depends on ARCH_ROCKCHIP || COMPILE_TEST
+	select MFD_SYSCON
+	select REGMAP_MMIO
+	help
+	  Playback driver for the internal audio codec of the Rockchip
+	  RK3128 and RK3126 (DAC, headphone mixer and output stage). The
+	  codec is a different design from the RK3036 one, so the RK3036
+	  driver does not work on these SoCs. Capture is not supported.
+	  Say Y or M if you want sound from the internal codec.
+
 config SND_SOC_ISABELLE
 	tristate
 	depends on I2C
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
index 3d122ace7..9e54a1a07 100644
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -151,6 +151,7 @@ snd-soc-hda-codec-y := hda.o hda-dai.o
 snd-soc-ics43432-y := ics43432.o
 snd-soc-idt821034-y := idt821034.o
 snd-soc-inno-rk3036-y := inno_rk3036.o
+snd-soc-inno-rk3128-y := inno_rk3128.o
 snd-soc-isabelle-y := isabelle.o
 snd-soc-jz4740-codec-y := jz4740.o
 snd-soc-jz4725b-codec-y := jz4725b.o
@@ -595,6 +596,7 @@ obj-$(CONFIG_SND_SOC_HDA) += snd-soc-hda-codec.o
 obj-$(CONFIG_SND_SOC_ICS43432)	+= snd-soc-ics43432.o
 obj-$(CONFIG_SND_SOC_IDT821034)	+= snd-soc-idt821034.o
 obj-$(CONFIG_SND_SOC_INNO_RK3036)	+= snd-soc-inno-rk3036.o
+obj-$(CONFIG_SND_SOC_INNO_RK3128)	+= snd-soc-inno-rk3128.o
 obj-$(CONFIG_SND_SOC_ISABELLE)	+= snd-soc-isabelle.o
 obj-$(CONFIG_SND_SOC_JZ4740_CODEC)	+= snd-soc-jz4740-codec.o
 obj-$(CONFIG_SND_SOC_JZ4725B_CODEC)	+= snd-soc-jz4725b-codec.o
diff --git a/sound/soc/codecs/inno_rk3128.c b/sound/soc/codecs/inno_rk3128.c
new file mode 100644
index 000000000..e00ebe4e5
--- /dev/null
+++ b/sound/soc/codecs/inno_rk3128.c
@@ -0,0 +1,661 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Driver for the internal audio codec of the Rockchip RK3128 and RK3126.
+ *
+ * An Inno codec like the RK3036 one (inno_rk3036.c) and the RK3328 one
+ * (rk3328_codec.c), but with the analog half of the ADC in front of the
+ * DAC half, so that the RK3036 register map does not fit: it puts the DAC
+ * power at 0x88 and the output stage at 0x90 to 0xa0, which are the
+ * microphone and ALC registers here. The DAC half has the layout of the
+ * RK3328 one at +0x14.
+ *
+ * Playback only (DAC, headphone mixer and output stage). The power-up and
+ * power-down sequences are the register writes the Rockchip 3.10 vendor
+ * driver (rk312x_codec.c, "rk312x_for_mid" mode) makes, including the
+ * extra "init" writes its register accessor adds on a power bit change.
+ * The capture half (ADC, ALC, PGA/AGC) is not implemented.
+ */
+
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+/* codec registers */
+#define RK3128_RESET			0x00
+#define RK3128_ADC_INT_CTL2		0x0c
+#define RK3128_DAC_INT_CTL1		0x10
+#define RK3128_DAC_INT_CTL2		0x14
+#define RK3128_DAC_INT_CTL3		0x18
+#define RK3128_DAC_CTL			0xa0
+#define RK3128_DAC_ENABLE		0xa4
+#define RK3128_HPMIX_CTL		0xa8
+#define RK3128_HPMIX_S_SELECT		0xac
+#define RK3128_HPOUT_CTL		0xb0
+#define RK3128_HPOUTL_GAIN		0xb4
+#define RK3128_HPOUTR_GAIN		0xb8
+#define RK3128_SELECT_CURRENT		0xbc
+
+/*
+ * ADC interface control 2. The I2S clock role bit sits here and applies to
+ * the DAC as well (the ADC and DAC interface share one I2S port).
+ */
+#define RK3128_I2S_MODE_MASK		BIT(4)
+#define RK3128_I2S_MODE_MASTER		BIT(4)
+#define RK3128_I2S_MODE_SLAVE		0
+
+/* DAC interface control 1 */
+#define RK3128_DLRCK_POL		BIT(7)
+#define RK3128_DAC_VWL_MASK		GENMASK(6, 5)
+#define RK3128_DAC_VWL_16		(0 << 5)
+#define RK3128_DAC_VWL_20		BIT(5)
+#define RK3128_DAC_VWL_24		(2 << 5)
+#define RK3128_DAC_VWL_32		(3 << 5)
+#define RK3128_DAC_DF_MASK		GENMASK(4, 3)
+#define RK3128_DAC_DF_RJ		(0 << 3)
+#define RK3128_DAC_DF_LJ		BIT(3)
+#define RK3128_DAC_DF_I2S		(2 << 3)
+#define RK3128_DAC_DF_PCM		(3 << 3)
+#define RK3128_DAC_SWAP			BIT(2)
+
+/* DAC interface control 2 */
+#define RK3128_DAC_WL_MASK		GENMASK(3, 2)
+#define RK3128_DAC_WL_16		(0 << 2)
+#define RK3128_DAC_WL_20		BIT(2)
+#define RK3128_DAC_WL_24		(2 << 2)
+#define RK3128_DAC_WL_32		(3 << 2)
+#define RK3128_DAC_RST_DIS		BIT(1)	/* 0: interface in reset */
+#define RK3128_DBCLK_POL		BIT(0)
+
+/*
+ * The analog registers are written with the vendor's values (see the
+ * sequences below). What the bits are, from the vendor header:
+ *
+ * DAC_INT_CTL3 0x18: bit 5 always set; bit 4 set while playback is powered
+ *   (the vendor names neither).
+ * DAC_CTL 0xa0: bit 6 bias current, bit 5 DACL reference, bit 4 VOUTL zero
+ *   detect, bit 3 earphone detect, bit 1 DACR reference, bit 0 VOUTR zero
+ *   detect.
+ * DAC_ENABLE 0xa4: bit 7 DACL ref, 6 DACL clock, 5 DACL enable, 4 DACL
+ *   work; bits 3 to 0 the same for DACR.
+ * HPMIX_CTL 0xa8: bit 6 mixer L enable, 5 and 4 mixer L work 1 and 2;
+ *   bit 2 mixer R enable, 1 and 0 mixer R work 1 and 2.
+ * HPMIX_S_SELECT 0xac: bit 4 DACL to mixer L, bit 0 DACR to mixer R.
+ * HPOUT_CTL 0xb0: bit 7 HPOUTL enable, 6 work, 5 unmute; bit 4 HPOUTR
+ *   enable, 3 work, 2 unmute; bit 1 VREF enable, bit 0 VREF work.
+ * HPOUTx_GAIN 0xb4 / 0xb8: bits 4 to 0, -39 dB to +7.5 dB in 1.5 dB steps
+ *   (26 is 0 dB).
+ */
+
+/* RESET writes: the vendor releases with the reset bypass set */
+#define RK3128_RESET_ASSERT		0x00
+#define RK3128_RESET_RELEASE		0x43
+#define RK3128_RESET_IDLE_ASSERT	0xfc
+#define RK3128_RESET_IDLE_RELEASE	0x03
+
+/* SELECT_CURRENT: discharge, then precharge the output coupling capacitor */
+#define RK3128_SELECT_CURRENT_DISCHARGE	0x1e
+#define RK3128_SELECT_CURRENT_PRECHARGE	0x3e
+
+/* Output stage gain: 0 ... 31 = -39 dB ... +7.5 dB in 1.5 dB steps */
+#define RK3128_HPOUT_GAIN_MAX		31
+#define RK3128_HPOUT_GAIN_DEFAULT	26	/* 0 dB, the vendor's speaker volume */
+
+#define RK3128_MCLK_INITIAL		11289600
+
+/* GRF: select the internal codec, as inno_rk3036 and the Rockchip 4.4 driver do */
+#define RK3128_GRF_SOC_CON0		0x0140
+#define RK3128_GRF_ACODEC_SEL		(BIT(10) | BIT(16 + 10))
+
+struct rk3128_step {
+	u16 reg;
+	u8 val;
+};
+
+/*
+ * Playback power up. This is what the vendor kernel writes to the hardware
+ * for its `playback_power_up_list`: the list itself is
+ * {0x18,0x32} {0xa0,0x48} {0xa0,0x6a} {0xa4,0x88} {0xa4,0xcc} {0xa4,0xee}
+ * {0xa8,0x44} {0xb0,0x92} {0xb0,0xdb} {0xac,0x11} {0xa8,0x55} {0xa8,0x77}
+ * {0xa4,0xff} {0xb0,0xff} {0xa0,0x7b}, and its register accessor turns the
+ * writes of HPMIX_CTL and HPOUT_CTL that set an enable bit into
+ * "value, then value with the work bits" (0x44 becomes 0x44 0x47 0x77, 0x92
+ * becomes 0x92 0xd2 0xdb). tools/rk312x_codec_trace.py reproduces this
+ * from the stock kernel image and checks the table below against it.
+ * The output gain follows these steps.
+ */
+static const struct rk3128_step rk3128_power_up[] = {
+	{ RK3128_DAC_INT_CTL3, 0x32 },
+	{ RK3128_DAC_CTL, 0x48 },
+	{ RK3128_DAC_CTL, 0x6a },
+	{ RK3128_DAC_ENABLE, 0x88 },
+	{ RK3128_DAC_ENABLE, 0xcc },
+	{ RK3128_DAC_ENABLE, 0xee },
+	{ RK3128_HPMIX_CTL, 0x44 },
+	{ RK3128_HPMIX_CTL, 0x47 },
+	{ RK3128_HPMIX_CTL, 0x77 },
+	{ RK3128_HPOUT_CTL, 0x92 },
+	{ RK3128_HPOUT_CTL, 0xd2 },
+	{ RK3128_HPOUT_CTL, 0xdb },
+	{ RK3128_HPMIX_S_SELECT, 0x11 },
+	{ RK3128_HPMIX_CTL, 0x55 },
+	{ RK3128_HPMIX_CTL, 0x77 },
+	{ RK3128_DAC_ENABLE, 0xff },
+	{ RK3128_HPOUT_CTL, 0xff },
+	{ RK3128_DAC_CTL, 0x7b },
+};
+
+/* Playback power down, the same way from `playback_power_down_list` */
+static const struct rk3128_step rk3128_power_down[] = {
+	{ RK3128_HPOUT_CTL, 0xdb },
+	{ RK3128_HPMIX_CTL, 0x44 },
+	{ RK3128_HPMIX_S_SELECT, 0x00 },
+	{ RK3128_HPOUT_CTL, 0x92 },
+	{ RK3128_DAC_CTL, 0x2a },
+	{ RK3128_HPOUT_CTL, 0x00 },
+	{ RK3128_HPMIX_CTL, 0x00 },
+	{ RK3128_DAC_ENABLE, 0x00 },
+	{ RK3128_DAC_CTL, 0x08 },
+	{ RK3128_DAC_INT_CTL3, 0x22 },
+};
+
+struct rk3128_codec {
+	struct regmap *regmap;
+	struct clk *mclk;
+	unsigned int sysclk;
+	unsigned int depop_ms;
+	/*
+	 * Serializes the volume controls against the power transitions: the
+	 * power-up reads the gains, takes the hardware to the minimum and
+	 * writes them back about 18 ms later, which would otherwise undo a
+	 * volume change made in between.
+	 */
+	struct mutex lock;
+};
+
+static const struct reg_default rk3128_reg_defaults[] = {
+	{ RK3128_RESET, 0x03 },
+	{ RK3128_ADC_INT_CTL2, 0x0e },
+	{ RK3128_DAC_INT_CTL1, 0x50 },
+	{ RK3128_DAC_INT_CTL2, 0x0e },
+	{ RK3128_DAC_INT_CTL3, 0x22 },
+	{ RK3128_DAC_CTL, 0x00 },
+	{ RK3128_DAC_ENABLE, 0x00 },
+	{ RK3128_HPMIX_CTL, 0x00 },
+	{ RK3128_HPMIX_S_SELECT, 0x00 },
+	{ RK3128_HPOUT_CTL, 0x00 },
+	{ RK3128_HPOUTL_GAIN, 0x00 },
+	{ RK3128_HPOUTR_GAIN, 0x00 },
+	{ RK3128_SELECT_CURRENT, 0x3e },
+};
+
+static bool rk3128_codec_accessible_reg(struct device *dev, unsigned int reg)
+{
+	switch (reg) {
+	case RK3128_RESET:
+	case RK3128_ADC_INT_CTL2:
+	case RK3128_DAC_INT_CTL1:
+	case RK3128_DAC_INT_CTL2:
+	case RK3128_DAC_INT_CTL3:
+	case RK3128_DAC_CTL:
+	case RK3128_DAC_ENABLE:
+	case RK3128_HPMIX_CTL:
+	case RK3128_HPMIX_S_SELECT:
+	case RK3128_HPOUT_CTL:
+	case RK3128_HPOUTL_GAIN:
+	case RK3128_HPOUTR_GAIN:
+	case RK3128_SELECT_CURRENT:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool rk3128_codec_volatile_reg(struct device *dev, unsigned int reg)
+{
+	return reg == RK3128_RESET;
+}
+
+static const struct regmap_config rk3128_codec_regmap_config = {
+	.reg_bits = 32,
+	.reg_stride = 4,
+	.val_bits = 32,
+	.max_register = RK3128_SELECT_CURRENT,
+	.writeable_reg = rk3128_codec_accessible_reg,
+	.readable_reg = rk3128_codec_accessible_reg,
+	.volatile_reg = rk3128_codec_volatile_reg,
+	.reg_defaults = rk3128_reg_defaults,
+	.num_reg_defaults = ARRAY_SIZE(rk3128_reg_defaults),
+	.cache_type = REGCACHE_FLAT,
+};
+
+static void rk3128_run_steps(struct rk3128_codec *priv,
+			     const struct rk3128_step *steps, size_t len)
+{
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		regmap_write(priv->regmap, steps[i].reg, steps[i].val);
+		usleep_range(1000, 1100);
+	}
+}
+
+/*
+ * The gain registers follow the volume control (their regmap cache holds
+ * it), but the hardware has them at the minimum while the codec is off, as
+ * the vendor driver does: the volume is written when the output stage is
+ * up and zeroed before it goes down.
+ */
+static void rk3128_gain_hw_min(struct rk3128_codec *priv)
+{
+	regcache_cache_bypass(priv->regmap, true);
+	regmap_write(priv->regmap, RK3128_HPOUTL_GAIN, 0);
+	regmap_write(priv->regmap, RK3128_HPOUTR_GAIN, 0);
+	regcache_cache_bypass(priv->regmap, false);
+}
+
+static void rk3128_playback_power_up(struct rk3128_codec *priv)
+{
+	unsigned int gain_l, gain_r;
+
+	mutex_lock(&priv->lock);
+	regmap_read(priv->regmap, RK3128_HPOUTL_GAIN, &gain_l);
+	regmap_read(priv->regmap, RK3128_HPOUTR_GAIN, &gain_r);
+
+	rk3128_gain_hw_min(priv);
+	rk3128_run_steps(priv, rk3128_power_up, ARRAY_SIZE(rk3128_power_up));
+	regmap_write(priv->regmap, RK3128_HPOUTL_GAIN, gain_l);
+	regmap_write(priv->regmap, RK3128_HPOUTR_GAIN, gain_r);
+	mutex_unlock(&priv->lock);
+
+	/* let the output capacitor settle before the amplifier is enabled */
+	msleep(priv->depop_ms);
+}
+
+static void rk3128_playback_power_down(struct rk3128_codec *priv)
+{
+	mutex_lock(&priv->lock);
+	rk3128_run_steps(priv, rk3128_power_down, ARRAY_SIZE(rk3128_power_down));
+	rk3128_gain_hw_min(priv);
+	mutex_unlock(&priv->lock);
+}
+
+/*
+ * The whole playback power sequence is a supply: DAPM powers it up before
+ * the DAC and the external amplifier (an out_drv widget on the card) and
+ * down after them, which keeps the amplifier off while the output stage
+ * charges and settles.
+ */
+static int rk3128_power_event(struct snd_soc_dapm_widget *w,
+			      struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct rk3128_codec *priv = snd_soc_component_get_drvdata(component);
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		rk3128_playback_power_up(priv);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		rk3128_playback_power_down(priv);
+		break;
+	}
+
+	return 0;
+}
+
+static const DECLARE_TLV_DB_SCALE(rk3128_out_tlv, -3900, 150, 0);
+
+/* the standard volume callbacks, under the lock the power transitions take */
+static int rk3128_volume_get(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct rk3128_codec *priv = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	mutex_lock(&priv->lock);
+	ret = snd_soc_get_volsw(kcontrol, ucontrol);
+	mutex_unlock(&priv->lock);
+
+	return ret;
+}
+
+static int rk3128_volume_put(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct rk3128_codec *priv = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	mutex_lock(&priv->lock);
+	ret = snd_soc_put_volsw(kcontrol, ucontrol);
+	mutex_unlock(&priv->lock);
+
+	return ret;
+}
+
+static const struct snd_kcontrol_new rk3128_controls[] = {
+	SOC_DOUBLE_R_EXT_TLV("Master Playback Volume", RK3128_HPOUTL_GAIN,
+			     RK3128_HPOUTR_GAIN, 0, RK3128_HPOUT_GAIN_MAX, 0,
+			     rk3128_volume_get, rk3128_volume_put,
+			     rk3128_out_tlv),
+};
+
+static const struct snd_soc_dapm_widget rk3128_dapm_widgets[] = {
+	SND_SOC_DAPM_SUPPLY_S("Analog Power", 1, SND_SOC_NOPM, 0, 0,
+			      rk3128_power_event,
+			      SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_PRE_PMD),
+	SND_SOC_DAPM_DAC("DAC", "Playback", SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_OUTPUT("HPOUTL"),
+	SND_SOC_DAPM_OUTPUT("HPOUTR"),
+};
+
+static const struct snd_soc_dapm_route rk3128_dapm_routes[] = {
+	{ "DAC", NULL, "Analog Power" },
+	{ "HPOUTL", NULL, "DAC" },
+	{ "HPOUTR", NULL, "DAC" },
+};
+
+static int rk3128_set_dai_sysclk(struct snd_soc_dai *dai, int clk_id,
+				 unsigned int freq, int dir)
+{
+	struct rk3128_codec *priv = snd_soc_component_get_drvdata(dai->component);
+
+	priv->sysclk = freq;
+
+	return 0;
+}
+
+static int rk3128_set_dai_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct rk3128_codec *priv = snd_soc_component_get_drvdata(dai->component);
+	unsigned int mode, ctl1 = 0, ctl2 = 0;
+
+	switch (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_CBC_CFC:
+		mode = RK3128_I2S_MODE_SLAVE;
+		break;
+	case SND_SOC_DAIFMT_CBP_CFP:
+		mode = RK3128_I2S_MODE_MASTER;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		ctl1 |= RK3128_DAC_DF_I2S;
+		break;
+	case SND_SOC_DAIFMT_LEFT_J:
+		ctl1 |= RK3128_DAC_DF_LJ;
+		break;
+	case SND_SOC_DAIFMT_RIGHT_J:
+		ctl1 |= RK3128_DAC_DF_RJ;
+		break;
+	case SND_SOC_DAIFMT_DSP_A:
+		ctl1 |= RK3128_DAC_DF_PCM;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		break;
+	case SND_SOC_DAIFMT_IB_NF:
+		ctl2 |= RK3128_DBCLK_POL;
+		break;
+	case SND_SOC_DAIFMT_NB_IF:
+		ctl1 |= RK3128_DLRCK_POL;
+		break;
+	case SND_SOC_DAIFMT_IB_IF:
+		ctl1 |= RK3128_DLRCK_POL;
+		ctl2 |= RK3128_DBCLK_POL;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	regmap_update_bits(priv->regmap, RK3128_ADC_INT_CTL2,
+			   RK3128_I2S_MODE_MASK, mode);
+	regmap_update_bits(priv->regmap, RK3128_DAC_INT_CTL1,
+			   RK3128_DLRCK_POL | RK3128_DAC_DF_MASK, ctl1);
+	regmap_update_bits(priv->regmap, RK3128_DAC_INT_CTL2,
+			   RK3128_DBCLK_POL, ctl2);
+
+	return 0;
+}
+
+static int rk3128_hw_params(struct snd_pcm_substream *substream,
+			    struct snd_pcm_hw_params *params,
+			    struct snd_soc_dai *dai)
+{
+	struct rk3128_codec *priv = snd_soc_component_get_drvdata(dai->component);
+	unsigned int rate = params_rate(params);
+	unsigned int sysclk = priv->sysclk;
+	unsigned int ctl1, ctl2;
+
+	if (!sysclk)
+		sysclk = clk_get_rate(priv->mclk);
+
+	/*
+	 * The codec runs from its master clock: BCLK is the master clock / 4,
+	 * and LRCK is BCLK / (2 * the word length). The word length it needs
+	 * is fixed by the ratio of the two.
+	 */
+	if (!sysclk || sysclk % (8 * rate)) {
+		dev_err(dai->dev, "master clock %u Hz does not fit %u Hz\n",
+			sysclk, rate);
+		return -EINVAL;
+	}
+
+	switch (sysclk / (8 * rate)) {
+	case 16:
+		ctl2 = RK3128_DAC_WL_16;
+		break;
+	case 20:
+		ctl2 = RK3128_DAC_WL_20;
+		break;
+	case 24:
+		ctl2 = RK3128_DAC_WL_24;
+		break;
+	case 32:
+		ctl2 = RK3128_DAC_WL_32;
+		break;
+	default:
+		dev_err(dai->dev, "master clock %u Hz does not fit %u Hz\n",
+			sysclk, rate);
+		return -EINVAL;
+	}
+
+	switch (params_width(params)) {
+	case 16:
+		ctl1 = RK3128_DAC_VWL_16;
+		break;
+	case 20:
+		ctl1 = RK3128_DAC_VWL_20;
+		break;
+	case 24:
+		ctl1 = RK3128_DAC_VWL_24;
+		break;
+	case 32:
+		ctl1 = RK3128_DAC_VWL_32;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	regmap_update_bits(priv->regmap, RK3128_DAC_INT_CTL1,
+			   RK3128_DAC_VWL_MASK | RK3128_DAC_SWAP, ctl1);
+	regmap_update_bits(priv->regmap, RK3128_DAC_INT_CTL2,
+			   RK3128_DAC_WL_MASK | RK3128_DAC_RST_DIS,
+			   ctl2 | RK3128_DAC_RST_DIS);
+
+	return 0;
+}
+
+static const u64 rk3128_selectable_formats =
+	SND_SOC_POSSIBLE_DAIFMT_I2S	|
+	SND_SOC_POSSIBLE_DAIFMT_RIGHT_J	|
+	SND_SOC_POSSIBLE_DAIFMT_LEFT_J	|
+	SND_SOC_POSSIBLE_DAIFMT_DSP_A	|
+	SND_SOC_POSSIBLE_DAIFMT_NB_NF	|
+	SND_SOC_POSSIBLE_DAIFMT_NB_IF	|
+	SND_SOC_POSSIBLE_DAIFMT_IB_NF	|
+	SND_SOC_POSSIBLE_DAIFMT_IB_IF;
+
+static const struct snd_soc_dai_ops rk3128_dai_ops = {
+	.set_sysclk	= rk3128_set_dai_sysclk,
+	.set_fmt	= rk3128_set_dai_fmt,
+	.hw_params	= rk3128_hw_params,
+	.auto_selectable_formats	= &rk3128_selectable_formats,
+	.num_auto_selectable_formats	= 1,
+};
+
+static struct snd_soc_dai_driver rk3128_dai = {
+	.name = "rk3128-hifi",
+	.playback = {
+		.stream_name	= "Playback",
+		.channels_min	= 2,
+		.channels_max	= 2,
+		.rates		= SNDRV_PCM_RATE_8000_96000,
+		.formats	= SNDRV_PCM_FMTBIT_S16_LE |
+				  SNDRV_PCM_FMTBIT_S20_3LE |
+				  SNDRV_PCM_FMTBIT_S24_LE |
+				  SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.ops = &rk3128_dai_ops,
+	.symmetric_rate = 1,
+};
+
+static int rk3128_component_probe(struct snd_soc_component *component)
+{
+	struct rk3128_codec *priv = snd_soc_component_get_drvdata(component);
+
+	/* the vendor's start-up: the capacitor of the output goes through a discharge */
+	regmap_write(priv->regmap, RK3128_SELECT_CURRENT,
+		     RK3128_SELECT_CURRENT_DISCHARGE);
+	regmap_write(priv->regmap, RK3128_SELECT_CURRENT,
+		     RK3128_SELECT_CURRENT_PRECHARGE);
+
+	return 0;
+}
+
+static void rk3128_component_remove(struct snd_soc_component *component)
+{
+	struct rk3128_codec *priv = snd_soc_component_get_drvdata(component);
+
+	regmap_write(priv->regmap, RK3128_RESET, RK3128_RESET_IDLE_ASSERT);
+	usleep_range(10000, 11000);
+	regmap_write(priv->regmap, RK3128_RESET, RK3128_RESET_IDLE_RELEASE);
+}
+
+static const struct snd_soc_component_driver rk3128_component = {
+	.probe			= rk3128_component_probe,
+	.remove			= rk3128_component_remove,
+	.controls		= rk3128_controls,
+	.num_controls		= ARRAY_SIZE(rk3128_controls),
+	.dapm_widgets		= rk3128_dapm_widgets,
+	.num_dapm_widgets	= ARRAY_SIZE(rk3128_dapm_widgets),
+	.dapm_routes		= rk3128_dapm_routes,
+	.num_dapm_routes	= ARRAY_SIZE(rk3128_dapm_routes),
+	.use_pmdown_time	= 1,
+	.endianness		= 1,
+};
+
+static int rk3128_codec_platform_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct rk3128_codec *priv;
+	struct regmap *grf;
+	void __iomem *base;
+	struct clk *pclk;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	ret = devm_mutex_init(dev, &priv->lock);
+	if (ret)
+		return ret;
+
+	grf = syscon_regmap_lookup_by_phandle(dev->of_node, "rockchip,grf");
+	if (IS_ERR(grf))
+		return dev_err_probe(dev, PTR_ERR(grf),
+				     "needs 'rockchip,grf'\n");
+	ret = regmap_write(grf, RK3128_GRF_SOC_CON0, RK3128_GRF_ACODEC_SEL);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot write the GRF\n");
+
+	if (of_property_read_u32(dev->of_node, "spk-depop-time-ms",
+				 &priv->depop_ms))
+		priv->depop_ms = 200;
+
+	pclk = devm_clk_get_enabled(dev, "pclk");
+	if (IS_ERR(pclk))
+		return dev_err_probe(dev, PTR_ERR(pclk),
+				     "cannot enable pclk\n");
+
+	priv->mclk = devm_clk_get_enabled(dev, "mclk");
+	if (IS_ERR(priv->mclk))
+		return dev_err_probe(dev, PTR_ERR(priv->mclk),
+				     "cannot enable mclk\n");
+	ret = clk_set_rate(priv->mclk, RK3128_MCLK_INITIAL);
+	if (ret)
+		dev_warn(dev, "cannot set mclk to %u Hz: %d\n",
+			 RK3128_MCLK_INITIAL, ret);
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	priv->regmap = devm_regmap_init_mmio(dev, base,
+					     &rk3128_codec_regmap_config);
+	if (IS_ERR(priv->regmap))
+		return dev_err_probe(dev, PTR_ERR(priv->regmap),
+				     "cannot create the regmap\n");
+
+	/* reset everything to the defaults in the table above, then release */
+	regmap_write(priv->regmap, RK3128_RESET, RK3128_RESET_ASSERT);
+	usleep_range(10000, 11000);
+	regmap_write(priv->regmap, RK3128_RESET, RK3128_RESET_RELEASE);
+	usleep_range(10000, 11000);
+
+	/* the volume starts at 0 dB: only the cache, the hardware stays at the minimum */
+	regcache_cache_only(priv->regmap, true);
+	regmap_write(priv->regmap, RK3128_HPOUTL_GAIN, RK3128_HPOUT_GAIN_DEFAULT);
+	regmap_write(priv->regmap, RK3128_HPOUTR_GAIN, RK3128_HPOUT_GAIN_DEFAULT);
+	regcache_cache_only(priv->regmap, false);
+
+	dev_set_drvdata(dev, priv);
+
+	return devm_snd_soc_register_component(dev, &rk3128_component,
+					       &rk3128_dai, 1);
+}
+
+static const struct of_device_id rk3128_codec_of_match[] __maybe_unused = {
+	{ .compatible = "rockchip,rk3128-codec", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, rk3128_codec_of_match);
+
+static struct platform_driver rk3128_codec_platform_driver = {
+	.driver = {
+		.name = "rk3128-codec",
+		.of_match_table = of_match_ptr(rk3128_codec_of_match),
+	},
+	.probe = rk3128_codec_platform_probe,
+};
+module_platform_driver(rk3128_codec_platform_driver);
+
+MODULE_DESCRIPTION("Rockchip RK3128/RK3126 internal codec driver");
+MODULE_LICENSE("GPL");
