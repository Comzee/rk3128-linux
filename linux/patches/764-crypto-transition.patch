+/* Caller holds the same lock as the DMA worker. The oscillator is enabled
+ * only inside an RNG transaction, never while a cipher/hash owns the device.
+ */
 static int rk_rng_sample(struct rk3128_dev *r, u8 data[RK_RNG_BYTES])
 {
 	u32 ctrl;
 	unsigned int i;
-	int err;
+	int err, close_err;
 
-	writel(RK_RNG_START << 16 | RK_RNG_START, r->reg + RK_RNG_CTRL);
+	if (!r->rng_started) {
+		/* Like DMA, a TRNG start makes this static binding reboot-only.
+		 * An unacknowledged close must never free/gate live resources.
+		 */
+		__module_get(THIS_MODULE);
+		pm_runtime_get_noresume(r->dev);
+		WRITE_ONCE(r->rng_started, true);
+	}
+	rk_write(r, RK_RNG_CTRL, RK_RNG_START << 16 | RK_RNG_START);
 	err = readl_poll_timeout(r->reg + RK_RNG_CTRL, ctrl,
 				 !(ctrl & RK_RNG_START), 50, 20000);
+	if (!err)
+		for (i = 0; i < RK_RNG_BYTES; i += 4)
+			put_unaligned_le32(readl(r->reg + RK_RNG_DATA + i), data + i);
+	/* Vendor v1 closes even a timed-out sample; START self-clear alone
+	 * does not replace the explicit masked close transaction.
+	 */
+	rk_write(r, RK_RNG_CTRL, RK_RNG_START << 16);
+	close_err = readl_poll_timeout(r->reg + RK_RNG_CTRL, ctrl,
+				       !(ctrl & RK_RNG_START), 1, 1000);
+	if (close_err) {
+		r->rng_failed = true;
+		return rk_abort(r, close_err);
+	}
 	if (err)
 		return err;
-	for (i = 0; i < RK_RNG_BYTES; i += 4)
-		put_unaligned_le32(readl(r->reg + RK_RNG_DATA + i), data + i);
 	if (rk_rng_health_block(&r->health, data))
 		return -EIO;
 	return 0;
 }
 
+/* Shared BR/BT FIFO/FSM initialization; caller owns the hardware lock. */
+static int rk_block_clear(struct rk3128_dev *d)
+{
+	u32 value;
+	bool irq_enabled = d->irq_enabled;
+	int err;
+
+	rk_irq_off(d);
+	rk_write(d, RK_CRYPTO_INTENA, 0);
+	synchronize_irq(d->irq);
+	value = readl(d->reg + RK_CRYPTO_CTRL);
+	if (value & (GENMASK(4, 0) | RK_RNG_START))
+		return -EBUSY;
+	rk_write(d, RK_CRYPTO_CONF, 0);
+	rk_write(d, RK_CRYPTO_INTSTS, 0x3f);
+	/* Documented >=20-cycle BLOCK_FLUSH; rk_flush holds it for 1us. */
+	rk_flush(d, RK_CRYPTO_BLOCK_FLUSH);
+	err = readl_poll_timeout(d->reg + RK_CRYPTO_CTRL, value,
+				 !(value & RK_CRYPTO_BLOCK_FLUSH), 1, 1000);
+	if (!err && irq_enabled)
+		rk_irq_on(d);
+	return err;
+}
+
+static int rk_rng_stop(struct rk3128_dev *r)
+{
+	u32 value;
+	int err;
+
+	rk_write(r, RK_RNG_OSC, 0);
+	err = readl_poll_timeout(r->reg + RK_RNG_OSC, value,
+				 !(value & RK_RNG_ENABLE), 1, 1000);
+	if (!err)
+		err = rk_block_clear(r);
+	if (err) {
+		r->rng_failed = true;
+		return rk_abort(r, err);
+	}
+	return 0;
+}
+
 static void rk_rng_fail(struct rk3128_dev *r)
 {
 	r->rng_failed = true;
-	writel(0, r->reg + RK_RNG_OSC);
-	dev_err_ratelimited(r->dev, "TRNG timeout/health failure; output latched off until driver removal\n");
+	if (!r->broken)
+		rk_rng_stop(r);
+	dev_err_ratelimited(r->dev, "TRNG timeout/health failure; output latched off until reboot\n");
 }
 
