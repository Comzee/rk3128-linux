+/* Log before touching MMIO, so ramoops can retain the last attempted write.
+ * Never print key, IV, random output or request data. Bulk I/O keeps the
+ * original access implementation; record its complete register range first.
+ */
+static void rk_trace_write(struct rk3128_dev *d, u32 off, unsigned int bytes)
+{
+	unsigned int limit = min_t(unsigned int, READ_ONCE(trace_writes), 8192);
+	int n;
+
+	if (!limit)
+		return;
+	n = atomic_read(&d->trace_count);
+	do {
+		if (n >= (int)limit)
+			return;
+	} while (!atomic_try_cmpxchg(&d->trace_count, &n, n + 1));
+	dev_emerg(d->dev, "MMIO %u: write +%03x bytes=%u\n", (unsigned int)n + 1, off, bytes);
+}
 
 static void rk_write(struct rk3128_dev *d, u32 off, u32 val)
 {
+	rk_trace_write(d, off, 4);
 	writel(val, d->reg + off);
 }
 
+static void rk_copy(struct rk3128_dev *d, u32 off, const void *src, unsigned int bytes)
+{
+	rk_trace_write(d, off, bytes);
+	memcpy_toio(d->reg + off, src, bytes);
+}
+
+static void rk_clear(struct rk3128_dev *d, u32 off, unsigned int bytes)
+{
+	rk_trace_write(d, off, bytes);
+	memset_io(d->reg + off, 0, bytes);
+}
