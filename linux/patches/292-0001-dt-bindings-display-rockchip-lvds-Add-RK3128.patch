From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RK3128 reference <reference@example.invalid>
Date: Fri, 6 Nov 2026 08:52:43 -0600
Subject: [PATCH 1/4] dt-bindings: display: rockchip: lvds: Add RK3128

The RK3128 has a single-channel LVDS transmitter that is the LVDS mode
of its Innosilicon MIPI/LVDS/TTL combo PHY (already described by
rockchip,rk3128-dsi-dphy), plus a few control bits in the GRF. Like the
PX30 it has no register block and no clock of its own, and needs the
PHY and the GRF phandles.

Only the LVDS output mode is supported (the RGB/TTL mode would also
need the LCDC pinctrl, and the SoC has no dual-channel LVDS), so
restrict rockchip,output to lvds. There is a single VOP.

Signed-off-by: RK3128 reference <reference@example.invalid>

diff --git a/Documentation/devicetree/bindings/display/rockchip/rockchip,lvds.yaml b/Documentation/devicetree/bindings/display/rockchip/rockchip,lvds.yaml
index 03b002a05..00f99de8c 100644
--- a/Documentation/devicetree/bindings/display/rockchip/rockchip,lvds.yaml
+++ b/Documentation/devicetree/bindings/display/rockchip/rockchip,lvds.yaml
@@ -14,6 +14,7 @@ properties:
   compatible:
     enum:
       - rockchip,px30-lvds
+      - rockchip,rk3128-lvds
       - rockchip,rk3288-lvds
 
   reg:
@@ -41,7 +42,8 @@ properties:
   rockchip,output:
     $ref: /schemas/types.yaml#/definitions/string
     enum: [rgb, lvds, duallvds]
-    description: This describes the output interface.
+    description:
+      This describes the output interface. The rk3128 only supports lvds.
 
   phys:
     maxItems: 1
@@ -66,6 +68,7 @@ properties:
         description:
           Video port 0 for the VOP input.
           The remote endpoint maybe vopb or vopl.
+          The rk3128 has a single VOP.
 
       port@1:
         $ref: /schemas/graph.yaml#/properties/port
@@ -87,7 +90,9 @@ allOf:
       properties:
         compatible:
           contains:
-            const: rockchip,px30-lvds
+            enum:
+              - rockchip,px30-lvds
+              - rockchip,rk3128-lvds
 
     then:
       properties:
@@ -102,6 +107,17 @@ allOf:
         - phys
         - phy-names
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: rockchip,rk3128-lvds
+
+    then:
+      properties:
+        rockchip,output:
+          const: lvds
+
   - if:
       properties:
         compatible:
