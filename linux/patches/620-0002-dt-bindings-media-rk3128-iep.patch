From: RK3128 reference <reference@example.invalid>
Subject: [PATCH] dt-bindings: media: describe RK3128 IEP v1

Describe the IEP v1 clocks, resets and VIO power domain.

Signed-off-by: RK3128 reference <reference@example.invalid>
---
diff --git a/Documentation/devicetree/bindings/media/rockchip,rk3128-iep.yaml b/Documentation/devicetree/bindings/media/rockchip,rk3128-iep.yaml
new file mode 100644
index 0000000..52292ef
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/rockchip,rk3128-iep.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/rockchip,rk3128-iep.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip RK3128 Image Enhancement Processor
+
+maintainers:
+  - RK3128 reference contributors <reference@example.invalid>
+
+description: |
+  The RK3128 IEP v1 performs deinterlacing, colour adjustment and RGB
+  spatial filtering. The shipped v1 capability probe disables scaling
+  and YUV denoise. IEP and its MMU use VIO, independently of the VPU mux.
+
+properties:
+  compatible:
+    const: rockchip,rk3128-iep
+  reg:
+    maxItems: 1
+  interrupts:
+    maxItems: 1
+  clocks:
+    maxItems: 2
+  clock-names:
+    items:
+      - const: axi
+      - const: ahb
+  resets:
+    maxItems: 2
+  reset-names:
+    items:
+      - const: axi
+      - const: ahb
+  power-domains:
+    maxItems: 1
+  iommus:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - power-domains
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/rk3128-cru.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/power/rk3128-power.h>
+    iep@10108000 {
+        compatible = "rockchip,rk3128-iep";
+        reg = <0x10108000 0x800>;
+        interrupts = <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&cru ACLK_IEP>, <&cru HCLK_IEP>;
+        clock-names = "axi", "ahb";
+        resets = <&cru SRST_IEP_A>, <&cru SRST_IEP_H>;
+        reset-names = "axi", "ahb";
+        power-domains = <&power RK3128_PD_VIO>;
+    };
