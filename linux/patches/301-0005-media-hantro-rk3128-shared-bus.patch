From 677de958b126abde0a07f331f53f84d059c82bb2 Mon Sep 17 00:00:00 2001
From: RK3128 reference <reference@example.invalid>
Date: Fri, 6 Nov 2026 10:37:41 -0600
Subject: [PATCH 5/5] media: hantro: rockchip: Take the RK3128 bus shared with
 the HEVC decoder

The RK3128 VPU shares its bus interface and its ACLK_VDPU/HCLK_VDPU with
the HEVC decoder, switched by GRF_SOC_CON1 bit 15. Its registers and its
IOMMU must only be touched while the bit points at the VPU.

Match "rockchip,rk3128-vpu" (already documented, with the rk3066
fallback) to a copy of the RK3066 variant that sets vcodec_combo. Such a
VPU joins the bus arbiter in probe, before its IRQs and runtime PM; its
runtime resume takes the bus first and a new runtime suspend callback
gives it back (a no-op for every other variant, as the NULL callback
was). Its IOMMU does the same in its own callbacks. The IRQ handlers of
the variant read no register unless the VPU is runtime-active.

Signed-off-by: RK3128 reference <reference@example.invalid>
---
 drivers/media/platform/verisilicon/Kconfig    |  1 +
 drivers/media/platform/verisilicon/hantro.h   |  5 ++
 .../media/platform/verisilicon/hantro_drv.c   | 38 +++++++++++-
 .../media/platform/verisilicon/hantro_hw.h    |  1 +
 .../platform/verisilicon/rockchip_vpu_hw.c    | 60 +++++++++++++++++++
 5 files changed, 102 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/verisilicon/Kconfig b/drivers/media/platform/verisilicon/Kconfig
index 3272a24db..ede9734cb 100644
--- a/drivers/media/platform/verisilicon/Kconfig
+++ b/drivers/media/platform/verisilicon/Kconfig
@@ -49,6 +49,7 @@ config VIDEO_HANTRO_ROCKCHIP
 	bool "Hantro VPU Rockchip support"
 	depends on VIDEO_HANTRO
 	depends on ARCH_ROCKCHIP || COMPILE_TEST
+	select ROCKCHIP_VCODEC_COMBO if ARCH_ROCKCHIP && ARM && OF
 	default y
 	help
 	  Enable support for RK3288, RK3328, and RK3399 SoCs.
diff --git a/drivers/media/platform/verisilicon/hantro.h b/drivers/media/platform/verisilicon/hantro.h
index 0353de154..c869b7604 100644
--- a/drivers/media/platform/verisilicon/hantro.h
+++ b/drivers/media/platform/verisilicon/hantro.h
@@ -28,6 +28,7 @@
 #include "hantro_hw.h"
 
 struct hantro_ctx;
+struct rockchip_vcodec_combo_client;
 struct hantro_codec_ops;
 struct hantro_postproc_ops;
 
@@ -78,6 +79,7 @@ struct hantro_irq {
  * @legacy_regs:		core uses legacy register set
  * @late_postproc:		postproc must be set up at the end of the job
  * @shared_devices:		an array of device ids that cannot run concurrently
+ * @vcodec_combo:		the bus is shared with the HEVC decoder (RK3128)
  */
 struct hantro_variant {
 	unsigned int enc_offset;
@@ -102,6 +104,7 @@ struct hantro_variant {
 	unsigned int double_buffer : 1;
 	unsigned int legacy_regs : 1;
 	unsigned int late_postproc : 1;
+	unsigned int vcodec_combo : 1;
 	const struct of_device_id *shared_devices;
 };
 
@@ -193,6 +196,7 @@ hantro_vdev_to_func(struct video_device *vdev)
  *			shared with interrupt handlers.
  * @variant:		Hardware variant-specific parameters.
  * @watchdog_work:	Delayed work for hardware timeout handling.
+ * @combo:		Arbiter client for the bus shared with the HEVC decoder.
  */
 struct hantro_dev {
 	struct v4l2_device v4l2_dev;
@@ -213,6 +217,7 @@ struct hantro_dev {
 	spinlock_t irqlock;
 	const struct hantro_variant *variant;
 	struct delayed_work watchdog_work;
+	struct rockchip_vcodec_combo_client *combo;
 };
 
 /**
diff --git a/drivers/media/platform/verisilicon/hantro_drv.c b/drivers/media/platform/verisilicon/hantro_drv.c
index ad71c0402..8d301310f 100644
--- a/drivers/media/platform/verisilicon/hantro_drv.c
+++ b/drivers/media/platform/verisilicon/hantro_drv.c
@@ -24,6 +24,7 @@
 #include <media/v4l2-mem2mem.h>
 #include <media/videobuf2-core.h>
 #include <media/videobuf2-vmalloc.h>
+#include <soc/rockchip/rockchip_vcodec_combo.h>
 
 #include "hantro_v4l2.h"
 #include "hantro.h"
@@ -715,6 +716,7 @@ static const struct of_device_id of_hantro_match[] = {
 	{ .compatible = "rockchip,px30-vpu",   .data = &px30_vpu_variant, },
 	{ .compatible = "rockchip,rk3036-vpu", .data = &rk3036_vpu_variant, },
 	{ .compatible = "rockchip,rk3066-vpu", .data = &rk3066_vpu_variant, },
+	{ .compatible = "rockchip,rk3128-vpu", .data = &rk3128_vpu_variant, },
 	{ .compatible = "rockchip,rk3288-vpu", .data = &rk3288_vpu_variant, },
 	{ .compatible = "rockchip,rk3328-vpu", .data = &rk3328_vpu_variant, },
 	{ .compatible = "rockchip,rk3399-vpu", .data = &rk3399_vpu_variant, },
@@ -1111,6 +1113,19 @@ static int hantro_probe(struct platform_device *pdev)
 
 	INIT_DELAYED_WORK(&vpu->watchdog_work, hantro_watchdog);
 
+	/*
+	 * RK3128: join the arbiter of the bus shared with the HEVC decoder
+	 * before the IRQs and runtime PM; the runtime PM callbacks take and
+	 * give back the bus.
+	 */
+	if (vpu->variant->vcodec_combo) {
+		vpu->combo = devm_rockchip_vcodec_combo_get(&pdev->dev);
+		if (IS_ERR_OR_NULL(vpu->combo))
+			return dev_err_probe(&pdev->dev,
+					     vpu->combo ? PTR_ERR(vpu->combo) : -ENODEV,
+					     "no arbiter for the bus shared with the HEVC decoder\n");
+	}
+
 	vpu->clocks = devm_kcalloc(&pdev->dev, vpu->variant->num_clocks,
 				   sizeof(*vpu->clocks), GFP_KERNEL);
 	if (!vpu->clocks)
@@ -1302,10 +1317,27 @@ static void hantro_remove(struct platform_device *pdev)
 static int hantro_runtime_resume(struct device *dev)
 {
 	struct hantro_dev *vpu = dev_get_drvdata(dev);
+	int ret;
+
+	/* the shared bus (RK3128) first: no-op without one */
+	ret = rockchip_vcodec_combo_power_on(vpu->combo);
+	if (ret)
+		return ret;
 
-	if (vpu->variant->runtime_resume)
-		return vpu->variant->runtime_resume(vpu);
+	if (vpu->variant->runtime_resume) {
+		ret = vpu->variant->runtime_resume(vpu);
+		if (ret)
+			rockchip_vcodec_combo_power_off(vpu->combo);
+	}
+
+	return ret;
+}
+
+static int hantro_runtime_suspend(struct device *dev)
+{
+	struct hantro_dev *vpu = dev_get_drvdata(dev);
 
+	rockchip_vcodec_combo_power_off(vpu->combo);
 	return 0;
 }
 #endif
@@ -1313,7 +1345,7 @@ static int hantro_runtime_resume(struct device *dev)
 static const struct dev_pm_ops hantro_pm_ops = {
 	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend,
 				pm_runtime_force_resume)
-	SET_RUNTIME_PM_OPS(NULL, hantro_runtime_resume, NULL)
+	SET_RUNTIME_PM_OPS(hantro_runtime_suspend, hantro_runtime_resume, NULL)
 };
 
 static struct platform_driver hantro_driver = {
diff --git a/drivers/media/platform/verisilicon/hantro_hw.h b/drivers/media/platform/verisilicon/hantro_hw.h
index 13e573f1f..31cdb8a85 100644
--- a/drivers/media/platform/verisilicon/hantro_hw.h
+++ b/drivers/media/platform/verisilicon/hantro_hw.h
@@ -409,6 +409,7 @@ extern const struct hantro_variant imx8mq_vpu_variant;
 extern const struct hantro_variant px30_vpu_variant;
 extern const struct hantro_variant rk3036_vpu_variant;
 extern const struct hantro_variant rk3066_vpu_variant;
+extern const struct hantro_variant rk3128_vpu_variant;
 extern const struct hantro_variant rk3288_vpu_variant;
 extern const struct hantro_variant rk3328_vpu_variant;
 extern const struct hantro_variant rk3399_vpu_variant;
diff --git a/drivers/media/platform/verisilicon/rockchip_vpu_hw.c b/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
index 02673be98..cf8f5976f 100644
--- a/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
+++ b/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
@@ -7,6 +7,7 @@
  */
 
 #include <linux/clk.h>
+#include <linux/pm_runtime.h>
 
 #include "hantro.h"
 #include "hantro_jpeg.h"
@@ -626,6 +627,39 @@ static const struct hantro_irq rockchip_vpu1_irqs[] = {
 	{ "vdpu", hantro_g1_irq },
 };
 
+/*
+ * RK3128: the bus is shared with the HEVC decoder and may point at it
+ * whenever the VPU is not runtime-active: read no register then.
+ */
+static irqreturn_t rk3128_vpu_irq_guard(struct hantro_dev *vpu, int irq,
+					irqreturn_t (*handler)(int, void *))
+{
+	irqreturn_t ret;
+
+	if (pm_runtime_get_if_active(vpu->dev) <= 0)
+		return IRQ_NONE;
+
+	ret = handler(irq, vpu);
+	pm_runtime_put_autosuspend(vpu->dev);
+
+	return ret;
+}
+
+static irqreturn_t rk3128_vpu_vepu_irq(int irq, void *dev_id)
+{
+	return rk3128_vpu_irq_guard(dev_id, irq, rockchip_vpu1_vepu_irq);
+}
+
+static irqreturn_t rk3128_vpu_vdpu_irq(int irq, void *dev_id)
+{
+	return rk3128_vpu_irq_guard(dev_id, irq, hantro_g1_irq);
+}
+
+static const struct hantro_irq rk3128_vpu_irqs[] = {
+	{ "vepu", rk3128_vpu_vepu_irq },
+	{ "vdpu", rk3128_vpu_vdpu_irq },
+};
+
 static const struct hantro_irq rockchip_vdpu2_irqs[] = {
 	{ "vdpu", rockchip_vpu2_vdpu_irq },
 };
@@ -700,6 +734,32 @@ const struct hantro_variant rk3066_vpu_variant = {
 	.num_clocks = ARRAY_SIZE(rk3066_vpu_clk_names)
 };
 
+/*
+ * RK3128: the RK3066 VPU, but its bus interface is shared with the HEVC
+ * decoder through a GRF switch: the runtime PM callbacks take the bus
+ * from the arbiter, and the IRQ handlers check the VPU is active.
+ */
+const struct hantro_variant rk3128_vpu_variant = {
+	.enc_offset = 0x0,
+	.enc_fmts = rockchip_vpu_enc_fmts,
+	.num_enc_fmts = ARRAY_SIZE(rockchip_vpu_enc_fmts),
+	.dec_offset = 0x400,
+	.dec_fmts = rk3066_vpu_dec_fmts,
+	.num_dec_fmts = ARRAY_SIZE(rk3066_vpu_dec_fmts),
+	.postproc_fmts = rockchip_vpu1_postproc_fmts,
+	.num_postproc_fmts = ARRAY_SIZE(rockchip_vpu1_postproc_fmts),
+	.postproc_ops = &hantro_g1_postproc_ops,
+	.codec = HANTRO_JPEG_ENCODER | HANTRO_MPEG2_DECODER |
+		 HANTRO_VP8_DECODER | HANTRO_H264_DECODER,
+	.codec_ops = rk3066_vpu_codec_ops,
+	.irqs = rk3128_vpu_irqs,
+	.num_irqs = ARRAY_SIZE(rk3128_vpu_irqs),
+	.init = rk3066_vpu_hw_init,
+	.clk_names = rk3066_vpu_clk_names,
+	.num_clocks = ARRAY_SIZE(rk3066_vpu_clk_names),
+	.vcodec_combo = true,
+};
+
 const struct hantro_variant rk3288_vpu_variant = {
 	.enc_offset = 0x0,
 	.enc_fmts = rockchip_vpu_enc_fmts,
