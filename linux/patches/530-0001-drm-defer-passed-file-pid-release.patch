From: RK3128 reference <reference@example.invalid>
Subject: [PATCH] drm: defer old owner PID release after file descriptor handover

A passed non-master fd's first ioctl blocks in synchronize_rcu solely to
release the old accounting PID. On RK3128 this costs about 30 ms, before
DRM_IOCTL_VERSION itself executes. Publish the new owner as before, retain
the old reference until an RCU callback, and preserve the synchronous path
when a non-reclaiming allocation fails. Master ownership is unchanged.
Drain callbacks at DRM module exit; no callback retains the drm_file.

Signed-off-by: RK3128 reference <reference@example.invalid>
---
diff --git a/drivers/gpu/drm/drm_file.c b/drivers/gpu/drm/drm_file.c
--- a/drivers/gpu/drm/drm_file.c
+++ b/drivers/gpu/drm/drm_file.c
@@ -449,10 +449,27 @@
 }
 EXPORT_SYMBOL(drm_release);
 
+/* Keep the old accounting owner alive for readers without delaying the first
+ * ioctl after an fd handover by a full RCU grace period.
+ */
+struct drm_file_pid_put {
+	struct rcu_head rcu;
+	struct pid *pid;
+};
+
+static void drm_file_put_pid_rcu(struct rcu_head *rcu)
+{
+	struct drm_file_pid_put *put = container_of(rcu, struct drm_file_pid_put, rcu);
+
+	put_pid(put->pid);
+	kfree(put);
+}
+
 void drm_file_update_pid(struct drm_file *filp)
 {
 	struct drm_device *dev;
 	struct pid *pid, *old;
+	struct drm_file_pid_put *put;
 
 	/*
 	 * Master nodes need to keep the original ownership in order for
@@ -471,14 +488,28 @@
 	if (pid == rcu_access_pointer(filp->pid))
 		return;
 
+	/* Do not enter reclaim just to defer bookkeeping. Under memory pressure,
+	 * retain the synchronous release used before this optimization.
+	 */
+	put = kmalloc_obj(struct drm_file_pid_put, GFP_NOWAIT);
 	dev = filp->minor->dev;
 	mutex_lock(&dev->filelist_mutex);
+	if (pid == rcu_access_pointer(filp->pid)) {
+		mutex_unlock(&dev->filelist_mutex);
+		kfree(put);
+		return;
+	}
 	get_pid(pid);
 	old = rcu_replace_pointer(filp->pid, pid, 1);
 	mutex_unlock(&dev->filelist_mutex);
 
-	synchronize_rcu();
-	put_pid(old);
+	if (put) {
+		put->pid = old;
+		call_rcu(&put->rcu, drm_file_put_pid_rcu);
+	} else {
+		synchronize_rcu();
+		put_pid(old);
+	}
 }
 
 /**
diff --git a/drivers/gpu/drm/drm_drv.c b/drivers/gpu/drm/drm_drv.c
--- a/drivers/gpu/drm/drm_drv.c
+++ b/drivers/gpu/drm/drm_drv.c
@@ -1246,6 +1246,8 @@
 
 static void drm_core_exit(void)
 {
+	/* drm_file_update_pid() may have queued a deferred PID reference put. */
+	rcu_barrier();
 	drm_ras_genl_family_unregister();
 	drm_privacy_screen_lookup_exit();
 	drm_panic_exit();
